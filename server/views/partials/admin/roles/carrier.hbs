                .panel {
                    min-width: 240px;
                }
                .table thead .top-header  {
                    font-weight: normal;
                    font-style: oblique;
                    font-size: .9em;
                }
                .table thead .checkbox-header {
                    width: 90px;
                }
                .tables {
                    max-height: 510px;
                    overflow-y: scroll;
                }
                #carrier-roles-from-section {
                    display: none;
                }
                #carrier-panel-list {
                    max-height: 650px;
                    overflow-y: scroll;
