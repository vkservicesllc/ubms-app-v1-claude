<section class="tab-section" id="carrier-roles-section">
    <div class="columns is-1">
        <div class="column is-two-fifths">
            <div class="panel">
                <p class="panel-block">
                    <button class="button" id="carrier-role-add"><i class="fa fa-plus"></i></button>
                </p>
                <div class="role-panel-list" id="carrier-role-panel-list"></div>
            </div>
        </div>
        <div class="column is-three-fifths">
            <div class="box role-form-section" id="carrier-roles-form-section">
                <button class="delete close-role-section is-pulled-right" id="carrier-role-close"></button>
                <form action="{{actionUrl.deleteRole}}" id="delete-carrier-role-form" method="POST">
                    {{{input.carrierRoleDeleteId}}}
                </form>
                <form action="{{actionUrl.carrierRole}}" id="carrier-role-form" method="POST" autocomplete="off">
                    {{{input.carrierRoleId}}}
                    <div class="columns">
                        <div class="column is-one-third">
                            <div class="field">
                                {{{label.carrierRoleName}}}
                                <div class="control">
                                    {{{input.carrierRoleName}}}
                                </div>
                            </div>
                        </div>
                        <div class="column is-one-quarter">
                            <div class="field">
                                {{{label.carrierRoleLocation}}}
                                <div class="control has-icons-left">
                                    <div class="select is-fullwidth">
                                        {{{select.carrierRoleLocation}}}
                                    </div>
                                    <span class="icon is-left">
                                        <i class="fas fa-location-crosshairs"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="column role-delete-button" id="carrier-role-delete-button">
                            <a id="carrier-role-delete"><i class="fa fa-trash has-text-danger-70"></i></a>
                        </div>
                        <div class="column name-unavailable-warning" id="carrier-name-unavailable-warning">
                            <p class="help has-text-danger">
                                <i class="fa fa-triangle-exclamation"></i>
                                The name is not available for this location!
                                Please try:<br/>
                                1) either changing location<br/>
                                2) or picking a different name for this location
                            </p>
                        </div>
                    </div>

                    <section class="tables role-tables mb-5" id="carrier-permissions">{{{roleTables.carrier}}}
                    </section>

                    <button type="submit" class="button" id="carrier-role-submit">Create</button>
                </form>
            </div>
        </div>
    </div>
</section>
<script type="module" src="/modules/users/carrier-roles.mjs"></script>
