<form class="box px-5 form-container" id="address-form" action="/resource/company/{{{_id}}}/address" method="POST" autocomplete="off"{{{visibility.address}}}>
    <article class="message is-warning" id="initaddr-msg">
        <div class="message-header">
            <p>
                <i class="fa-solid fa-triangle-exclamation"></i>
                Important
            </p>
            <button class="delete" id="initaddr-msg-close"></button>
        </div>
        <div class="message-body">
            The <em>initial address</em> refers to the address the company had at the time it was originally created.<br/>
            Please ensure you list the address as it was <strong>at the time of formation</strong>, even if you are registering the company years later.<br/>
            If the company's address has changed since then, you must still enter the original address during registration.<br/>
            You may update the current address after the registration is complete.
        </div>
    </article>
    <script>
        $('#initaddr-msg-close').click(() => { $('#initaddr-msg').remove() })
    </script>
    <div class="field">
        <h5 class="subtitle has-text-primary-40">Initial Physical Address</h5>
        <div class="columns">
            <div class="column is-3">
                {{{form.address1.text.label}}}
                <div class="control">
                    {{{form.address1.text.input}}}
                </div>
                <p class="help is-info" id="addr1-tip">Without Suite/Unit</p>
            </div>
            <div class="column is-2">
                {{{form.address2.text.label}}}
                <div class="control">
                    {{{form.address2.text.input}}}
                </div>
            </div>
            <div class="column is-2">
                {{{form.addrZip.text.label}}}
                <div class="control">
                    {{{form.addrZip.text.input}}}
                </div>
            </div>
            <div class="column is-3">
                {{{form.addrCity.text.label}}}
                <div class="control">
                    {{{form.addrCity.text.input}}}
                </div>
            </div>
            <div class="column is-2">
                {{{form.addrState.select.label}}}
                <div class="select is-fullwidth">
                    {{{form.addrState.select.input}}}
                </div>
            </div>
        </div>
        <label class="checkbox">
            <input type="checkbox" id="mail-address"{{{checked.mailAddress}}} />
            Mailing address is different from physical
        </label>
    </div>
    <div class="field mt-5"{{{visibility.mailAddress}}}>
        <h5 class="subtitle has-text-info">Initial Mail Address</h5>
        <div class="columns">
            <div class="column is-3">
                {{{form.mailAddress1.text.label}}}
                <div class="control">
                    {{{form.mailAddress1.text.input}}}
                </div>
                <p class="help is-info" id="addr1-tip">Without Suite/Unit</p>
            </div>
            <div class="column is-2">
                {{{form.mailAddress2.text.label}}}
                <div class="control">
                    {{{form.mailAddress2.text.input}}}
                </div>
            </div>
            <div class="column is-2">
                {{{form.mailAddrZip.text.label}}}
                <div class="control">
                    {{{form.mailAddrZip.text.input}}}
                </div>
            </div>
            <div class="column is-3">
                {{{form.mailAddrCity.text.label}}}
                <div class="control">
                    {{{form.mailAddrCity.text.input}}}
                </div>
            </div>
            <div class="column is-2">
                {{{form.mailAddrState.select.label}}}
                <div class="select is-fullwidth">
                    {{{form.mailAddrState.select.input}}}
                </div>
            </div>
        </div>
    </div>
    <div class="field">
        <div class="columns">
            <div class="column is-10"></div>
            <div class="column is-2">
                {{{button.submit.address}}}
            </div>
        </div>
    </div>
</form>
<script type="module" src="/modules/company/address.mjs"></script>
