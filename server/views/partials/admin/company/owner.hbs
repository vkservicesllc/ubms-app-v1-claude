<div class="modal owner-modal" id="owner-modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title owner-title" id="owner-title"></p>
        </header>
        <section class="modal-card-body owner-modal-card" style="display: none;">
            <p class="has-text-danger is-size-7 mb-5">* Required fields</p>
            <form action="/resource/company/owner{{{actionQuery}}}" id="company-owner-form" method="POST" autocomplete="off">
                {{{input.current.ownerId}}}
                {{{input.current.ownerSsn}}}
                <div class="columns owner-update-field" style="display: none;">
                    <div class="column is-5">
                        {{{label.ownerUpdateSince}}}
                        <div class="control">
                            {{{input.ownerUpdateSince}}}
                        </div>
                    </div>
                    <div class="column is-7">
                        <div class="message is-warning">
                            <div class="message-body">
                                The old name will be displayed on all documents before this date
                            </div>
                        </div>
                    </div>
                </div>
                <div class="columns">
                    <div class="column is-6">
                        {{{label.ownerFirstName}}}
                        <div class="control">
                            {{{input.ownerFirstName}}}
                        </div>
                    </div>
                    <div class="column is-6">
                        {{{label.ownerMiddleName}}}
                        <div class="control">
                            {{{input.ownerMiddleName}}}
                        </div>
                    </div>
                </div>
                <div class="columns">
                    <div class="column is-6">
                        {{{label.ownerLastName}}}
                        <div class="control">
                            {{{input.ownerLastName}}}
                        </div>
                    </div>
                    <div class="column is-3">
                        {{{label.ownerSuffix}}}
                        <div class="select is-fullwidth">
                            {{{select.ownerSuffix}}}
                        </div>
                    </div>
                    <div class="column is-3 owner-upsert-field">
                        {{{label.ownerGender}}}
                        <div class="select is-fullwidth">
                            {{{select.ownerGender}}}
                        </div>
                    </div>
                </div>
                <div class="columns">
                    <div class="column is-5 owner-upsert-field">
                        {{{label.ownerDob}}}
                        <div class="control">
                            {{{input.ownerDob}}}
                        </div>
                    </div>
                    <div class="column is-7 owner-upsert-field">
                        {{{label.ownerSsn}}}
                        <div class="control">
                            {{{input.ownerSsn}}}
                        </div>
                        <p class="help is-info" id="owner-ssn-tip">Not public; encrypted</p>
                    </div>
                </div>
            </form>
        </section>
        <footer class="modal-card-foot owner-modal-card" style="display: none;">
            <div class="buttons">
                <button type="submit" form="company-owner-form" class="button" id="owner-submit"></button>
                <button class="button modal-cancel">Cancel</button>
            </div>
        </footer>
        <section class="modal-card-body owner-options-modal-card" style="display: none;">
            <div class="field">
                <input type="radio" class="is-checkradio is-danger" id="owner-update-option-edit" name="owner-update-option" />
                <label class="owner-update-option-label" for="owner-update-option-edit">
                    <strong>Edit (Correct):</strong> <small>Fix mistakes in the current Name, Gender and/or SSN</small>
                </label>
            </div>
            <div class="field">
                <input type="radio" class="is-checkradio is-success" id="owner-update-option-update" name="owner-update-option" />
                <label class="owner-update-option-label" for="owner-update-option-update">
                    <strong>Update:</strong>
                    <small>The name is correct but outdated; the name has been <u>legally changed</u></small>
                </label>
            </div>
        </section>
        <footer class="modal-card-foot owner-options-modal-card" style="display: none;">
            <div class="buttons">
                <button class="button" id="owner-update-proceed" disabled>Proceed</button>
                <button class="button modal-cancel">Cancel</button>
            </div>
        </footer>
    </div>
</div>
<script type="module" src="/modules/company/owner.mjs"></script>
