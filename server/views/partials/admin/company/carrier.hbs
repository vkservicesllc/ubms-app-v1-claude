<form class="box px-5 form-container" id="credentials-form" action="/resource/carrier/{{{_id}}}" method="POST" autocomplete="off"{{{visibility.credentials}}}>
    {{!-- {{{input.carrier.current.mc}}}
    {{{input.carrier.current.usdot}}}
    {{{input.carrier.current.ifta}}}
    {{{input.carrier.current.scac}}}
    {{{input.carrier.current.irp}}}
    {{{input.carrier.current.efs}}}
    {{{input.carrier.current.fleetOne}}}
    {{{input.carrier.current.transflo}}} --}}
    <div class="field">
        <h5 class="subtitle has-text-primary-40">Licensing</h5>
        <div class="columns">
            <div class="column is-3">
                {{{catForm.mc.text.label}}}
                <div class="control">
                    {{{catForm.mc.text.input}}}
                </div>
                <p class="help carrier-tip" id="mc-tip"></p>
            </div>
            <div class="column is-3">
                {{{catForm.usdot.text.label}}}
                <div class="control">
                    {{{catForm.usdot.text.input}}}
                </div>
                <p class="help carrier-tip" id="usdot-tip"></p>
            </div>
            <div class="column is-3">
                {{{catForm.scac.text.label}}}
                <div class="control">
                    {{{catForm.scac.text.input}}}
                </div>
                <p class="help carrier-tip" id="scac-tip"></p>
            </div>
            <div class="column is-3">
                {{{catForm.irp.text.label}}}
                <div class="control">
                    {{{catForm.irp.text.input}}}
                </div>
                <p class="help carrier-tip" id="irp-tip"></p>
            </div>
        </div>
    </div>
    <div class="field">
        <h5 class="subtitle has-text-primary-40">Initial Highway Tax</h5>
        <div class="columns">
            <div class="column is-3">
                {{{catForm.ifta.text.label}}}
                <div class="control">
                    {{{catForm.ifta.text.input}}}
                </div>
                <p class="help carrier-tip" id="ifta-tip"></p>
            </div>
            <div class="column is-3">
                {{{catForm.iftaJur.select.label}}}
                <div class="select is-fullwidth">
                    {{{catForm.iftaJur.select.input}}}
                </div>
            </div>
            <div class="column is-6">
                <label class="label button-label">&nbsp;</label>
                <button type="button" class="button" id="carrier-state-permits-open">State Permits</button>
            </div>
        </div>
    </div>
    <div class="field">
        <h5 class="subtitle has-text-primary-40">Miscellaneous</h5>
        <div class="columns">
            <div class="column is-3">
                {{{catForm.efs.text.label}}}
                <div class="control">
                    {{{catForm.efs.text.input}}}
                </div>
                <p class="help carrier-tip" id="efs-tip"></p>
            </div>
            <div class="column is-3">
                {{{catForm.fleetOne.text.label}}}
                <div class="control">
                    {{{catForm.fleetOne.text.input}}}
                </div>
                <p class="help carrier-tip" id="fleet-one-tip"></p>
            </div>
            <div class="column is-3">
                {{{catForm.transflo.text.label}}}
                <div class="control">
                    {{{catForm.transflo.text.input}}}
                </div>
                <p class="help carrier-tip" id="transflo-tip"></p>
            </div>
        </div>
    </div>
    <div class="modal" id="carrier-state-permits-modal">
        <div class="modal-background"></div>
        <div class="modal-card" style="max-width: 960px;">
            <header class="modal-card-head">
                <h5 class="subtitle has-text-primary-40">State Permits</h5>
            </header>
            <section class="modal-card-body">
                <div class="columns">
                    <div class="column is-6">
                        <div class="field">
                            {{{catForm.caPermit.text.label}}}
                            <div class="control">
                                {{{catForm.caPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="ca-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.flPermit.text.label}}}
                            <div class="control">
                                {{{catForm.flPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="fl-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.ilPermit.text.label}}}
                            <div class="control">
                                {{{catForm.ilPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="il-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.inPermit.text.label}}}
                            <div class="control">
                                {{{catForm.inPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="in-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.kyPermit.text.label}}}
                            <div class="control">
                                {{{catForm.kyPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="ky-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.njPermit.text.label}}}
                            <div class="control">
                                {{{catForm.njPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="nj-permit-tip"></p>
                        </div>
                    </div>
                    <div class="column is-6">
                        <div class="field">
                            {{{catForm.nmPermit.text.label}}}
                            <div class="control">
                                {{{catForm.nmPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="nm-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.nvPermit.text.label}}}
                            <div class="control">
                                {{{catForm.nvPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="nv-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.nyPermit.text.label}}}
                            <div class="control">
                                {{{catForm.nyPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="ny-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.orPermit.text.label}}}
                            <div class="control">
                                {{{catForm.orPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="or-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.txPermit.text.label}}}
                            <div class="control">
                                {{{catForm.txPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="tx-permit-tip"></p>
                        </div>
                        <div class="field">
                            {{{catForm.waPermit.text.label}}}
                            <div class="control">
                                {{{catForm.waPermit.text.input}}}
                            </div>
                            <p class="help carrier-tip" id="wa-permit-tip"></p>
                        </div>
                    </div>
                </div>
            </section>
            <footer class="modal-card-foot">
                <button type="button" class="button" id="carrier-state-permits-close">Done</button>
            </footer>
        </div>
    </div>
    <div class="columns">
        <div class="column is-10">
            <p class="help is-danger" id="carrier-form-tip"></p>
        </div>
        <div class="column is-2">
            {{{button.submit.credentials}}}
        </div>
    </div>
    <script type="module" src="/modules/company/carrier.mjs"></script>
</form>
