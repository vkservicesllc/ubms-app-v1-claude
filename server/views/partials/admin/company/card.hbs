{{#if (eq data.confirmed true)}}
<nav class="breadcrumb has-arrow-separator">
    <ul>
        <li class="is-active"><a class="has-text-grey">Business</a></li>
        <li class="is-active"><a class="has-text-grey">Company</a></li>
    </ul>
</nav>

{{/if}}
<div class="card form-container" id="card-form">
    <style>
        .card-content {
            min-height: {{css.card.minHeight}};
        }
        #highlight-company-trigger:hover {
            background-color: #ff6;
            color: darkslategray;
        }
    </style>
    {{#if (eq data.confirmed true)}}
    <header class="card-header">
        <p class="card-header-title">{{{cardTitle}}}</p>
        <div class="dropdown is-hoverable is-right">
            <div class="dropdown-trigger">
                <button class="card-header-icon" aria-controls="summary-dropdown">
                    <span class="icon"><i class="fas fa-ellipsis-vertical"></i></span>
                </button>
            </div>
            <div class="dropdown-menu" id="summary-dropdown">
                <div class="dropdown-content">
                    <a class="dropdown-item" id="highlight-company-trigger">Highlight</a>
                    <a class="dropdown-item" id="update-company-trigger">Modify/Update</a>
                    <hr class="dropdown-divider">
                    <a class="dropdown-item" id="company-condition-trigger">{{{display.statusTrigger}}}</a>
                    <a class="dropdown-item" id="close-company-trigger">Close</a>
                    <hr class="dropdown-divider">
                    <a class="dropdown-item has-text-danger" id="delete-company-trigger">Delete</a>
                </div>
            </div>
        </div>
    </header>
    {{/if}}
    <div class="card-content">
        <div class="tabs">
            <ul>
                <li class="company-card-tabs is-active" data-section="company"><a>Business Info</a></li>
                {{#if (eq data.category 'crr')}}
                <li class="company-card-tabs" data-section="carrier"><a>Carrier Info</a></li>
                {{/if}}
                {{#if (eq data.confirmed true)}}
                <li class="company-card-tabs" data-section="logo"><a>Logo</a></li>
                {{!-- <li class="company-card-tabs" data-section="teams"><a>Teams</a></li> --}}
                <li class="company-card-tabs" data-section="users"><a>Users</a></li>
                {{/if}}
            </ul>
        </div>

        <section class="company-card-content" id="company-card-content">
            <div class="columns">
                <div class="column is-one-half px-5">
                    {{#if (eq data.confirmed true)}}
                    <div class="is-flex is-justify-content-space-between">
                        <small>Status:</small>
                        <strong class="has-text-right">{{{display.status}}}</strong>
                    </div>
                    {{/if}}
                    <div class="is-flex is-justify-content-space-between">
                        <small>Business Name:</small>
                        <strong class="has-text-right">{{data.name}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Business Alias:</small>
                        <strong class="has-text-right">{{data.alias}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Owner:</small>
                        <strong class="has-text-right">{{data.owner.name}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Launch Date:</small>
                        <strong class="has-text-right">{{display.data.since}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between mt-5">
                        <small>Category:</small>
                        <strong class="has-text-right">{{data.expansion.group}} / {{data.expansion.category}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Type:</small>
                        <strong class="has-text-right">{{display.data.type}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>EIN:</small>
                        <strong class="has-text-right">{{{display.data.ein}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>DUNS:</small>
                        <strong class="has-text-right">{{{display.data.duns}}}</strong>
                    </div>
                </div>
                <div class="column is-one-half px-5">
                    <div class="is-flex is-justify-content-space-between">
                        <small>Address:</small>
                        <strong class="has-text-right">
                            {{{display.data.address.physical}}}
                        </strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between mt-5">
                        <small>Mail Address:</small>
                        <strong class="has-text-right">
                            {{{display.data.address.mail}}}
                        </strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between mt-5">
                        <small>Phone:</small>
                        <strong class="has-text-right">{{display.data.phone}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Fax:</small>
                        <strong class="has-text-right">{{{display.data.fax}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Email:</small>
                        <strong class="has-text-right">{{{display.data.email}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Website:</small>
                        <strong class="has-text-right">{{{display.data.website}}}</strong>
                    </div>
                </div>
            </div>
        </section>
        {{#if (eq data.category 'crr')}}

        <section class="company-card-content" id="carrier-card-content" style="display: none;">
            <div class="columns">
                <div class="column is-two-fifths px-5">
                    <p class="has-text-primary is-size-7 mb-2">Licensing</p>
                    <div class="is-flex is-justify-content-space-between">
                        <small>MC:</small>
                        <strong class="has-text-right">{{data.mc}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>USDOT:</small>
                        <strong class="has-text-right">{{data.usdot}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>SCAC:</small>
                        <strong class="has-text-right">{{{display.data.scac}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>IRP:</small>
                        <strong class="has-text-right">{{{display.data.irp}}}</strong>
                    </div>
                    <p class="has-text-primary is-size-7 mt-5 mb-2">Accounts</p>
                    <div class="is-flex is-justify-content-space-between">
                        <small>EFS Carrier ID:</small>
                        <strong class="has-text-right">{{{display.data.efs}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Fleet One Carrier ID:</small>
                        <strong class="has-text-right">{{{display.data.fleetOne}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Transflo ID:</small>
                        <strong class="has-text-right">{{{display.data.transflo}}}</strong>
                    </div>
                    <p class="has-text-primary is-size-7 mt-5 mb-2">Highway Tax</p>
                    <div class="is-flex is-justify-content-space-between">
                        <small>IFTA:</small>
                        <strong class="has-text-right">{{{display.data.ifta}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>Jurisdiction:</small>
                        <strong class="has-text-right">{{display.data.iftaJur}}</strong>
                    </div>
                </div>
                <div class="column is-three-fifths px-5">
                    <p class="has-text-primary is-size-7 mb-2">State Tax Permits</p>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.ca}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.ca}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.fl}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.fl}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.il}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.il}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.in}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.in}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.ky}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.ky}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.nj}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.nj}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.nm}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.nm}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.nv}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.nv}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.ny}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.ny}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.or}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.or}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.tx}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.tx}}}</strong>
                    </div>
                    <div class="is-flex is-justify-content-space-between">
                        <small>{{display.label.stateTax.wa}}:</small>
                        <strong class="has-text-right">{{{display.data.stateTax.wa}}}</strong>
                    </div>
                </div>
            </div>
        </section>
        {{/if}}
        {{#if (eq data.confirmed true)}}

        <section class="company-card-content" id="logo-card-content" style="display: none;">
            <div class="is-flex is-justify-content-center is-align-items-center">
                <button class="button is-ghost is-large" id="add-company-logo">
                    <i class="fa fa-plus"></i>
                </button>
            </div>
            {{#if (hv data.lastLogo)}}
            <style>
                figure.image {
                    max-width: 240px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    flex-direction: column; /* allows caption under the image */
                    padding: 5px;
                }
                figure.image img {
                    border: 1px dashed gainsboro;
                    max-width: 100%;
                    max-height: 100%;
                    width: auto;
                    height: auto;
                }
                figure.image figcaption {
                    margin-bottom: 5px;
                    font-size: 0.85rem;
                    color: #555;
                    word-break: break-word;
                }
            </style>
            <div class="is-flex is-gap-1 is-align-items-flex-start" id="company-logo-list" style="background: white; padding: 15px; border-radius: 5px; flex-wrap: wrap;">{{{logoList}}}
            </div>
            {{/if}}
        </section>

        <style>
            .column.is-width-fixed {
                min-width: 472px;
            }
            .select.is-multiple select {
                min-height: {{css.multiSelect.minHeight}};
            }
        </style>
        {{{form.id.hidden.input}}}

        <section class="company-card-content" id="users-card-content" style="display: none;">
            <div class="columns">
                <div class="column is-half">
                    <div class="columns is-vcentered">
                        <div class="column is-two-fifths is-width-fixed">
                            <form id="company-users-add-form" action="/resource/company/{{{_id}}}/users" method="POST">
                                <input type="hidden" name="action" value="+" />
                                <label class="label">Available Users</label>
                                <div class="select is-multiple is-fullwidth">
                                    <select id="available-users" name="users" multiple size="8"><option value=""></option></select>
                                </div>
                            </form>
                        </div>
                        <div class="column is-one-fifth">
                            <button type="submit" class="button is-fullwidth is-success" form="company-users-add-form">
                                <i class="fa fa-arrow-right"></i>
                            </button>
                            <button type="submit" class="button is-fullwidth is-danger mt-2" form="company-users-delete-form">
                                <i class="fa fa-arrow-left"></i>
                            </button>
                        </div>
                        <div class="column is-two-fifths is-width-fixed">
                            <form id="company-users-delete-form" action="/resource/company/{{{_id}}}/users" method="POST">
                                <input type="hidden" name="action" value="-" />
                                <label class="label">Current Users</label>
                                <div class="select is-multiple is-fullwidth">
                                    <select id="current-users" name="users" multiple size="8"><option value=""></option></select>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>

