            <label class="label has-text-weight-medium pr-5 is-size-7" style="display: inline;"> - Background</label>
            <input type="hidden" class="color-picker" id="company-text-color" value="{{data.style.color}}">
            <label class="label has-text-weight-medium pr-5 is-size-7" style="display: inline;"> - Text</label>
            <button type="reset" class="button" id="reset-company-highlighter">Reset</button>
        </form>
    </div> --}}
</div>

<script type="module" src="/modules/company/card.mjs"></script>
{{#if (eq data.confirmed true)}}
<script type="module" src="/modules/company/logo.mjs"></script>
{{/if}}
