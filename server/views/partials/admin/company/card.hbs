        {{/if}}

    </div>
    {{#if (eq data.confirmed false)}}
    <form action="/resource/confirm/company/{{{_id}}}" id="company-confirm-form" method="POST"></form>
    <footer class="card-footer">
        <button class="card-footer-item" id="highlight-company-trigger">Highlight</button>
        <button type="submit" class="card-footer-item has-text-link" form="company-confirm-form">Confirm</button>
    </footer>
    {{/if}}
</div>
{{#if (eq data.confirmed true)}}

<div class="modal" id="company-logo-modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title"><strong>{{data.name}}</strong> <small>Logo</small></p>
            <button class="delete" id="close-company-logo-modal"></button>
        </header>
        <section class="modal-card-body">
            {{#if (hv data.lastLogo)}}
            <div class="columns">
                <div class="column is-5">
                    <input type="hidden" id="company-logo-default-since" value="{{data.since}}" >
                    <label class="label input-required" for="company-logo-since">Effective Date</label>
                    <div class="control has-icons-left">
                        <input type="text" class="input" id="company-logo-since" value="{{defaultValue.today}}" required />
                        <span class="icon is-small is-left">
                            <i class="fas fa-calendar-days"></i>
                        </span>
                    </div>
                </div>
            </div>
            {{/if}}
            <div class="box has-text-centered" id="company-log-droparea" style="border: 2px dashed #ccc; padding: 2rem; cursor: pointer;">
                <p>Drag & drop an image here or click to select</p>
                <input type="file" id="company-logo-file-input" accept="image/*" hidden />
            </div>
            <div id="company-logo-cropper" style="display: none; margin-top: 1rem; max-height: 240px;">
                <img id="company-logo" style="max-width: 100%;" />
            </div>
        </section>
        <footer class="modal-card-foot">
            <form id="company-logo-form" action="" method="POST" enctype="multipart/form-data">
                <input type="hidden" id="company-logo-id" value="{{data._companyId}}" />
                <button type="submit" class="button is-success">Crop & Upload</button>
            </form>
        </footer>
    </div>
</div>
{{/if}}

<div class="modal" id="company-highlight-modal">
    <div class="modal-background"></div>
    {{!-- <div class="modal-content p-6" style="width: 480px;">
