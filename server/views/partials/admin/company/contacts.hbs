<form class="box px-5 form-container" id="contacts-form" action="/resource/update/company/{{_id}}/{{actionUrl.param.contact}}/contacts" method="POST" autocomplete="off"{{{visibility.contacts}}}>
    <div class="field">
        <h5 class="subtitle has-text-primary-35">Initial Contacts</h5>
        <div class="columns">
            <div class="column is-3">
                {{{form.phone.text.label}}}
                <div class="control has-icons-left">
                    {{{form.phone.text.input}}}
                    <span class="icon is-small is-left">
                        <i class="fas fa-phone"></i>
                    </span>
                </div>
            </div>
            <div class="column is-3">
                {{{form.fax.text.label}}}
                <div class="control has-icons-left">
                    {{{form.fax.text.input}}}
                    <span class="icon is-small is-left">
                        <i class="fas fa-fax"></i>
                    </span>
                </div>
            </div>
            <div class="column is-4">
                {{{form.email.text.label}}}
                <div class="control has-icons-left">
                    {{{form.email.text.input}}}
                    <span class="icon is-small is-left">
                        <i class="fas fa-envelope"></i>
                    </span>
                </div>
                <p class="help is-danger" id="email-tip"></p>
            </div>
        </div>
    </div>
    <div class="field">
        <div class="columns">
            <div class="column is-10"></div>
            <div class="column is-2">
                {{{button.submit.contacts}}}
            </div>
        </div>
    </div>
</form>
<script type="module" src="/modules/company/contacts.mjs"></script>
