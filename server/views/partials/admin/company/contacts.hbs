<form class="box px-5 form-container" id="contacts-form" action="/resource/company/{{{_id}}}/contacts" method="POST" autocomplete="off"{{{visibility.contacts}}}>
    <div class="field">
        <div class="columns">
            <div class="column is-3">
                {{{label.phone}}}
                <div class="control has-icons-left">
                    {{{input.phone}}}
                    <span class="icon is-small is-left">
                        <i class="fas fa-phone"></i>
                    </span>
                </div>
            </div>
            <div class="column is-3">
                {{{label.fax}}}
                <div class="control has-icons-left">
                    {{{input.fax}}}
                    <span class="icon is-small is-left">
                        <i class="fas fa-fax"></i>
                    </span>
                </div>
            </div>
            <div class="column is-6">
                {{{label.email}}}
                <div class="control has-icons-left">
                    {{{input.email}}}
                    <span class="icon is-small is-left">
                        <i class="fas fa-envelope"></i>
                    </span>
                </div>
                <p class="help is-danger" id="email-tip"></p>
            </div>
        </div>
    </div>
    <div class="columns">
        <div class="column is-10"></div>
        <div class="column is-2">
            {{{button.submit.contacts}}}
        </div>
    </div>
</form>
<script type="module" src="/modules/company/contacts.mjs"></script>
