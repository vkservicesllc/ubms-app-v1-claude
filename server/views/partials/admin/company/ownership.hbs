<form class="box px-5 form-container" id="ownership-form" action="/resource/update/company/{{_id}}/{{actionUrl.param.ownership}}/ownership" method="POST" autocomplete="off"{{{visibility.ownership}}}>
    {{{input.current.ownership}}}
    <div class="field">
        <h5 class="subtitle has-text-primary-35">Initial Ownership</h5>
        <div class="columns">
            <div class="column is-5">
                {{{form.ownership.select.label}}}
                <div class="select is-fullwidth">
                    {{{form.ownership.select.input}}}
                </div>
            </div>
            <div class="column is-1" style="text-align: center;">
                <label class="label button-label">&nbsp;</label>
                {{{button.edit.owner}}}
            </div>
            <div class="column is-1">
                <label class="label button-label">&nbsp;</label>
                {{{button.add.owner}}}
            </div>
            {{#if (ne data.category 'hld')}}
            <div class="column is-5" style="text-align: right;">
                <label class="label button-label">&nbsp;</label>
                <a class="button" href="/business/company/new?cat=hld">Register Holding Company</a>
            </div>
            {{/if}}
        </div>
        <div class="columns">
            <div class="column is-2 mt-3">
                {{{button.submit.ownership}}}
            </div>
        </div>
    </div>
</form>
{{> admin/company/owner}}
<script type="module" src="/modules/company/ownership.mjs"></script>
