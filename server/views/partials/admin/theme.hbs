<div class="dropdown is-hoverable">
    <div class="dropdown-trigger">
        <button class="button has-text-grey is-small is-rounded" aria-haspopup="true" aria-controls="dropdown-theme">
            <span class="icon" id="theme-icon"></span>
        </button>
    </div>
    <div class="dropdown-menu" id="dropdown-theme" role="menu">
        <div class="dropdown-content">
            <div class="dropdown-item">
                <a class="dropdown-item is-size-7 theme-selector" data-theme-selector="light">
                    <span class="icon">
                        <i class="fa fa-sun"></i>
                    </span>
                    Always Light
                </a>
                <a class="dropdown-item is-size-7 theme-selector" data-theme-selector="dark">
                    <span class="icon">
                        <i class="fa fa-moon"></i>
                    </span>
                    Always Dark
                </a>
                <hr class="dropdown-divider" />
                <a class="dropdown-item is-size-7 theme-selector" data-theme-selector="auto">
                    <span class="icon">
                        <i class="fa fa-circle-half-stroke"></i>
                    </span>
                    Automatic
                </a>
            </div>
        </div>
    </div>
</div>
