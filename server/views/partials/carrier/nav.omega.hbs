    </div>
    
    <script>
        const $nav = {
            top: $('#top-nav'),
            left: $('#left-nav'),
        }
        $item = { team: $('#team-item') }
        const width = {
            team: $item.team.innerWidth(),
            left: $nav.left.outerWidth(),
        }
        const height = $nav.top.outerHeight()

        $nav.left.css('padding-top', `${height}px`)
        if (width.left > width.team) $item.team.css('min-width', `${width.left}px`)
        else $nav.left.css('width', `${width.team}px`)

        width.left = $nav.left.outerWidth()
        $('.ui.pusher').css('margin-left', `${width.left}px`)

        $('#team-link').click(() => { $('#team-form').submit() })
        $('.ui.dropdown').dropdown({
            action: 'hide',
        })
        {{#if (eq teamSelect true)}}
        $('.switch-team').click(function() {
            const _id = $(this).data('team-id')

            $.ajax(`/api/session/team/${_id}/switch`, {
                method: 'POST',
                success(switched) {
                    if (switched) window.location.reload()
                }
            })
        })
        {{/if}}
    </script>

