<div class="cropper-buttons" style="display: none;">
    <div class="ui mini centered buttons">
        <button class="ui button" id="cropper-rotate-left-button" title="Rotate Left">
            <i class="undo alternate icon"></i>
        </button>
        <button class="ui button" id="cropper-rotate-right-button" title="Rotate Right">
            <i class="redo alternate icon"></i>
        </button>
        <button class="ui button" id="cropper-zoom-in-button" title="Zoom In">
            <i class="search plus icon"></i>
        </button>
        <button class="ui button" id="cropper-zoom-out-button" title="Zoom Out">
            <i class="search minus icon"></i>
        </button>
        <button class="ui button" id="cropper-reset-button" title="Reset">
            <i class="sync alternate icon"></i>
        </button>
        <button class="ui button" id="cropper-upload-button" title="Select Another">
            <i class="upload icon"></i>
        </button>
    </div>
</div>
