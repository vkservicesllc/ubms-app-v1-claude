<div class="active step">
    <div class="content">
        <div class="title">Personal Documents</div>
        <div class="description">
            <div class="ui horizontal list">
                <div class="item">
                    <div class="header">Drivers's License</div>
                    <small><i class="green double check icon"></i> <span class="ui dark green text">Uploaded</span></small>
                </div>
                <div class="item">
                    <div class="header">Medical Card</div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
                <div class="item">
                    <div class="header">Social Security Card</div>
                    <small><i class="orange check icon"></i> <span class="ui dark orange text">Ignored</span></small>
                </div>
                <div class="item">
                    <div class="header">Legal Documents</div>
                    <small><i class="orange check icon"></i> <span class="ui dark orange text">Ignored</span></small>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="step">
    <div class="content">
        <div class="title">Background Check</div>
        <div class="description">
            <div class="ui horizontal list">
                <div class="item">
                    <div class="header">MVR <small>(Motor Vehicle Report)</small></div>
                    <small><i class="green check icon"></i> <span class="ui dark green text">Uploaded</span></small>
                </div>
                <div class="item">
                    <div class="header">PSP <small>(Pre-Employment Screening Program)</small></div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
                {{#if (eq cdl true)}}
                <div class="item">
                    <div class="header">Clearinghouse</div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>
{{#if (eq posProp 'OO')}}
<div class="step">
    <div class="content">
        <div class="title">Vehicle Documents</div>
        <div class="description">
            <div class="ui horizontal list">
                <div class="item">
                    <div class="header">Truck Registration</div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
                <div class="item">
                    <div class="header">Truck Annual Inspection</div>
                    <small><i class="green double check icon"></i> <span class="ui dark green text">Uploaded</span></small>
                </div>
                {{#if (eq cdl true)}}
                <div class="item">
                    <div class="header">Cab Card</div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
                {{/if}}
            </div><br/>
            {{!-- Condition if has trailer --}}
            <div class="ui horizontal list">
                <div class="item">
                    <div class="header">Trailer Registration</div>
                    <small><i class="green double check icon"></i> <span class="ui dark green text">Uploaded</span></small>
                </div>
                <div class="item">
                    <div class="header">Trailer Annual Inspection</div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
            </div>
        </div>
    </div>
</div>
{{/if}}
<div class="step">
    <div class="content">
        <div class="title">Drug Test</div>
        <div class="description">
            <div class="ui horizontal list">
                <div class="item">
                    <div class="header">Results</div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="step">
    <div class="content">
        <div class="title">Orientation</div>
        <div class="description">
            <div class="ui horizontal list">
                <div class="item">
                    <div class="header">Results</div>
                    <small><i class="red close icon"></i> <span class="ui dark red text">Pending</span></small>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="step">
    <div class="content">
        <div class="title">Agreements</div>
        <div class="description">
            <div class="ui horizontal list">
                {{#if (eq posProp 'OO')}}
                <div class="item">
                    <div class="header">LA <small>(Lease Agreement)</small></div>
                    <small><i class="green double check icon"></i> <span class="ui dark green text">Uploaded (Signed)</span></small>
                </div>
                {{/if}}
                <div class="item">
                    <div class="header">STA <small>(Safety Technology Agreement)</small></div>
                    <small><i class="orange check icon"></i> <span class="ui dark orange text">Uploaded (Prepared)</span></small>
                </div>
            </div>
        </div>
    </div>
</div>