<style>
    .ui.dimmer.modals.page {
        z-index: 2000 !important;
    }
    .ui.modal {
        z-index: 2001 !important;
    }
    .ui.placeholder.segment {
        height: 80vh;
    }
    .cropper-dropzone {
        border: 1px dashed gainsboro !important;
        border-radius: .42rem;
        cursor: pointer;
        padding: 5.4rem 0 !important;
        margin: 0 5.4rem !important;
    }
    .cropper-dropzone .ui.header {
        margin-bottom: 4.2rem;
    }
    .cropper-buttons {
        text-align: center;
    }
    .cropper-wrapper {
        width: 100%;
        height: 90vh;
        margin-top: 1.5rem;
    }
</style>

<div class="ui overlay fullscreen modal" id="upload-dl-modal">
    <div class="center aligned header">
        <small>Upload</small> Driver's License — {{{applicant}}}; {{formId}}{{#if (hv carrier)}}; {{{carrier}}}{{/if}}
    </div>
    <div class="content">
        <form id="upload-dl-form" action="" method="POST" enctype="multipart/form-data">
            <div class="ui placeholder segment" id="croparea-dl-front" data-aspect-ratio="1.59">
                <div class="ui icon header cropper-dropzone">
                    <h1 class="ui header">Driver's License <small>(Front)</small></h1>
                    <i class="dark teal image file outline icon"></i>
                    <span class="ui dark teal text">Drag here or click to upload</span>
                </div>
                {{!-- {{> carrier/components/modal.cropper.dragdrop}} --}}
                <input class="cropper-file" type="file" accept="image/*" hidden />
                <div class="cropper-wrapper" style="display: none;">
                    <img class="cropper-image" style="display: none;" />
                </div>
                {{> carrier/components/modal.cropper.buttons}}
                <img class="cropper-preview" style="display: none;" />
            </div>
        </form>
    </div>
    <div class="actions" style="display: flex !important; justify-content: space-between;">
        <div class="ui cancel button">Cancel</div>
        <strong id="upload-dl-step"></strong>
        <div>
            <button class="ui primary button" id="upload-dl-prev-button" style="display: none;">Back</button>
            <button class="ui primary button" id="upload-dl-next-button" disabled>Next</button>
            <button type="submit" form="upload-dl-form" class="ui primary button" id="upload-dl-submit" style="display: none;">Confirm and Upload</button>
        </div>
    </div>
</div>
