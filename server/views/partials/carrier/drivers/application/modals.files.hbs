<style>
    .ui.dimmer.modals.page {
        z-index: 2000 !important;
        margin-top: .15rem !important;
    }
    .ui.modal {
        z-index: 2001 !important;
    }
    .ui.modal .actions {
        padding: .65rem !important;
    }
    .ui.placeholder.segment {
        height: 80vh;
    }
    .cropper-dropzone {
        border: 1px dashed gainsboro !important;
        border-radius: .42rem;
        cursor: pointer;
        padding: 5.4rem 0 !important;
        margin: 0 5.4rem !important;
    }
    .cropper-dropzone .ui.header {
        margin-bottom: 4.2rem;
    }
    .cropper-buttons {
        text-align: center;
    }
    .cropper-wrapper {
        width: 100%;
        height: 90vh;
        margin-top: 1.5rem;
    }
    .cropper-drag-drop-click {
        font-size: 1.2em;
    }
    .cropper-opt-or {
        padding-top: 1rem;
    }
    .dl-section, .dl2-section, .leg-section, .ssc-section {
        margin-top: .5rem !important;
    }
    .upload-dl-step {
        font-size: 1.2rem;
    }
    .cropper-preview {
        margin-bottom: 1.2rem;
    }
    .confirm-file-label {
        width: 8rem;
    }
    .confirm-file-field {
        width: 27rem;
    }
    .confirm-file-field .ui.compact.grid {
        margin: .25rem 0 !important;
    }
    .confirm-file-field .confirm-file-check {
        padding-top: .35rem !important;
        text-align: center;
    }
    .confirm-file {
        padding-left: 5rem !important;
    }
    .empty-header {
        width: 7.4rem !important;
    }
</style>

<div class="ui small modal" id="delete-files-modal">
    <div class="center aligned header">
        <small>Delete</small> <span class="delete-files-target"></span>
    </div>
    <div class="content">
        <form id="delete-files-form" action="/files/delete/driver/application/{{formId}}" method="POST">
            <input type="hidden" id="delete-files-target" name="target" />
        </form>
        <section>
            <div class="ui negative message" style="width: 100% !important;">
                <div class="header" style="text-align: center; margin-bottom: 1rem;">WARNING</div>
                <p>
                    This will permanently delete all <span class="delete-files-target"></span> files for this application:
                    <ul>
                        <li>{{{applicant}}}</li>
                        <li>{{formId}}{{#if (hv carrier)}} / {{{carrier}}}{{/if}}</li>
                    </ul>
                    <strong>This cannot be undone!</strong>
                </p>
            </div>
        </section>
    </div>
    <div class="actions">
        <button class="ui cancel button" id="cancel-delete-files">Cancel</button>
        <button type="submit" class="ui red button" form="delete-files-form">Delete</button>
    </div>
</div>

<div class="ui overlay fullscreen modal" id="upload-dl-modal">
    <div class="center aligned header">
        <small>Upload</small> Driver's License — {{{applicant}}}; {{formId}}{{#if (hv carrier)}}; {{{carrier}}}{{/if}}
    </div>
    <div class="content">
        <form class="ui form" id="upload-dl-form" method="POST" enctype="multipart/form-data">
            <div class="ui placeholder segment dl-section" id="croparea-dl-front" data-init-aspect-ratio="1.6">
                <div class="ui icon header cropper-dropzone">
                    <h1 class="ui header">Driver's License <small>(Front)</small></h1>
                    <i class="dark teal image file outline icon"></i>
                    <span class="ui dark teal text cropper-drag-drop-click">Drag and drop here or click to upload</span>
                    {{#if (eq uploads.dlF true)}}
                    <p class="cropper-opt-or"><span class="ui grey text">OR</span></p>
                    <button class="ui primary button cropper-load-shared">Load Shared</button>
                    {{/if}}
                </div>
                <input class="cropper-file" type="file" accept="image/*" hidden name="dlF" />
                <div class="cropper-wrapper" style="display: none;">
                    <img class="cropper-image" style="display: none;" />
                </div>
                {{> carrier/components/modal.cropper.buttons}}
            </div>
            <div class="ui placeholder segment dl-section" id="croparea-dl-back" data-init-aspect-ratio="1.6" style="display: none;">
                <div class="ui icon header cropper-dropzone">
                    <h1 class="ui header">Driver's License <small>(Back)</small></h1>
                    <i class="dark teal image file outline icon"></i>
                    <span class="ui dark teal text cropper-drag-drop-click">Drag and drop here or click to upload</span>
                    {{#if (eq uploads.dlB true)}}
                    <p class="cropper-opt-or"><span class="ui grey text">OR</span></p>
                    <button class="ui primary button cropper-load-shared">Load Shared</button>
                    {{/if}}
                </div>
                <input class="cropper-file" type="file" accept="image/*" hidden name="dlB" />
                <div class="cropper-wrapper" style="display: none;">
                    <img class="cropper-image" style="display: none;" />
                </div>
                {{> carrier/components/modal.cropper.buttons}}
            </div>
            <div class="ui two column relaxed grid dl-section" id="confirmation-dl" style="display: none; margin: 0;">
                <div class="six wide column">
                    <div>
                        <div class="cropper-preview" id="cropper-preview-dl-front" data-width="36"></div>
                        <div class="cropper-preview" id="cropper-preview-dl-back" data-width="36"></div>
                    </div>
                </div>
                <div class="ten wide column">
                    {{> carrier/drivers/application/file_forms/drivers_license}}
                </div>
            </div>
        </form>
    </div>
    <div class="actions" style="display: flex !important; justify-content: space-between;">
        <a class="ui button" href="{{cancelUploadUrl}}">Cancel</a>
        <strong id="upload-dl-step">Editor: Driver's License <small>(Front)</small></strong>
        <div>
            <button class="ui primary button" id="upload-dl-prev-button" style="display: none;">Back</button>
            <button class="ui primary button" id="upload-dl-next-button" disabled>Next</button>
            <button type="submit" form="upload-dl-form" class="ui primary button" id="upload-dl-submit" style="display: none;" disabled>Confirm and Upload</button>
        </div>
    </div>
</div>

