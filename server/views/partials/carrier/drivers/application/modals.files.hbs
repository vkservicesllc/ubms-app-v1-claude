<style>
    .cropper-dropzone {
        text-align: center;
        padding: 3.6rem 0;
        border: 1px dashed gainsboro;
        border-radius: .2rem;
        cursor: pointer;
    }
    .cropper-buttons {
        text-align: center;
    }
    .cropper-wrapper {
        width: 100%;
        min-height: 12rem;
        margin-top: 1.5rem;
    }
</style>

<div class="ui large modal" id="upload-dl-modal">
    <div class="header"><small>Upload</small> Driver's License</div>
    <div class="content">
        <form id="upload-dl-form" action="" method="POST" enctype="multipart/form-data">
            <div class="ui two column stackable center aligned grid">
                <div class="middle aligned row">
                    <div class="column">
                        <div class="ui placeholder segment" id="croparea-dl-front" data-aspect-ratio="1.59">
                            <div class="ui top attached label">Driver's License <small>(Front)</small></div>
                            {{> carrier/components/modal.cropper.dragdrop}}
                            <input class="cropper-file" type="file" accept="image/*" hidden />
                            <div class="cropper-wrapper" style="display: none;">
                                <img class="cropper-image" style="display: none;" />
                            </div>
                            {{> carrier/components/modal.cropper.buttons}}
                            <img class="cropper-preview" style="display: none;" />
                        </div>
                    </div>
                    <div class="column">
                        <div class="ui placeholder segment" id="croparea-dl-back" data-aspect-ratio="1.59">
                            <div class="ui top attached label">Driver's License <small>(Back)</small></div>
                            {{> carrier/components/modal.cropper.dragdrop}}
                            <input class="cropper-file" type="file" accept="image/*" hidden />
                            <div class="cropper-wrapper" style="display: none;">
                                <img class="cropper-image" style="display: none;" />
                            </div>
                            {{> carrier/components/modal.cropper.buttons}}
                            <img class="cropper-preview" style="display: none;" />
                        </div>
                    </div>
                </div>
            </div>
