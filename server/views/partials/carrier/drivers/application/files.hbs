<div class="ui tab" data-tab="files">
    <style>
        .hover-outline .hidden {
            display: none;
        }
        .hover-outline {
            display: flex !important;
            justify-content: space-between;
            align-items: center;
        }
        .hover-outline:hover {
            outline: 1px solid rgb(224, 224, 224);
            outline-offset: .32rem;
        }
        .hover-outline:hover .hidden {
            display: inline;
        }
        .action.icon {
            font-size: .84em;
        }
    </style>
    <div class="ui grid" style="margin-top: 2rem;">
        <div class="eight wide column" style="padding: .5rem 2rem;">
            <div class="ui list">
                <div class="item">
                    <i class="orange open folder icon"></i>
                    <div class="content">
                        <div class="header">Qualification</div>
                        <div class="list">
                            <div class="item">
                                <i class="dark green folder icon"></i>
                                <div class="content">
                                    <div class="header">Autogenerated Documents</div>
                                    <div class="content">
                                        <div class="list">
                                            {{#if (eq filePerms.apl.download true)}}
                                            <div class="item">
                                                <i class="pdf file outline icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <a target="_blank" href="/files/pdf/driver/application/{{formId}}">
                                                            <span class="ui dark blue text">Application</span>
                                                        </a>
                                                        <a href="/files/pdf/driver/application/{{formId}}" title="Download Application" download>
                                                            <i class="dark green download action icon"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="item">
                                                <i class="pdf file outline icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <a target="_blank" href="/files/pdf/driver/application/{{formId}}/consent/mvr-psp">
                                                            <span class="ui dark blue text">Consent (PSP)</span>
                                                        </a>
                                                        <a href="/files/pdf/driver/application/{{formId}}" title="Download PSP Consent" download>
                                                            <i class="dark green download action icon"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            {{/if}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="item">
                                <i class="orange open folder icon"></i>
                                <div class="content">
                                    <div class="header">Background Check</div>
                                    <div class="content">
                                        <div class="list">
                                            {{#if (eq cdl true)}}
                                            <div class="item">
                                                <i class="orange open folder icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span>Clearinghouse</span>
                                                        <a href="" title="Upload Clearinghouse Report">
                                                            <i class="blue upload action icon"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            {{/if}}
                                            <div class="item">
                                                <i class="orange open folder icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span>MVR</span>
                                                        <a href="" title="Upload MVR/CDLIS Report">
                                                            <i class="blue upload action icon"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="item">
                                                <i class="orange open folder icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span>PSP</span>
                                                        <a href="" title="Upload PSP Report">
                                                            <i class="blue upload action icon"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="item">
                                <i class="orange open folder icon"></i>
                                <div class="content">
                                    <div class="header">Personal Documents</div>
                                    <div class="content">
                                        <div class="list">
                                            <div class="item">
                                                <i class="pdf file outline icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <a><span class="ui dark blue text">Driver's License</span></a>
                                                        <span>
                                                            <a href="" title="Download Driver's License" download><i class="dark green download action icon"></i></a>
                                                            <a href="" title="Replace Driver's License" download><i class="grey upload action icon"></i></a>
                                                            <a title="Delete Driver's License"><i class="dark red trash alternate outline action icon"></i></a>
                                                        </span>
                                                    </div>
                                                    <div class="description">
                                                        <small>Front and back</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="item">
                                                <i class="grey file icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span class="ui grey text">Medical Certificate</span>
                                                        <span>
                                                            <a title="Upload Medical Certificate"><i class="blue upload action icon"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            {{#if (eq fileLegalDoc true)}}
                                            <div class="item">
                                                <i class="grey file icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span class="ui grey text">Legal Document</span>
                                                        <span>
                                                            <a title="Upload Legal Document"><i class="blue upload action icon"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            {{/if}}
                                            <div class="item">
                                                <i class="grey file icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span class="ui grey text">Social Security Card</span>
                                                        <span>
                                                            <a title="Upload SSN Card"><i class="blue upload action icon"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{#if (eq posProp 'OO')}}
                            <div class="item">
                                <i class="orange open folder icon"></i>
                                <div class="content">
                                    <div class="header">Vehicle Documents</div>
                                    <div class="content">
                                        <div class="list">
                                            <div class="item">
                                                <i class="grey file icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span class="ui grey text">Registration</span>
                                                        <span>
                                                            <a title="Upload Registration"><i class="blue upload action icon"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            {{#if (eq fileTrlReg true)}}
                                            <div class="item">
                                                <i class="grey file icon"></i>
                                                <div class="content">
                                                    <div class="header hover-outline">
                                                        <span class="ui grey text">Trailer Registration</span>
                                                        <span>
                                                            <a title="Upload Trailer Registration"><i class="blue upload action icon"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            {{/if}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{/if}}
                            {{!-- <div class="item">
                                <i class="dark orange folder icon"></i>
                                <div class="content">
                                    <div class="header">Previous Employments</div>
                                    <div class="content">
                                        <div class="list">
                                            <div class="item">
                                                <a class="ui dark green text"><i class="upload icon"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div> --}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="eight wide column" style="padding: .5rem 2rem; border-left: 1px solid rgba(34, 36, 38, 0.15);">
            <div class="ui list">
                <div class="item">
                    <i class="orange open folder icon"></i>
                    <div class="content">
                        <div class="header">Hiring Process</div>
                        <div class="content">
                            <div class="list">
                                <div class="item">
                                    <i class="grey file icon"></i>
                                    <div class="content">
                                        <div class="header hover-outline">
                                            <span class="ui grey text">Drug Test Results</span>
                                            <span>
                                                <a title="Upload Drug Test Results"><i class="blue upload action icon"></i></a>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="item">
                                    <i class="orange open folder icon"></i>
                                    <div class="content">
                                        <div class="header">Orientation</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{!-- <div class="item">
                    <i class="orange open folder icon"></i>
                    <div class="content">
                        <div class="header">Insurance</div>
                    </div>
                </div> --}}
            </div>
        </div>
    </div>
</div>