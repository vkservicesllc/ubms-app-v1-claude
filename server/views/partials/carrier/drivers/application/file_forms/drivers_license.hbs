<div class="ui yellow icon message" style="width: 100% !important; margin-bottom: 2.4rem;">
    <i class="tasks icon"></i>
    <div class="content">
        <div class="header">
            Driver's License Data Verification
        </div>
        <ul class="list">
            <li>Thoroughly compare the data shown on the uploaded license image with the information entered in the form</li>
            <li>Identify any discrepancies and correct all inaccuracies to ensure the data matches exactly</li>
            <li>Once verified, confirm the correctness of the data by checking the slider</li>
        </ul>
    </div>
</div>

<table class="ui compact celled definition table">
    <thead>
        <tr>
            <th class="empty-header"></th>
            <th>{{{fileForm.dlCommercial.radio.label}}}</th>
            <th style="width: 15rem;">{{{fileForm.dlState.select.label}}}</th>
            <th style="width: 15rem;">{{{fileForm.dlNumber.text.label}}}</th>
            <th style="width: 7.5rem;">{{{fileForm.dlClass.text.label}}}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="collapsing">
                <div class="ui fitted slider checkbox">
                    <input class="file-form-confirm-check file-form-confirm-dl-check" type="checkbox" required /><label></label>
                </div>
                <span class="ui dark green text" style="display: none;">
                    <i class="icon checkmark"></i> Correct
                </span>
            </td>
            <td>
                <div class="inline fields">
                    <div class="field">
                        <div class="ui radio checkbox">
                            {{{fileForm.dlCommercial.radio.yes.input}}}
                            {{{fileForm.dlCommercial.radio.yes.label}}}
                        </div>
                    </div>
                    <div class="field">
                        <div class="ui radio checkbox">
                            {{{fileForm.dlCommercial.radio.no.input}}}
                            {{{fileForm.dlCommercial.radio.no.label}}}
                        </div>
                    </div>
                </div>
            </td>
            <td>
                <div class="ui fluid selection required dropdown" id="dl-state-confirm-dropdown">
                    {{{fileForm.dlState.hidden.input}}}
                    <i class="dropdown icon"></i>
                    <div class="default text"></div>
                    <div class="menu">{{{dropdown.confDlState}}}
                    </div>
                </div>
            </td>
            <td>
                <div class="field">
                    {{{fileForm.dlNumber.text.input}}}
                </div>
            </td>
            <td>
                <div class="field">
                    {{{fileForm.dlClass.text.input}}}
                </div>
            </td>
        </tr>
    </tbody>
</table>
