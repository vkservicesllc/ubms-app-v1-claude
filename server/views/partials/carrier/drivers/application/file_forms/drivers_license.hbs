<div class="ui large labeled icon dropdown" id="dl-choose-addr-confirm-dropdown" style="margin-top: 2.4rem;">
    <i class="map marked alternate icon"></i>
    <span class="ui red text">Select address shown on the driver's license</span>
    <div class="menu">
        <div class="header">
            <i class="user icon"></i>
            Reported by Applicant
        </div>
        <div class="scrolling menu">{{{dropdown.confDlAddresses}}}
        </div>
        <div class="divider"></div>
        <div class="header">
            <i class="red exclamation circle icon"></i>
            <span class="ui red text">The driver's license shows a different address</span>
        </div>
        <div class="item" data-value="new" data-text='<span class="ui green text"><i>Adding New Address...</i></span>'>
            <i class="ui dark blue plus icon"></i>
            Add another address
        </div>
    </div>
</div>

{{{fileForm.dlSince.hidden.input}}}
