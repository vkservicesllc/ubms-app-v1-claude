<div class="ui yellow icon message" style="width: 100% !important; margin-bottom: 2.4rem;">
    <i class="tasks icon"></i>
    <div class="content">
        <div class="header">
            Social Security Number Data Verification
        </div>
        <ul class="list">
            <li>Thoroughly compare the data shown on the uploaded SSN card image with the information entered in the form</li>
            <li>Identify any discrepancies and correct all inaccuracies to ensure the data matches exactly</li>
            <li>Once verified, confirm the correctness of the data by checking the slider</li>
        </ul>
    </div>
</div>

<table class="ui compact celled definition table">
    <thead>
        <tr>
            <th class="empty-header"></th>
            <th style="width: 14rem;">{{{fileForm.ssn.text.label}}}</th>
            <th>{{{fileForm.dhsReq.checkbox.label}}}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="collapsing">
                <div class="ui fitted slider checkbox">
                    <input class="file-form-confirm-check file-form-confirm-ssc-check" type="checkbox" required /><label></label>
                </div>
                <span class="ui dark green text" style="display: none;">
                    <i class="icon checkmark"></i> Correct
                </span>
            </td>
            <td>
                <div class="field">
                    {{{fileForm.ssn.text.input}}}
                </div>
            </td>
            <td>
                <div class="field">
                    <div class="ui checkbox">
                        {{{fileForm.dhsReq.checkbox.input}}}
                        <label></label>
                    </div>
                </div>
            </td>
        </tr>
    </tbody>
</table>
