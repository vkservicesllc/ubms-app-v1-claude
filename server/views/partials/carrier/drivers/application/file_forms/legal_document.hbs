<div class="ui yellow icon message" style="width: 100% !important; margin-bottom: 2.4rem;">
    <i class="tasks icon"></i>
    <div class="content">
        <div class="header">
            Legal Document Data Registration
        </div>
        <p>Before uploading, make sure the details on the document match what you entered in the form</p>
    </div>
</div>

<table class="ui compact celled table">
    <thead>
        <tr>
            <th class="empty-header"></th>
            <th style="width: 12rem;">{{{fileForm.legExp.text.label}}}</th>
            <th style="width: 12rem;">{{{fileForm.legIss.text.label}}}</th>
            <th>{{{fileForm.legDocNumber.text.label}}}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="collapsing">
                <div class="ui fitted slider checkbox">
                    <input class="file-form-confirm-check file-form-confirm-leg-check" type="checkbox" required /><label></label>
                </div>
                <span class="ui dark green text" style="display: none;">
                    <i class="icon checkmark"></i> Correct
                </span>
            </td>
            <td>
                <div class="field">
                    <div class="ui calendar" id="leg-expires-confirm-calendar">
                        <div class="ui fluid input left icon">
                            {{{fileForm.legExp.text.input}}}
                            <i class="calendar icon"></i>
                        </div>
                    </div>
                </div>
            </td>
            <td>
                <div class="field">
                    <div class="ui calendar" id="leg-issued-confirm-calendar">
                        <div class="ui fluid input left icon">
                            {{{fileForm.legIss.text.input}}}
                            <i class="calendar icon"></i>
                        </div>
                    </div>
                </div>
            </td>
            <td>
                <div class="field">
                    {{{fileForm.legDocNumber.text.input}}}
                </div>
            </td>
        </tr>
    </tbody>
</table>
