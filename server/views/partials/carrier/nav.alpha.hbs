{{> head}}

    <style>
        .ui.pusher {
            z-index: 0 !important;
            padding: 20px;
        }
        .ui.sidebar {
            overflow: visible !important; /* Allows dropdown to be visible outside */
            z-index: 1001 !important;
        }
        .ui.dropdown {
            position: relative;
            z-index: 1002 !important;
        }
        .ui.dropdown .menu {
            position: absolute !important;
            z-index: 1003 !important;
            top: 100%;
            left: 0;
            right: 0;
            width: max-content; /* ensures dropdown size is based on content */
        }
        #team-item {
            align-items: center;
            justify-content: center;
            padding: 0 15px !important;
            font-size: 1.2em;
            color: yellowgreen;
        }
    </style>
    <div class="ui left visible vertical inverted labeled icon sidebar menu" id="left-nav">
        <a class="item" id="team-link">
            <i class="people arrows icon"></i>
            Teams
        </a>
        <a class="{{nav.left.dash}}item" href="/dashboard">
            <i class="chart pie icon"></i>
            Dashboard
        </a>
        <a class="{{nav.left.vehicles}}item" href="/vehicles">
            <i class="truck icon"></i>
            Vehicles
        </a>
        <a class="{{nav.left.drivers}}item" href="/drivers">
            <i class="tachometer alternate icon"></i>
            Drivers
        </a>
        <a class="{{nav.left.dispatch}}item">
            <i class="user tie icon"></i>
            Dispatch
        </a>
        <a class="{{nav.left.payroll}}item">
            <i class="dollar sign icon"></i>
            Payroll
        </a>
        <a class="{{nav.left.ifta}}item">
            <i class="file invoice dollar icon"></i>
            IFTA
        </a>
    </div>
    <form action="/session/team/exit" id="team-form" method="POST" style="display: none;"></form>
    <div class="ui top visible inverted sidebar menu" id="top-nav">
        <span class="item" id="team-item">{{team.name}}</span>{{{nav.top.items}}}
        <div class="ui right dropdown item">
            {{user.name}}
            <i class="dropdown icon"></i>
            <div class="menu">
                <a class="item">Profile</a>
                <a class="item">Settings</a>
                <a class="item">Logout</a>
            </div>
        </div>
    </div>

    <div class="ui pusher">
