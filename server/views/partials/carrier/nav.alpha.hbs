{{> head}}

    <div class="ui left visible vertical inverted labeled icon sidebar menu" id="left-nav">
        {{#if (eq teamSelect false)}}
        <a class="item" id="team-link">
            <i class="people arrows icon"></i>
            Teams
        </a>
        {{/if}}
        <a class="{{nav.left.dash}}item" href="/dashboard">
            <i class="chart pie icon"></i>
            Dashboard
        </a>
        {{#if (eq PG.vhl true)}}
        <a class="{{nav.left.vehicles}}item" href="/vehicles">
            <i class="truck icon"></i>
            Vehicles
        </a>
        {{/if}}
        {{#if (eq PG.drv true)}}
        <a class="{{nav.left.drivers}}item" href="/drivers">
            <i class="tachometer alternate icon"></i>
            Drivers
        </a>
        {{/if}}
        {{#if (eq PG.dsp true)}}
        <a class="{{nav.left.dispatch}}item">
            <i class="user tie icon"></i>
            Dispatch
        </a>
        {{/if}}
        {{#if (eq PG.prl true)}}
        <a class="{{nav.left.payroll}}item">
            <i class="dollar sign icon"></i>
            Payroll
        </a>
        {{/if}}
        {{#if (eq PG.rtx true)}}
        <a class="{{nav.left.ifta}}item">
            <i class="file invoice dollar icon"></i>
            IFTA
        </a>
        {{/if}}
    </div>
    <form action="/session/team/exit" id="team-form" method="POST" style="display: none;"></form>
    <div class="ui top visible inverted sidebar menu" id="top-nav">
        {{#if (eq teamSelect false)}}
        <span class="item" id="team-item">{{team.name}}</span>{{{nav.top.items}}}
        {{/if}}
        {{#if (eq teamSelect true)}}
        {{{teamDropdown}}}{{{nav.top.items}}}
        {{!-- <div class="ui inline dropdown item" id="team-item">
            {{team.name}}
            <i class="dropdown icon"></i>
            <div class="menu">{{{teamDropdown}}}
            </div>
        </div> --}}
        {{/if}}
        <div class="ui right inline dropdown item">
            <div class="text">
                <img class="ui avatar image" src="{{user.avaSrc}}">
                {{user.name}}
            </div>
            <i class="dropdown icon"></i>
            <div class="menu">
                <div class="header">App</div>
                <a class="item" href="/settings"><i class="cog icon"></i>Settings</a>
                <div class="divider"></div>
                <div class="header">User</div>
                <a class="item" href="{{addrBook.user}}/profile?refer={{{user._id}}}" target="_blank">
                    <i class="user circle icon"></i>
                    Profile
                </a>
                <a class="item" href="{{addrBook.user}}/account?refer={{{user._id}}}" target="_blank">
                    <i class="user shield icon"></i>
                    Account
                </a>
                <a class="item" href="{{addrBook.user}}/security?refer={{{user._id}}}" target="_blank">
                    <i class="key icon"></i>
                    Security
                </a>
                <div class="divider"></div>
                <a class="item" href="{{logoutUrl}}">
                    <i class="sign out alternate red text icon"></i>
                    <span class="ui red text">Sign out</span>
                </a>
            </div>
        </div>
    </div>

    <div class="ui pusher">
