<div class="accordion-item" id="employment-accordion-item" {{{scrollPoint.employment}}}>
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.six.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-6">
            <i class="{{accordion.six.state}} accordion-button-state"></i>
            <strong>{{idx steps 6}}</strong>
        </button>
    </h2>
    <div id="collapse-6" class="text-start accordion-collapse collapse{{accordion.six.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="prevempl-form" action="{{actionUrl.prevEmployment}}" method="POST" autocomplete="off">

                {{!-- NOT USED YET --}}
                <input type="hidden" id="empl-exp-start-date" value="{{emplExpStartDate}}" />

                <div class="row g-3 my-1"{{{employedDisplay}}}>
                    <label class="form-label">
                        Are you currently employed, or have you been employed in the U.S. within the past 10 years?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.prevEmployed.radio.yes.input}}}
                            {{{form.prevEmployed.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.prevEmployed.radio.no.input}}}
                            {{{form.prevEmployed.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <label class="form-label fw-normal text-warning mt-3 mb-0" id="employment-message" style="display: none;">
                    <small>
                        <i class="fas fa-circle-exclamation"></i>
                        List all jobs from the past 3 years
                        {{#if (eq noExp false)}}
                        and all commercial driving experience
                        {{#if (hv expDate)}}
                        since {{expDate}}
                        {{else}}
                        from the past 10 years
                        {{/if}}
                        {{/if}}
                        , starting with the most recent
                    </small>
                </label>
                <div id="prev-employments" style="display: none;">
                    <style>
                        .employer-list-title { color: #9df3c5; }
                    </style>
                    <div class="border-bottom py-4" id="prevempl-list"></div>
                    <div class="d-flex flex-column flex-md-row justify-content-between pt-3" style="display: none;">
                        <div class="form-check order-2 order-md-1">
                            <input type="checkbox" class="form-check-input" id="no-additional-employers" />
                            <label class="form-check-label" for="no-additional-employers">No additional employers to report</label>
                        </div>
                        <button type="button" class="btn btn-primary bg-primary-subtle order-1 order-md-2 mb-3" id="add-prevempl-button">
                            Add Employer
                        </button>
                    </div>
                </div>
                <p class="form-text text-danger mt-4" id="prevempl-form-help" style="display: none;"></p>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.six.class}}" id="prevempl-submit">{{button.six.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <form id="employer-form" action="{{actionUrl.prevEmployer}}" method="POST" autocomplete="off" style="display: none;">
                <div class="border-top mt-4">
                    {{{emplForm.id.hidden.input}}}
                    <div class="row g-3 my-1">
                        <div class="col-md-9">
                            {{{emplForm.employer.text.label}}}
                            {{{emplForm.employer.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-4">
                            {{{emplForm.startDate.text.label}}}
                            {{{emplForm.startDate.text.input}}}
                            <div class="form-text text-danger"></div>
                        </div>
                        <div class="col-md-5">
                            {{{emplForm.phone.text.label}}}
                            {{{emplForm.phone.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6 autocomplete">
                            {{{emplForm.address1.text.label}}}
                            {{{emplForm.address1.text.input}}}
                            <ul class="autocomplete-list address-predictions"></ul>
                        </div>
                        <div class="col-md-3">
                            {{{emplForm.address2.text.label}}}
                            {{{emplForm.address2.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{emplForm.addrZip.text.label}}}
                            {{{emplForm.addrZip.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{emplForm.addrCity.text.label}}}
                            {{{emplForm.addrCity.text.input}}}
                        </div>
                        <div class="col-md-6">
                            {{{emplForm.addrState.select.label}}}
                            {{{emplForm.addrState.select.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{emplForm.position.text.label}}}
                            {{{emplForm.position.text.input}}}
                        </div>
                        <div class="col-md-6">
                            {{{emplForm.earnings.text.label}}}
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                {{{emplForm.earnings.text.input}}}
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        {{#if (eq cdl true)}}
                        <label class="form-label mb-0">
                            During this employment, were you subject to any of the following?
                        </label>
                        <div class="col-md-12">
                            <label class="form-label">
                                &bull; Federal Motor Carrier Safety Regulations (FMCSRs)
                            </label>
                            <div class="col-md-12 mt-0 mb-2">
                                <div class="form-check form-check-inline">
                                    {{{emplForm.FMCSR.radio.yes.input}}}
                                    {{{emplForm.FMCSR.radio.yes.label}}}
                                </div>
                                <div class="form-check form-check-inline">
                                    {{{emplForm.FMCSR.radio.no.input}}}
                                    {{{emplForm.FMCSR.radio.no.label}}}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">
                                &bull; DOT Drug/Alcohol Testing
                            </label>
                            <div class="col-md-12 mt-0 mb-2">
                                <div class="form-check form-check-inline">
                                    {{{emplForm.dotDat.radio.yes.input}}}
                                    {{{emplForm.dotDat.radio.yes.label}}}
                                </div>
                                <div class="form-check form-check-inline">
                                    {{{emplForm.dotDat.radio.no.input}}}
                                    {{{emplForm.dotDat.radio.no.label}}}
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="col-md-12">
                            <label class="form-label">
                                Were you subject to DOT Drug/Alcohol Testing during this employment?
                            </label>
                            <div class="col-md-12 mt-0 mb-2">
                                <div class="form-check form-check-inline">
                                    {{{emplForm.dotDat.radio.yes.input}}}
                                    {{{emplForm.dotDat.radio.yes.label}}}
                                </div>
                                <div class="form-check form-check-inline">
                                    {{{emplForm.dotDat.radio.no.input}}}
                                    {{{emplForm.dotDat.radio.no.label}}}
                                </div>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="still-employed" />
                                <label class="form-check-label" for="still-employed">Check if you are still employed by this employer</label>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-4" id="termination-date-field">
                            {{{emplForm.endDate.text.label}}}
                            {{{emplForm.endDate.text.input}}}
                            <div class="form-text text-danger"></div>
                        </div>
                        <div class="col-md-8">
                            {{{emplForm.RFL.text.label}}}
                            {{{emplForm.RFL.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-2">
                        <div class="col-md-4">
                            <div class="d-grid">
                                <button type="submit" class="btn" id="employer-submit"></button>
                            </div>
                        </div>
                        <div class="col-md-4" style="display: none;">
                            <div class="d-grid">
                                <button class="btn btn-secondary bg-secondary-subtle" id="employer-cancel">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <div class="modal fade" id="delete-prevempl-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">Delete Employer</h1>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="delete-prevempl-target" />
                            <p class="my-1"><small>Are you sure you want to remove the following employer?</small></p>
                            <p class="my-1" id="delete-prevempl-desc"></p>
                            {{!-- <p class="my-1"><small>This change will take effect after you click the "{{button.six.text}}" button</small></p> --}}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary bg-secondary-subtle" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger bg-danger-subtle" id="remove-prevempl-button">Delete Employer</button>
                        </div>
                    </div>
                </div>
            </div>
            <script type="module" src="/modules/application/prev-employment.mjs"></script>
        </div>
    </div>
</div>
