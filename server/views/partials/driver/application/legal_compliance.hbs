<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.three.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-3">
            <i class="{{accordion.three.state}} accordion-button-state"></i>
            <strong>{{idx steps 3}}</strong>
        </button>
    </h2>
    <div id="collapse-3" class="text-start accordion-collapse collapse{{accordion.three.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="legal-form" action="{{actionUrl.legal}}" method="POST" autocomplete="off">
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Have you ever been arrested in connection with impaired or intoxicated driving (DUI/DWI)?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.dui.radio.yes.input}}}
                            {{{form.dui.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.dui.radio.no.input}}}
                            {{{form.dui.radio.no.label}}}
                        </div>
                    </div>
                    <div class="col-md-8 mt-0"{{{duiInDecadeDisplay}}}>
                        {{{form.duiInDecade.radio.label}}}
                        <div class="form-check form-check-inline">
                            {{{form.duiInDecade.radio.yes.input}}}
                            {{{form.duiInDecade.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.duiInDecade.radio.no.input}}}
                            {{{form.duiInDecade.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Have you ever been charged with or found guilty of a misdemeanor or felony offense?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.criminal.radio.yes.input}}}
                            {{{form.criminal.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.criminal.radio.no.input}}}
                            {{{form.criminal.radio.no.label}}}
                        </div>
                    </div>
                    <div class="col-md-8 mt-0"{{{criminalExplDisplay}}}>
                        {{{form.criminalExpl.text.label}}}
                        {{{form.criminalExpl.text.input}}}
                    </div>
                </div>
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Have you been issued any traffic citations within the past 3 years?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.citations.radio.yes.input}}}
                            {{{form.citations.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.citations.radio.no.input}}}
                            {{{form.citations.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <div id="citations"{{{citationsDisplay}}}>
                    <label class="form-label text-danger mt-3 mb-0">At least one citation must be reported</label>
                    <div class="border-bottom pb-4" id="citation-list"></div>
                    <div class="d-flex">
                        <div class="ms-auto pt-3">
                            <button type="button" class="btn btn-secondary btn-sm" id="add-citation-button"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                <p class="form-text text-danger mt-4" id="legal-form-help" style="display: none;"></p>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.three.class}}" id="legal-submit">{{button.three.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <div id="citation-form-template" style="display: none;">
                <div class="border-top mt-4">
                    <div class="d-flex" id="delete-citation" style="display: none !important;">
                        <div class="ms-auto pt-3">
                            <button type="button" class="btn btn-danger btn-sm delete-citation-button" data-bs-toggle="modal" data-bs-target="#delete-citation-modal"><i class="fas fa-close"></i></button>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-4">
                            {{{form._citDate.text.label}}}
                            {{{form._citDate.text.input}}}
                            <div class="form-text text-danger"></div>
                        </div>
                        <div class="col-md-3">
                            {{{form._citState.select.label}}}
                            {{{form._citState.select.input}}}
                        </div>
                        <div class="col-md-5">
                            {{{form._citReason.select.label}}}
                            {{{form._citReason.select.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6" style="display: none;">
                            {{{form._citOtherReason.text.label}}}
                            {{{form._citOtherReason.text.input}}}
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="delete-citation-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">Delete Citation</h1>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="delete-citation-target" />
                            <p class="my-1"><small>Are you sure you want to remove the following citation?</small></p>
                            <p class="my-1" id="delete-citation-desc"></p>
                            <p class="my-1"><small>This change will take effect after you click the "{{button.three.text}}" button</small></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger" id="remove-citation-button">Remove</button>
                        </div>
                    </div>
                </div>
            </div><script type="module" src="/modules/application/legal-compliance.mjs"></script>
        </div>
    </div>
</div>
