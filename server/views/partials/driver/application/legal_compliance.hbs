<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.three.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-3">
            <i class="{{accordion.three.state}} accordion-button-state"></i>
            <strong>{{idx steps 3}}</strong>
        </button>
    </h2>
    <div id="collapse-3" class="text-start accordion-collapse collapse{{accordion.three.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="legal-form" action="{{actionUrl.legal}}" method="POST" autocomplete="off">
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Have you ever been arrested in connection with impaired or intoxicated driving (DUI/DWI)?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.dui.radio.yes.input}}}
                            {{{form.dui.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.dui.radio.no.input}}}
                            {{{form.dui.radio.no.label}}}
                        </div>
                    </div>
                    <div class="col-md-8 mt-0"{{{duiInDecadeDisplay}}}>
                        {{{form.duiInDecade.radio.label}}}
                        <div class="form-check form-check-inline">
                            {{{form.duiInDecade.radio.yes.input}}}
                            {{{form.duiInDecade.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.duiInDecade.radio.no.input}}}
                            {{{form.duiInDecade.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Have you ever been charged with or found guilty of a misdemeanor or felony offense?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.criminal.radio.yes.input}}}
                            {{{form.criminal.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.criminal.radio.no.input}}}
                            {{{form.criminal.radio.no.label}}}
                        </div>
                    </div>
                    <div class="col-md-8 mt-0"{{{criminalExplDisplay}}}>
                        {{{form.criminalExpl.text.label}}}
                        {{{form.criminalExpl.text.input}}}
                    </div>
                </div>
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Have you been issued any traffic citations within the past 3 years?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.citations.radio.yes.input}}}
                            {{{form.citations.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.citations.radio.no.input}}}
                            {{{form.citations.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <div id="citations"{{{citationsDisplay}}}>
                    <div id="citation-list"></div>
                    <div class="col-md-2 mt-4">
                        <div class="d-grid">
                            <button class="btn btn-primary"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.three.class}}" id="mec-submit">{{button.three.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <div class="border-top mt-4" id="citation-form-sample" style="display: none;">
                <div class="row g-3 my-1">
                    <div class="col-md-4">
                        {{{form.citDate.text.label}}}
                        {{{form.citDate.text.input}}}
                        <div class="form-text text-danger" id="cit-date-help"></div>
                    </div>
                    <div class="col-md-3">
                        {{{form.citState.select.label}}}
                        {{{form.citState.select.input}}}
                    </div>
                    <div class="col-md-5">
                        {{{form.citReason.select.label}}}
                        {{{form.citReason.select.input}}}
                    </div>
                </div>
                <div class="row g-3 my-1" style="display: none;">
                    <div class="col-md-6">
                        {{{form.citOtherReason.text.label}}}
                        {{{form.citOtherReason.text.input}}}
                    </div>
                </div>
            </div>
            <script type="module" src="/modules/application/legal-compliance.mjs"></script>
        </div>
    </div>
</div>
