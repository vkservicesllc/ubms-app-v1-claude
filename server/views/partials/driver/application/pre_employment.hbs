<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.six.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-6">
            <i class="{{accordion.six.state}} accordion-button-state"></i>
            <strong>{{idx steps 6}}</strong>
        </button>
    </h2>
    <div id="collapse-6" class="text-start accordion-collapse collapse{{accordion.six.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="preempl-form" action="{{actionUrl.preEmployment}}" method="POST" autocomplete="off">
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Are you currently employed, or have you been employed in the U.S. within the past 10 years?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.prevEmployed.radio.yes.input}}}
                            {{{form.prevEmployed.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.prevEmployed.radio.no.input}}}
                            {{{form.prevEmployed.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.six.class}}" id="preempl-submit">{{button.six.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <div id="preempl-form-template" style="display: ;">
                <div class="border-top mt-4">
                    <div class="d-flex">
                        <div class="ms-auto pt-3" style="display: none !important;">
                            <button type="button" class="btn btn-danger btn-sm delete-preempl-button" data-bs-toggle="modal" data-bs-target="#delete-preempl-modal">
                                <i class="fas fa-close"></i>
                            </button>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-7">
                            {{{form._prevEmployer.text.label}}}
                            {{{form._prevEmployer.text.input}}}
                        </div>
                        <div class="col-md-5">
                            {{{form._emplPhone.text.label}}}
                            {{{form._emplPhone.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{form._emplAddr1.text.label}}}
                            {{{form._emplAddr1.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{form._emplAddr2.text.label}}}
                            {{{form._emplAddr2.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{form._emplAddrZip.text.label}}}
                            {{{form._emplAddrZip.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-5">
                            {{{form._emplAddrCity.text.label}}}
                            {{{form._emplAddrCity.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{form._emplAddrState.select.label}}}
                            {{{form._emplAddrState.select.input}}}
                        </div>
                        <div class="col-md-4">
                            {{{form._emplStartDate.text.label}}}
                            {{{form._emplStartDate.text.input}}}
                            <div class="form-text text-danger" id="empl-start-help"></div>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{form._emplPosition.text.label}}}
                            {{{form._emplPosition.text.input}}}
                        </div>
                        <div class="col-md-6">
                            {{{form._emplEarnings.text.label}}}
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                {{{form._emplEarnings.text.input}}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
