<div class="accordion-item"{{{scrollPoint.employment}}}>
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.six.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-6">
            <i class="{{accordion.six.state}} accordion-button-state"></i>
            <strong>{{idx steps 6}}</strong>
        </button>
    </h2>
    <div id="collapse-6" class="text-start accordion-collapse collapse{{accordion.six.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="preempl-form" action="{{actionUrl.preEmployment}}" method="POST" autocomplete="off">
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Are you currently employed, or have you been employed in the U.S. within the past 10 years?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.prevEmployed.radio.yes.input}}}
                            {{{form.prevEmployed.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.prevEmployed.radio.no.input}}}
                            {{{form.prevEmployed.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <div id="pre-employments"{{{preemplDisplay}}}>
                    <label class="form-label fw-normal text-danger mt-3 mb-0">
                        <small>
                            <i class="fas fa-circle-exclamation"></i>
                            At least one employer must be reported
                        </small>
                    </label>
                    <div class="border-bottom pb-4" id="preempl-list"></div>
                    <div class="d-flex">
                        <div class="ms-auto pt-3">
                            <button type="button" class="btn btn-primary bg-primary-subtle btn-sm" id="add-preempl-button">
                                {{!-- <i class="fas fa-plus"></i> --}}
                                Add Employer
                            </button>
                        </div>
                    </div>
                </div>
                <p class="form-text text-danger mt-4" id="preempl-form-help" style="display: none;"></p>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.six.class}}" id="preempl-submit">{{button.six.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <div class="employer-form" id="preempl-form-template" style="display: none;">
                <div class="border-top mt-4">
                    <div class="d-flex">
                        <div class="ms-auto pt-3" style="display: none !important;">
                            <button type="button" class="btn btn-danger bg-danger-subtle btn-sm delete-preempl-button" data-bs-toggle="modal" data-bs-target="#delete-preempl-modal">
                                {{!-- <i class="fas fa-close"></i> --}}
                                Delete Employer
                            </button>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-7">
                            {{{form._prevEmployer.text.label}}}
                            {{{form._prevEmployer.text.input}}}
                        </div>
                        <div class="col-md-5">
                            {{{form._emplPhone.text.label}}}
                            {{{form._emplPhone.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{form._emplAddr1.text.label}}}
                            {{{form._emplAddr1.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{form._emplAddr2.text.label}}}
                            {{{form._emplAddr2.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{form._emplAddrZip.text.label}}}
                            {{{form._emplAddrZip.text.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-5">
                            {{{form._emplAddrCity.text.label}}}
                            {{{form._emplAddrCity.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{form._emplAddrState.select.label}}}
                            {{{form._emplAddrState.select.input}}}
                        </div>
                        <div class="col-md-4">
                            {{{form._emplStartDate.text.label}}}
                            {{{form._emplStartDate.text.input}}}
                            <div class="form-text text-danger"></div>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{form._emplPosition.text.label}}}
                            {{{form._emplPosition.text.input}}}
                        </div>
                        <div class="col-md-6">
                            {{{form._emplEarnings.text.label}}}
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                {{{form._emplEarnings.text.input}}}
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        {{#if (eq cdl true)}}
                        <label class="form-label mb-0">
                            During this employment, were you subject to any of the following?
                        </label>
                        <div class="col-md-12">
                            <label class="form-label">
                                &bull; Federal Motor Carrier Safety Regulations (FMCSRs)
                            </label>
                            <div class="col-md-12 mt-0 mb-2">
                                <div class="form-check form-check-inline">
                                    {{{form._emplFMCSR.radio.yes.input}}}
                                    {{{form._emplFMCSR.radio.yes.label}}}
                                </div>
                                <div class="form-check form-check-inline">
                                    {{{form._emplFMCSR.radio.no.input}}}
                                    {{{form._emplFMCSR.radio.no.label}}}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">
                                &bull; DOT Drug/Alcohol Testing
                            </label>
                            <div class="col-md-12 mt-0 mb-2">
                                <div class="form-check form-check-inline">
                                    {{{form._emplDotDat.radio.yes.input}}}
                                    {{{form._emplDotDat.radio.yes.label}}}
                                </div>
                                <div class="form-check form-check-inline">
                                    {{{form._emplDotDat.radio.no.input}}}
                                    {{{form._emplDotDat.radio.no.label}}}
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="col-md-12">
                            <label class="form-label">
                                Were you subject to DOT Drug/Alcohol Testing during this employment?
                            </label>
                            <div class="col-md-12 mt-0 mb-2">
                                <div class="form-check form-check-inline">
                                    {{{form._emplDotDat.radio.yes.input}}}
                                    {{{form._emplDotDat.radio.yes.label}}}
                                </div>
                                <div class="form-check form-check-inline">
                                    {{{form._emplDotDat.radio.no.input}}}
                                    {{{form._emplDotDat.radio.no.label}}}
                                </div>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-8">
                            {{{form._emplRFL.text.label}}}
                            {{{form._emplRFL.text.input}}}
                        </div>
                        <div class="col-md-4">
                            {{{form._emplEndDate.text.label}}}
                            {{{form._emplEndDate.text.input}}}
                            <div class="form-text text-info">Blank if still employed</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="delete-preempl-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">Delete Employer</h1>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="delete-preempl-target" />
                            <p class="my-1"><small>Are you sure you want to remove the following employer?</small></p>
                            <p class="my-1" id="delete-preempl-desc"></p>
                            <p class="my-1"><small>This change will take effect after you click the "{{button.six.text}}" button</small></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger" id="remove-preempl-button">Remove</button>
                        </div>
                    </div>
                </div>
            </div>
            <script type="module" src="/modules/application/pre-employment.mjs"></script>
        </div>
    </div>
</div>
