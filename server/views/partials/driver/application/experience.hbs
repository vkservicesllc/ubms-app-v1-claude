<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.five.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-5">
            <i class="{{accordion.five.state}} accordion-button-state"></i>
            <strong>{{idx steps 5}}</strong>
        </button>
    </h2>
    <div id="collapse-5" class="text-start accordion-collapse collapse{{accordion.five.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="experience-form" action="{{actionUrl.experience}}" method="POST" autocomplete="off">
                <div class="row g-3 my-1">
                    <div class="col-md-12">
                        <div class="form-check">
                            {{{form.noExp.checkbox.input}}}
                            {{{form.noExp.checkbox.label}}}
                        </div>
                    </div>
                </div>
                <div id="experience-details"{{{expDetailsDisplay}}}>

                    {{#if (
                        and
                            (eq deptId 0)
                            (eq cdl true)
                    )}}
                    <div class="row g-3 my-1">
                        <label class="form-label">
                            Have you previously operated a Commercial Motor Vehicle (CMV)?
                        </label>
                        <div class="col-md-4 mt-0 mb-2">
                            <div class="form-check form-check-inline">
                                {{{form.cmvExp.radio.yes.input}}}
                                {{{form.cmvExp.radio.yes.label}}}
                            </div>
                            <div class="form-check form-check-inline">
                                {{{form.cmvExp.radio.no.input}}}
                                {{{form.cmvExp.radio.no.label}}}
                            </div>
                        </div>
                    </div>
                    {{/if}}

                    <div class="row g-3 my-1">
                        <label class="form-label mb-0">
                            Select all options that best describe your driving experience:
                        </label>
                        <div class="col-md-{{vhlExpColWidth}} vehicle-experience-col-width">
                            {{{form.straightExp.checkbox.label}}}
                            <div class="form-check">
                                {{{form.straightExp.checkbox.box.input}}}
                                {{{form.straightExp.checkbox.box.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.straightExp.checkbox.cube.input}}}
                                {{{form.straightExp.checkbox.cube.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.straightExp.checkbox.dump.input}}}
                                {{{form.straightExp.checkbox.dump.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.straightExp.checkbox.rollback.input}}}
                                {{{form.straightExp.checkbox.rollback.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.straightExp.checkbox.pickup.input}}}
                                {{{form.straightExp.checkbox.pickup.label}}}
                            </div>
                        </div>
                        {{#if (
                            and
                                (eq deptId 0)
                                (eq cdl true)
                        )}}
                        <div class="col-md-4 cmv-experience"{{{cmvExpDisplay}}}>
                            {{{form.semiExp.checkbox.label}}}
                            <div class="form-check">
                                {{{form.semiExp.checkbox.van.input}}}
                                {{{form.semiExp.checkbox.van.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.semiExp.checkbox.reefer.input}}}
                                {{{form.semiExp.checkbox.reefer.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.semiExp.checkbox.flat.input}}}
                                {{{form.semiExp.checkbox.flat.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.semiExp.checkbox.step.input}}}
                                {{{form.semiExp.checkbox.step.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.semiExp.checkbox.tanker.input}}}
                                {{{form.semiExp.checkbox.tanker.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.semiExp.checkbox.lowboy.input}}}
                                {{{form.semiExp.checkbox.lowboy.label}}}
                            </div>
                            <div class="form-check">
                                {{{form.semiExp.checkbox.carhaul.input}}}
                                {{{form.semiExp.checkbox.carhaul.label}}}
                            </div>
                        </div>
                        {{/if}}
                        <div class="col-md-{{vhlExpColWidth}} vehicle-experience-col-width">
                            <label class="form-label">Misc</label>
                            <div class="form-check">
                                {{{form.vanExp.checkbox.input}}}
                                {{{form.vanExp.checkbox.label}}}
                            </div>
                            {{#if (
                                and
                                    (eq deptId 0)
                                    (eq cdl true)
                            )}}
                            <div class="form-check cmv-experience"{{{cmvExpDisplay}}}>
                                {{{form.tandemExp.checkbox.input}}}
                                {{{form.tandemExp.checkbox.label}}}
                            </div>
                            {{/if}}
                        </div>
                    </div>

                    <div class="row g-3 my-1">
                        <div class="col-md-4">
                            {{{form.expStartDate.text.label}}}
                            {{{form.expStartDate.text.input}}}
                            <div class="form-text text-danger" id="exp-start-help"></div>
                        </div>
                        <div class="col-md-4">
                            {{{form.expEndDate.text.label}}}
                            {{{form.expEndDate.text.input}}}
                            <div class="form-text text-danger" id="exp-end-help"></div>
                        </div>
                        {{#if (eq deptId 0)}}
                        <div class="col-md-4">
                            {{{form.expMileage.text.label}}}
                            {{{form.expMileage.text.input}}}
                        </div>
                        {{/if}}
                    </div>

                    {{#if (eq deptId 0)}}
                    <div class="row g-3 my-1">
                        <label class="form-label mb-0">
                            Enter the total full hours driven each day over the past 7 days:
                        </label>
                        <label class="form-label fw-normal text-secondary my-0">
                            <small>
                                <i class="fas fa-triangle-exclamation"></i>
                                Whole numbers only (0 if none, 12 maximum)
                            </small>
                        </label>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-6">
                                    {{{form.expHours1.text.label}}}
                                    {{{form.expHours1.text.input}}}
                                </div>
                                <div class="col-6">
                                    {{{form.expHours2.text.label}}}
                                    {{{form.expHours2.text.input}}}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-6">
                                    {{{form.expHours3.text.label}}}
                                    {{{form.expHours3.text.input}}}
                                </div>
                                <div class="col-6">
                                    {{{form.expHours4.text.label}}}
                                    {{{form.expHours4.text.input}}}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-6">
                                    {{{form.expHours5.text.label}}}
                                    {{{form.expHours5.text.input}}}
                                </div>
                                <div class="col-6">
                                    {{{form.expHours6.text.label}}}
                                    {{{form.expHours6.text.input}}}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-6">
                                    {{{form.expHours7.text.label}}}
                                    {{{form.expHours7.text.input}}}
                                </div>
                                <div class="col-6">
                                    <label class="form-label">&nbsp;<br/>Total</label>
                                    <input type="text" class="form-control" id="total-weekly-experience-hours" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/if}}

                    {{#if (
                        and
                            (eq deptId 0)
                            (eq cdl true)
                    )}}
                    <div class="row g-3 my-1">
                        <label class="form-label">
                            Have you attended a CDL training school in the past?
                        </label>
                        <div class="col-md-4 mt-0 mb-2">
                            <div class="form-check form-check-inline">
                                {{{form.cdlSchool.radio.yes.input}}}
                                {{{form.cdlSchool.radio.yes.label}}}
                            </div>
                            <div class="form-check form-check-inline">
                                {{{form.cdlSchool.radio.no.input}}}
                                {{{form.cdlSchool.radio.no.label}}}
                            </div>
                        </div>
                    </div>
                    <div class="border-top border-bottom py-4" id="cdl-school-form"{{{schoolDisplay}}}>
                        <label class="form-label mb-0">CDL Training School</label>
                        <div class="row g-3 my-1">
                            <div class="col-md-7">
                                {{{form.schName.text.label}}}
                                {{{form.schName.text.input}}}
                            </div>
                            <div class="col-md-5">
                                {{{form.schPhone.text.label}}}
                                {{{form.schPhone.text.input}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-3">
                                {{{form.schState.select.label}}}
                                {{{form.schState.select.input}}}
                            </div>
                            <div class="col-md-4">
                                {{{form.schEndDate.text.label}}}
                                {{{form.schEndDate.text.input}}}
                            <div class="form-text text-danger" id="sch-end-help"></div>
                            </div>
                            <div class="col-md-5">
                                {{{form.schDuration.select.label}}}
                                {{{form.schDuration.select.input}}}
                            </div>
                        </div>
                    </div>
                    {{/if}}

                    {{!-- {{#if (
                        and
                            (eq deptId 1)
                            (eq position 'OO')
                    )}}
                    <div class="row g-3 my-1">
                        <label class="form-label">
                            Do you currently own and drive a box truck or cargo van as part of your job?
                        </label>
                        <div class="col-md-4 mt-0 mb-2">
                            <div class="form-check form-check-inline">
                                {{{form.currentVhl.radio.yes.input}}}
                                {{{form.currentVhl.radio.yes.label}}}
                            </div>
                            <div class="form-check form-check-inline">
                                {{{form.currentVhl.radio.no.input}}}
                                {{{form.currentVhl.radio.no.label}}}
                            </div>
                        </div>
                    </div>
                    <div class="border-top border-bottom py-4" id="current-vhl-form"{{{vehicleDisplay}}}>
                        <label class="form-label mb-0">Describe your vehicle</label>
                        <div class="row g-3 my-1">
                            <div class="col-md-9">
                                {{{form.currentVhlMMT.select.label}}}
                                {{{form.currentVhlMMT.select.input}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-4">
                                {{{form.currentVhlMake.text.label}}}
                                {{{form.currentVhlMake.text.input}}}
                            </div>
                            <div class="col-md-5">
                                {{{form.currentVhlModel.text.label}}}
                                {{{form.currentVhlModel.text.input}}}
                            </div>
                            <div class="col-md-3">
                                {{{form.currentVhlYear.select.label}}}
                                {{{form.currentVhlYear.select.input}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-4">
                                {{{form.currentVhlType.select.label}}}
                                {{{form.currentVhlType.select.input}}}
                            </div>
                            <div class="col-md-5">
                                {{{form.currentSBoxLen.select.label}}}
                                {{{form.currentSBoxLen.select.input}}}
                            </div>
                        </div>
                    </div>
                    {{/if}} --}}

                </div>

                <p class="form-text text-danger mt-4" id="exp-form-help" style="display: none;"></p>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.five.class}}" id="experience-submit">{{button.five.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <script type="module" src="/modules/application/experience.mjs"></script>
            {{#if (eq deptId 0)}}
            <script type="module" src="/modules/application/experience.truck-load.mjs"></script>
            {{/if}}
            {{#if (eq deptId 1)}}
            <script type="module" src="/modules/application/experience.expedite.mjs"></script>
            {{/if}}
        </div>
    </div>
</div>
