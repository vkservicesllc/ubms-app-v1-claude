<div class="accordion-item"{{{scrollPoint.business}}}>
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.eight.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-8">
            <i class="{{accordion.eight.state}} accordion-button-state"></i>
            <strong>{{idx steps 8}}</strong>
        </button>
    </h2>
    <div id="collapse-8" class="text-start accordion-collapse collapse{{accordion.eight.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="business-form" action="{{actionUrl.business}}" method="POST" autocomplete="off">
                {{#if (eq position 'OO')}}
                <label class="form-label text-secondary">Business Entity</label>
                {{/if}}
                <p class="mb-0" style="font-size: .84em;">
                    All drivers engaged with our company are treated as Independent Contractors;
                    therefore, submission of a W-9 form for your business and a business checking account are both required.
                </p>
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Do you currently have an active <abbr title="Limited Liability Company">LLC</abbr> registered?
                    </label>
                    <div class="col-md-4 mt-0 mb-2">
                        <div class="form-check form-check-inline">
                            {{{form.activeLLC.radio.yes.input}}}
                            {{{form.activeLLC.radio.yes.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.activeLLC.radio.no.input}}}
                            {{{form.activeLLC.radio.no.label}}}
                        </div>
                    </div>
                </div>
                <div id="business-details"{{{llcDetailsDisplay}}}>
                    <div class="row g-3 my-1">
                        <div class="col-md-7">
                            {{{form.llcName.text.label}}}
                            <div class="input-group">
                                {{{form.llcName.text.input}}}
                                <span class="input-group-text">LLC</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{form.llcState.select.label}}}
                            {{{form.llcState.select.input}}}
                        </div>
                        <div class="col-md-4">
                            {{{form.llcEin.text.label}}}
                            {{{form.llcEin.text.input}}}
                        </div>
                    </div>
                </div>
                {{!-- <div id="business-assistance"{{{llcAssistanceDisplay}}}>
                    <div class="row g-3 my-1">
                        <label class="form-label">
                            Would you like assistance in establishing your business entity?
                        </label>
                        <div class="col-md-4 mt-0 mb-2">
                            <div class="form-check form-check-inline">
                                {{{form.llcAssistance.radio.yes.input}}}
                                {{{form.llcAssistance.radio.yes.label}}}
                            </div>
                            <div class="form-check form-check-inline">
                                {{{form.llcAssistance.radio.no.input}}}
                                {{{form.llcAssistance.radio.no.label}}}
                            </div>
                        </div>
                        <div class="col-md-7 mt-0"{{{llcProposedDisplay}}}>
                            {{{form.llcProposedName.text.label}}}
                            <div class="input-group">
                                {{{form.llcProposedName.text.input}}}
                                <span class="input-group-text">LLC</span>
                            </div>
                        </div>
                    </div>
                </div> --}}
                <label class="form-label fw-normal text-danger mt-3 mb-0">
                    <small>
                        <i class="fas fa-circle-exclamation"></i>
                        Your business account information will be collected if you are hired
                    </small>
                </label>
                {{#if (eq position 'OO')}}
                <div class="border-top mt-4 pt-3">
                    <label class="form-label text-secondary">Motor Vehicle Owned</label>
                    {{#if (eq deptId 0)}}
                    <div class="row g-3 my-1">
                        <div class="col-md-6">
                            {{{form.currentVhlType.select.label}}}
                            {{{form.currentVhlType.select.input}}}
                        </div>
                    </div>
                    {{/if}}
                    {{#if (eq deptId 1)}}
                    <div class="row g-3 my-1">
                        <div class="col-md-7">
                            {{{form.currentVhlMMT.select.label}}}
                            {{{form.currentVhlMMT.select.input}}}
                        </div>
                        <div class="col-md-5">
                            {{{form.currentVhlType.select.label}}}
                            {{{form.currentVhlType.select.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1">
                        <div class="col-md-4">
                            {{{form.currentVhlMake.text.label}}}
                            {{{form.currentVhlMake.text.input}}}
                        </div>
                        <div class="col-md-5">
                            {{{form.currentVhlModel.text.label}}}
                            {{{form.currentVhlModel.text.input}}}
                        </div>
                        <div class="col-md-3">
                            {{{form.currentVhlYear.select.label}}}
                            {{{form.currentVhlYear.select.input}}}
                        </div>
                    </div>
                    <div class="row g-3 my-1"{{{currentVhlLenDisplay}}}>
                        <div class="col-md-6">
                            {{{form.currentVhlLen.select.label}}}
                            {{{form.currentVhlLen.select.input}}}
                        </div>
                    </div>
                    {{/if}}
                </div>
                {{/if}}
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.eight.class}}" id="business-submit">{{button.eight.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <script type="module" src="/modules/application/business.mjs"></script>
            {{#if (eq position 'OO')}}
            {{#if (eq deptId 0)}}
            <script type="module" src="/modules/application/vehicle.mjs"></script>
            {{/if}}
            {{#if (eq deptId 1)}}
            <script type="module" src="/modules/application/vehicle.expedite.mjs"></script>
            {{/if}}
            {{/if}}
        </div>
    </div>
</div>
