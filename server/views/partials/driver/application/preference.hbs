<div class="accordion-item"{{{scrollPoint.preference}}}>
    <h2 class="accordion-header">
        <button class="accordion-button{{accordion.seven.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-7">
            <i class="{{accordion.seven.state}} accordion-button-state"></i>
            <strong>{{idx steps 7}}</strong>
        </button>
    </h2>
    <div id="collapse-7" class="text-start accordion-collapse collapse{{accordion.seven.body}}" data-bs-parent="#apl-accordion">
        <div class="accordion-body">
            <form id="preference-form" action="{{actionUrl.preference}}" method="POST" autocomplete="off">
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Do you prefer to operate solo or as part of a team?
                    </label>
                    <div class="col-md-4 my-0">
                        <div class="form-check form-check-inline">
                            {{{form.operType.radio.solo.input}}}
                            {{{form.operType.radio.solo.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.operType.radio.team.input}}}
                            {{{form.operType.radio.team.label}}}
                        </div>
                    </div>
                </div>
                {{#if (eq deptId 0)}}
                <div class="row g-3 my-1" id="partner"{{{partnerDisplay}}}>
                    <div class="col-md-7">
                        {{{form.teamName.text.label}}}
                        {{{form.teamName.text.input}}}
                    </div>
                    <div class="col-md-5 mb-2">
                        {{{form.teamPhone.text.label}}}
                        {{{form.teamPhone.text.input}}}
                    </div>
                </div>
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Please select your preferred hauling regions:
                    </label>
                    <div class="col-md-3 mt-0 mb-0">
                        <div class="form-check">
                            {{{form.haulRegion.checkbox.loc.input}}}
                            {{{form.haulRegion.checkbox.loc.label}}}
                        </div>
                        <div class="form-check">
                            {{{form.haulRegion.checkbox.reg.input}}}
                            {{{form.haulRegion.checkbox.reg.label}}}
                        </div>
                    </div>
                    <div class="col-md-6 mt-0 mb-2">
                        <div class="form-check">
                            {{{form.haulRegion.checkbox.otr.input}}}
                            {{{form.haulRegion.checkbox.otr.label}}}
                        </div>
                        <div class="form-check">
                            {{{form.haulRegion.checkbox.otrInt.input}}}
                            {{{form.haulRegion.checkbox.otrInt.label}}}
                        </div>
                    </div>
                </div>
                <div class="row g-3 my-1">
                    <label class="form-label">
                        Please select your preferred equipment types:
                    </label>
                    <div class="col-md-12 mt-0 mb-0">
                        <div class="form-check form-check-inline">
                            {{{form.equipmentType.checkbox.van.input}}}
                            {{{form.equipmentType.checkbox.van.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.equipmentType.checkbox.reefer.input}}}
                            {{{form.equipmentType.checkbox.reefer.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.equipmentType.checkbox.flat.input}}}
                            {{{form.equipmentType.checkbox.flat.label}}}
                        </div>
                        <div class="form-check form-check-inline">
                            {{{form.equipmentType.checkbox.step.input}}}
                            {{{form.equipmentType.checkbox.step.label}}}
                        </div>
                    </div>
                </div>
                {{/if}}
                <div class="row g-3 my-1">
                    <div class="col-md-6">
                        <label class="form-label">When would you like to start?</label>
                        {{{form.startPref.select.input}}}
                    </div>
                </div>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-{{button.seven.class}}" id="preference-submit">{{button.seven.text}}</button>
                        </div>
                    </div>
                </div>
            </form>
            <script type="module" src="/modules/application/preference.mjs"></script>
            {{#if (eq deptId 0)}}
            <script type="module" src="/modules/application/preference.truck-load.mjs"></script>
            {{/if}}
            {{#if (eq deptId 1)}}
            <script type="module" src="/modules/application/preference.expedite.mjs"></script>
            {{/if}}
        </div>
    </div>
</div>
