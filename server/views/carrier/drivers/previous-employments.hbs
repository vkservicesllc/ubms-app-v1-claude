{{> carrier/nav.alpha}}

        <style>
            .dtrg-group th { color: rgb(59, 118, 155); }
            .bull {
                padding: 0 .35rem;
            }
            .empl-side-th {
                width: 7.14rem;
                font-weight: bold;
            }
            .ui.horizontal.list {
                display: flex;
                align-items: flex-start;
            }
            .ui.horizontal.list .header {
                margin-top: .5em;
                margin-bottom: .2em;
                font-size: 1.2em;
                {{!-- outline: .07rem dotted red; --}}
            }
            .address-data {
                display: inline-block;
                margin-bottom: .3em;
            }
            .form-block {
                padding: .4em 1em;
            }
        </style>
        <table class="ui compact table" id="driver-apl-prev-employers-table" style="width: 100%;"></table>
        {{#if (
            or
                (eq permissions.modify true)
                (eq permissions.update true)
        )}}
        <div class="ui modal" id="empl-manage-card-modal" style="width: 68.5rem !important; height: 48.2rem;">
            <i class="close icon"></i>
            <div class="ui header">Employment Verification</div>
            <div class="content">
                <div class="ui relaxed horizontal list">
                    <div class="item">
                        <span class="ui text purple">Previous Employer:</span>
                        <div class="header employer-data" id="employer-data"></div>
                        <span class="employer-data address-data" id="employer-address-data"></span><br/>
                        <small>Phone:</small>
                        <span class="employer-data" id="employer-phone-data"></span><br/>
                        <small>Period:</small>
                        <span class="employer-data" id="employer-period-data"></span><br/>
                        <span style="display: inline-block; margin-top: .4em;">
                            <small><sup><i class="search icon"></i></sup>USDOT:</small>
                            <span class="employer-data" id="employer-usdot-data"></span>
                        </span>
                    </div>
                    <div class="item">
                        <span class="ui text purple">Applicant:</span>
                        <div class="header applicant-data" id="applicant-data"></div>
                        <span class="applicant-data address-data" id="applicant-address-data"></span><br/>
                        <small>Phone:</small>
                        <span class="applicant-data" id="applicant-phone-data"></span><br/>
                        <small>Application:</small>
                        <span class="applicant-data" id="applicant-form-data"></span>
                        <span class="applicant-data" id="applicant-submission-data"></span>
                    </div>
                    <div class="item">
                        <span class="ui text purple">Hiring Carrier:</span>
                        <div class="header carrier-data" id="carrier-data"></div>
                        <span class="carrier-data address-data" id="carrier-address-data"></span><br/>
                        <small class="carrier-label" style="display: none;">Phone:</small>
                        <span class="carrier-data" id="carrier-phone-data"></span>
                    </div>
                </div>
                <div class="ui divider"></div>
                <div class="ui secondary pointing menu">
                    {{# if (eq permissions.update true)}}
                    <a class="item form-item active" id="inquiries-item">Inquiry Attempts</a>
                    <a class="item form-item" id="verification-item">Verification</a>
                    {{!-- <a class="item form-item disabled" id="inquiry-item-3">Response Upload</a> --}}
                    {{/if}}
                    {{#if (eq permissions.modify true)}}
                    <a class="item form-item{{# if (eq permissions.update false)}} active{{/if}}" id="modification-item">
                        Employer Modification
                    </a>
                    {{/if}}
                    {{#if (eq permissions.update true)}}
                    <div class="right menu">
                        <div class="item">
                            <a id="verification-pdf-url" href="" target="_blank" style="font-size: 1.2em;"><i class="black file pdf outline icon"></i></a>
                        </div>
                    </div>
                    {{/if}}
                </div>
                {{!-- <div class="ui secondary pointing menu">
                    {{# if (eq permissions.update true)}}
                    <a class="item form-item active" id="inquiries-item">Inquiries</a>
                    <a class="item form-item" id="phone-verify-item">Phone Verification</a>
                    <a class="item form-item" id="write-verify-item">Written Verification</a>
                    {{/if}}
                    {{#if (eq permissions.modify true)}}
                    <a class="item form-item{{# if (eq permissions.update false)}} active{{/if}}" id="modification-item">
                        Employer Modification
                    </a>
                    {{/if}}
                    {{#if (eq permissions.update true)}}
                    <div class="right menu">
                        <div class="item">
                            <a href="" style="font-size: 1.2em;"><i class="black file pdf outline icon"></i></a>
                        </div>
                    </div>
                    {{/if}}
                </div> --}}
                {{# if (eq permissions.update true)}}
                <div class="form-block" id="inquiries-block">
                    <div class="ui negative message" id="no-carrier-message" style="display: none;">
                        <div class="header">Carrier not selected</div>
                        <p>In order to proceed with employment verification, you must be operating under a hiring carrier</p>
                    </div>
                    <form class="ui form" id="inquiries-form" action="" method="POST" autocomplete="off">
                        <h5 class="ui blue text header">Phone Inquiry</h5>
                        <div class="ui compact grid">
                            <div class="five wide field">
                                {{{form.inquirer1.select.label}}}
                                <div class="ui fluid selection dropdown" id="inquirer-dropdown-1">
                                    {{{form.inquirer1.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.inquirer1}}}
                                    </div>
                                </div>
                            </div>
                            <div class="three wide field">
                                {{{form.inquiryDate1.text.label}}}
                                <div class="ui calendar" id="inquiry-date-calendar-1">
                                    <div class="ui fluid input left icon">
                                        {{{form.inquiryDate1.text.input}}}
                                        <i class="calendar icon"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="three wide field">
                                {{{form.inquiryMethod1.select.label}}}
                                <div class="ui fluid selection dropdown" id="inquiry-method-dropdown-1">
                                    {{{form.inquiryMethod1.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.inquiryMethod1}}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="form-block" id="verification-block" style="display: none;">
                    VERIFICATION
                </div>
                {{!-- <div class="form-block" id="inquiry-block-3" style="display: none;">
                    INQUIRY #3
                </div> --}}
                {{/if}}
                {{#if (eq permissions.modify true)}}
                <div class="form-block" id="modification-block"{{# if (eq permissions.update true)}} style="display: none;"{{/if}}>
                    <form class="ui form" id="employer-form" action="/resource/drivers/prev-employments/modify" method="POST" autocomplete="off" style="margin-top: 1em;">
                        {{{form.id.hidden.input}}}
                        {{{form.appId.hidden.input}}}
                        {{!-- <input type="hidden" name="cdlRole" id="employment-cdl-role" /> --}}
                        <div class="ui grid">
                            <div class="twelve wide column">
                                <div class="ui compact grid">
                                    <div class="eight wide field">
                                        {{{form.employer.text.label}}}
                                        {{{form.employer.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.startDate.text.label}}}
                                        <div class="ui calendar empl-start-calendar" id="empl-start-date-calendar">
                                            <div class="ui fluid input left icon">
                                                {{{form.startDate.text.input}}}
                                                <i class="calendar icon"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="four wide field">
                                        {{{form.endDate2.text.label}}}
                                        <div class="ui calendar empl-end-calendar" id="empl-end-date-calendar">
                                            <div class="ui fluid input left icon">
                                                {{{form.endDate2.text.input}}}
                                                <i class="calendar icon"></i>
                                            </div>
                                        </div>
                                        <p class="help">
                                            <small>
                                                <span class="ui teal text">Blank if still employed</span>
                                            </small>
                                        </p>
                                    </div>
                                </div>
                                <div class="ui compact grid" style="margin-top: 1.2em;">
                                    <div class="five wide field">
                                        {{{form.phone.text.label}}}
                                        {{{form.phone.text.input}}}
                                    </div>
                                    <div class="seven wide field">
                                        {{{form.address1.text.label}}}
                                        {{{form.address1.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.address2.text.label}}}
                                        {{{form.address2.text.input}}}
                                    </div>
                                </div>
                                <div class="ui compact grid">
                                    <div class="four wide field">
                                        {{{form.addrZip.text.label}}}
                                        {{{form.addrZip.text.input}}}
                                    </div>
                                    <div class="seven wide field">
                                        {{{form.addrCity.text.label}}}
                                        {{{form.addrCity.text.input}}}
                                    </div>
                                    <div class="five wide field">
                                        {{{form.addrState.select.label}}}
                                        <div class="ui fluid selection required dropdown empl-addr-state-dropdown" id="empl-add-state-dropdown">
                                            {{{form.addrState.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.addrState}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="ui divider"></div>
                                <div class="ui compact grid">
                                    <div class="twelve wide field">
                                        <div class="inline fields">
                                            <div class="field">
                                                <div class="ui checkbox">
                                                    {{{form.FMCSR2.checkbox.input}}}
                                                    {{{form.FMCSR2.checkbox.label}}}
                                                </div>
                                            </div>
                                            <div class="field">
                                                <div class="ui checkbox">
                                                    {{{form.dotDat2.checkbox.input}}}
                                                    {{{form.dotDat2.checkbox.label}}}
                                                </div>
                                            </div>
                                            {{!-- <div class="seven wide field">
                                                {{{form.usdot.text.label}}}
                                                {{{form.usdot.text.input}}}
                                            </div> --}}
                                        </div>
                                    </div>
                                    <div class="four wide disabled field">
                                        {{{form.usdot.text.label}}}
                                        {{{form.usdot.text.input}}}
                                    </div>
                                </div>
                            </div>
                            <div class="four wide column">
                                <div class="ui compact grid">
                                    <div class="fifteen wide field" style="width: 100%;">
                                        {{{form.position.text.label}}}
                                        {{{form.position.text.input}}}
                                    </div>
                                    <div class="one wide field" style="width: 0;"></div>
                                </div>
                                <div class="ui compact grid">
                                    <div class="fifteen wide field" style="width: 100%;">
                                        {{{form.earnings.text.label}}}
                                        <div class="ui left icon input">
                                            <i class="dollar icon"></i>
                                            {{{form.earnings.text.input}}}
                                        </div>
                                    </div>
                                    <div class="one wide field" style="width: 0;"></div>
                                </div>
                                <div class="ui compact grid">
                                    <div class="fifteen wide field" style="width: 100%;">
                                        {{{form.RFL.text.label}}}
                                        {{{form.RFL.text.input}}}
                                    </div>
                                    <div class="one wide field" style="width: 0;"></div>
                                </div>
                                <div style="display: flex; justify-content: flex-end; margin-top: 2.2em;">
                                    <button type="submit" class="ui green circular button">Save Changes</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                {{/if}}
            </div>
            <script type="module" src="/modules/drivers/prev-employer.verification.mjs"></script>
        </div>
        {{/if}}
        <script type="module" src="/modules/drivers/prev-employers.mjs"></script>

{{> carrier/nav.omega}}