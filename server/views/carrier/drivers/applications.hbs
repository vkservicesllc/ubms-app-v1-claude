{{> carrier/nav.alpha}}

        <style>
            .dt-container { min-width: 1150px; }
            .custom-dt-toolbar { min-width: 67%; }
            .custom-dt-toolbar > * { width: 24.5%; }
            .ui.dropdown .transition i.icon { margin-right: 2px !important; }
        </style>
        <table class="ui compact table" id="driver-apl-table" style="width: 100%;"></table>
        {{#if (eq permissions.create true)}}
        <div class="ui large active modal" id="new-apl-modal">
            <div class="header">New Application</div>
            <div class="content">
                <p><span id="apl-url" style="display: inline-block;">{{applicationUrl}}</span> <sup><a href="" id="copy-apl-url"><i class="copy icon"></i></a></sup></p>
                <div class="ui grid two column relaxed divided" style="margin-top: 5px;">
                    <div class="five wide column">
                        <div class="ui form">
                            <div class="field">
                                <div class="ui labeled input">
                                    <div class="ui label">
                                        <i class="truck moving icon"></i>
                                    </div>
                                    <div class="ui fluid selection dropdown" id="new-apl-company-dropdown">
                                        <i class="dropdown icon"></i>
                                        <input type="hidden" name="carrierId" id="new-apl-company" />
                                        <div class="default text">Company</div>
                                        <div class="menu">
                                            <div class="item">Carolina Transportation, Inc</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui left icon corner labeled input">
                                    <input type="email" placeholder="Email" />
                                    <i class="envelope icon"></i>
                                    <div class="ui corner label">
                                        <i class="asterisk icon"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ui vertical divider"></div>
                    <div class="eleven wide column">
                        <h4 class="ui header">
                            Applicant Registration
                            <span class="ui grey text" style="font-weight: normal;">
                                <small>(Optional)</small>
                            </span>
                        </h4>
                    </div>
                </div>
            </div>
            <div class="actions">
                <div class="ui cancel button">Cancel</div>
                <div class="ui primary button">Invite</div>
            </div>
            <script>
                const modalId = '#new-apl-modal'
                const $aplUrl = $('#apl-url')

                $('#copy-apl-url').click(function(evt) {
                    evt.preventDefault()

                    navigator.clipboard.writeText($aplUrl.text())
                        .then(() => {
                            $(modalId).toast({
                                message: 'URL successfully copied!',
                                class: 'success',
                                showIcon: 'clipboard outline',
                                context: modalId,
                                position: 'top left',
                            })

                            $('.ui.toast-container').css({
                                top: '75px',
                                left: `${$aplUrl.outerWidth() + 50}px`
                            })
                        })
                })

                setTimeout(() => {
                    $('#new-apl-company-dropdown').dropdown()
                }, 100)
            </script>
        </div>
        {{/if}}
        <script type="module" src="/modules/drivers/applications.mjs"></script>

{{> carrier/nav.omega}}