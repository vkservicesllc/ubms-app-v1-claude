{{> carrier/nav.alpha}}

        <style>
            .dt-container { min-width: 1150px; }
            .custom-dt-toolbar { min-width: 67%; }
            .custom-dt-toolbar > * { width: 24.5%; }
            .ui.dropdown .transition i.icon { margin-right: 2px !important; }
            .help { margin-top: 5px; padding-left: 2px; }
        </style>
        <table class="ui compact table" id="driver-apl-table" style="width: 100%;"></table>
        {{#if (eq permissions.create true)}}
        <div class="ui large modal" id="new-apl-modal">
            <i class="close icon"></i>
            <div class="header">New Application</div>
            <div class="content">
                <p><a id="apl-url" href="{{applicationUrl}}" target="_blank">{{applicationUrl}}</a> <sup><a href="" id="copy-apl-url"><i class="copy icon"></i></a></sup></p>
                <form class="ui two column relaxed divided grid" id="new-apl-form" action="/resource/application/new" method="POST" autocomplete="off" style="margin-top: 5px;">
                    <div class="five wide column">
                        <div class="ui form">
                            <div class="field">
                                <div class="ui left labeled input">
                                    {{{input.email}}}
                                    <div class="ui corner label">
                                        <i class="asterisk icon"></i>
                                    </div>
                                </div>
                                <p class="help" id="email-help">
                                    <span class="ui grey text">Please enter valid email address</span>
                                </p>
                            </div>
                            <div class="ui icon message">
                                <i class="truck moving icon"></i>
                                <div class="content">
                                    <div class="header">Company</div>
                                    <p>If you know which company is hiring the applicant, please select it below</p>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui labeled input">
                                    <div class="ui fluid clearable selection dropdown" id="new-apl-company-dropdown">
                                        <input type="hidden" name="language" />
                                        <i class="dropdown icon"></i>
                                        <div class="default text">Hiring Company</div>
                                        <div class="menu"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ui vertical divider"></div>
                    <div class="eleven wide column">
                        <div class="ui toggle checkbox" style="margin-bottom: 20px;">
                            <input type="checkbox" id="register-new-apl" />
                            <label>Register New Applicant</label>
                        </div>
                        <div class="ui form">
                            <div class="disabled fields applicant-field" style="margin-top: 10px;">
                                <div class="five wide field">
                                    {{{label.firstName}}}
                                    {{{input.firstName}}}
                                </div>
                                <div class="four wide field">
                                    {{{label.middleName}}}
                                    {{{input.middleName}}}
                                </div>
                                <div class="five wide field">
                                    {{{label.lastName}}}
                                    {{{input.lastName}}}
                                </div>
                                <div class="two wide field">
                                    {{{label.suffix}}}
                                    <div class="ui fluid clearable selection dropdown" id="suffix-dropdown">
                                        {{{input.suffix}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.suffix}}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="disabled fields applicant-field">
                                <div class="four wide field">
                                    {{{label.dob}}}
                                    <div class="ui calendar" id="dob-calendar">
                                        <div class="ui fluid input left icon">
                                            {{{input.dob}}}
                                            <i class="calendar icon"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{label.ssn}}}
                                    {{{input.ssn}}}
                                </div>
                                <div class="four wide field">
                                    {{{label.phone}}}
                                    {{{input.phone}}}
                                </div>
                            </div>
                            <div class="disabled field applicant-field" style="margin-top: 30px;">
                                <div class="ui checkbox">
                                    <input type="checkbox" id="valid-dl-check" required />
                                    <label for="valid-dl-check">The Applicant has a valid US Driver License</label>
                                </div>
                            </div>
                            <div class="disabled field applicant-field">
                                <div class="ui checkbox">
                                    <input type="checkbox" id="legal-status-check" required />
                                    <label for="legal-status-check">The Applicant is authorized to work in the US</label>
                                </div>
                            </div>
                            <div class="inline disabled fields applicant-field">
                                <label>Legal Status</label>
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        <input type="radio" required />
                                        <label>US Citizen</label>
                                    </div>
                                </div>
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        <input type="radio" required />
                                        <label>Permanent Resident</label>
                                    </div>
                                </div>
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        <input type="radio" required />
                                        <label>Work Visa/Authorization</label>
                                    </div>
                                </div>
                            </div>
                            <div class="fields">
                                <div class="four wide disabled field">
                                    <label>Status Expires on *</label>
                                    <div class="ui calendar">
                                        <div class="ui fluid input left icon">
                                            <input type="text" required />
                                            <i class="calendar icon"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="actions">
                <button type="submit" form="new-apl-form" class="ui primary button" id="submit-new-apl">Invite</button>
            </div>
            <script type="module" src="/modules/drivers/application.new.mjs"></script>
        </div>
        {{/if}}
        <script type="module" src="/modules/drivers/applications.mjs"></script>

{{> carrier/nav.omega}}