{{> carrier/nav.alpha}}

        <style>
            .custom-dt-toolbar {min-width: 91.4rem; }
            .custom-dt-toolbar > .ui.input.short { width: 21%; }
            .custom-dt-toolbar > .ui.input.long { width: 25.5%; }
            .ui.dropdown .transition i.icon { margin-right: 0.14rem !important; }
            .help { margin-top: .3rem; padding-left: 0.14rem; }
            .toast-box { max-width: 17.85rem !important; }
            .ui.toast {  width: 17.85rem !important; }
            .apl-side-th {
                width: 7.14rem;
                font-weight: bold;
            }
            .apl-info-side-th {
                font-size: .92em;
                width: 6.4rem;
                font-weight: bold;
            }
            .apl-info2-side-th {
                font-size: .92em;
                width: 5.12rem;
                font-weight: bold;
            }
            .ui.label.experience-label {
                padding: .4em;
                margin-right: .4em;
            }
            .ui.label.experience-label span,
            .ui.label.experience-label i.icon {
                text-align: middle;
                margin: 0;
            }
        </style>
        <table class="ui compact table" id="driver-applications-table" style="width: 100%;"></table>
        {{#if (eq permissions.create true)}}
        {{> carrier/drivers/application.new}}
        {{/if}}
        <div class="ui modal" id="apl-info-card-modal">
            <div class="ui center aligned header" id="apl-info-card-header">
                <span class="ui grey text">Applicant's Info Card &nbsp;—&nbsp;</span>
                <span id="apl-info-card-fullname"></span>
            </div>
            <div class="content" style="padding-left: 2.4rem; padding-right: 2.4rem;">
                <div class="ui two column grid">
                    <div class="column">
                        <div class="ui raised segment" style="height: 27.12rem;">
                            <a class="ui basic grey ribbon label">Legal Name</a>
                            <table class="ui very basic compact table">
                                <tbody>
                                    <tr>
                                        <td class="apl-info-side-th"><span class="ui grey text">First Name:</span></td>
                                        <td class="apl-data" id="apl-info-card:firstName"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info-side-th"><span class="ui grey text">Middle Name:</span></td>
                                        <td class="apl-data" id="apl-info-card:middleName"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info-side-th"><span class="ui grey text">Last Name:</span></td>
                                        <td class="apl-data" id="apl-info-card:lastName"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info-side-th"><span class="ui grey text">Suffix:</span></td>
                                        <td class="apl-data" id="apl-info-card:suffix"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <a class="ui basic grey ribbon label">Identity</a>
                            <table class="ui very basic compact table">
                                <tbody>
                                    <tr>
                                        <td class="apl-info-side-th"><span class="ui grey text">Gender:</span></td>
                                        <td class="apl-data" id="apl-info-card:gender"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info-side-th"><span class="ui grey text">DOB:</span></td>
                                        <td class="apl-info-data" id="apl-info-card:dob"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info-side-th"><span class="ui grey text">SSN:</span></td>
                                        <td class="apl-data" id="apl-info-card:ssn"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="column">
                        <div class="ui raised segment" style="height: 27.12rem;">
                            <a class="ui basic grey right ribbon label">Contacts / Residence</a>
                            <table class="ui very basic compact table">
                                <tbody>
                                    <tr>
                                        <td class="apl-info2-side-th"><span class="ui grey text">Phone:</span></td>
                                        <td class="apl-data" id="apl-info-card:phone"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info2-side-th"><span class="ui grey text">Email:</span></td>
                                        <td class="apl-data" id="apl-info-card:email"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info2-side-th"><span class="ui grey text">Address:</span></td>
                                        <td class="apl-data" id="apl-info-card:address"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <a class="ui basic grey right ribbon label">Driver's License</a>
                            <table class="ui very basic compact table">
                                <tbody>
                                    <tr>
                                        <td class="apl-info2-side-th"><span class="ui grey text">Number:</span></td>
                                        <td class="apl-data" id="apl-info-card:dlNum"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info2-side-th"><span class="ui grey text">State:</span></td>
                                        <td class="apl-data" id="apl-info-card:dlState"></td>
                                    </tr>
                                    <tr>
                                        <td class="apl-info2-side-th"><span class="ui grey text">Expiration:</span></td>
                                        <td class="apl-data" id="apl-info-card:dlExp"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <script type="module" src="/modules/drivers/application.info-card.mjs"></script>
        </div>
        {{#if (eq permissions.modify true)}}
        <div class="ui small modal" id="apl-reinvite-card-modal">
            <div class="ui header">Reinvitation</div>
            <div class="content">
                <form id="reinvite-form" action="/resource/drivers/reinvite/applicant" method="POST"></form>
                <p>This action will reinvite <b id="reinvite-name"></b> at <b id="reinvite-email"></b></p>
            </div>
            <div class="actions">
                <div class="ui cancel button">Cancel</div>
                <button type="submit" form="reinvite-form" class="ui blue button" id="reinvite-submit">Reinvite</button>
            </div>
        </div>
        <div class="ui tiny modal" id="apl-lead-card-modal">
            <div class="ui header">Pre-Application</div>
            <div class="content">
                <form class="ui form" id="lead-form" action="/resource/drivers/update/applicant" method="POST" autocomplete="off">
                    {{{form.leadId.hidden.input}}}
                    <div class="fields">
                        <div class="eight wide field">
                            {{{form.leadFirstName.text.label}}}
                            {{{form.leadFirstName.text.input}}}
                        </div>
                        <div class="eight wide field">
                            {{{form.leadMiddleName.text.label}}}
                            {{{form.leadMiddleName.text.input}}}
                        </div>
                    </div>
                    <div class="fields">
                        <div class="eight wide field">
                            {{{form.leadLastName.text.label}}}
                            {{{form.leadLastName.text.input}}}
                        </div>
                        <div class="four wide field">
                            {{{form.leadSuffix.select.label}}}
                            <div class="ui fluid clearable selection dropdown" id="lead-suffix-dropdown">
                                {{{form.leadSuffix.hidden.input}}}
                                <i class="dropdown icon"></i>
                                <div class="default text"></div>
                                <div class="menu">{{{dropdown.suffix}}}
                                </div>
                            </div>
                        </div>
                        <div class="four wide field">
                            {{{form.leadGender.select.label}}}
                            <div class="ui fluid selection required dropdown" id="lead-gender-dropdown">
                                {{{form.leadGender.hidden.input}}}
                                <i class="dropdown icon"></i>
                                <div class="default text"></div>
                                <div class="menu">{{{dropdown.gender}}}</div>
                            </div>
                        </div>
                    </div>
                    <div class="fields">
                        <div class="five wide field">
                            {{{form.leadPhone.text.label}}}
                            {{{form.leadPhone.text.input}}}
                        </div>
                        <div class="eleven wide field">
                            {{{form.leadEmail.text.label}}}
                            {{{form.leadEmail.text.input}}}
                            <p class="help" id="lead-email-help"></p>
                        </div>
                    </div>
                    <div class="ui two column grid">
                        <div class="eleven wide column">
                            <div class="inline fields">
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        {{{form.leadPosition.radio.CD.input}}}
                                        {{{form.leadPosition.radio.CD.label}}}
                                    </div>
                                </div>
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        {{{form.leadPosition.radio.OO.input}}}
                                        {{{form.leadPosition.radio.OO.label}}}
                                    </div>
                                </div>
                            </div>
                            <div class="inline fields">
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        {{{form.leadPosition.radio.OD.input}}}
                                        {{{form.leadPosition.radio.OD.label}}}
                                    </div>
                                </div>
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        {{{form.leadPosition.radio.LP.input}}}
                                        {{{form.leadPosition.radio.LP.label}}}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="five wide right aligned column">
                            <div class="ui checkbox" style="display: none;">
                                <input type="checkbox" id="lead-redundant" />
                                <label for="lead-redundant">Redundant</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="actions">
                <button class="ui dark red left floated button" id="delete-lead-button" style="display: none;">Delete</button>
                <div class="ui cancel button">Cancel</div>
                <button type="submit" form="lead-form" class="ui dark green button" id="lead-submit">Save</button>
            </div>
            <script type="module" src="/modules/drivers/application.lead.mjs"></script>
        </div>
        <div class="ui tiny modal" id="apl-id-card-modal">
            <div class="ui header" id="apl-id-card-header">Applicant's Login Info</div>
            <div class="content">
                <table class="ui very basic compact table">
                    <tbody>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Applicant:</span></td>
                            <td>
                                <strong class="apl-data" id="apl-id-card:fullName" style="font-size: 1.1em;"></strong>
                            </td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Form ID:</span></td>
                            <td class="apl-data" id="apl-id-card:formId"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Form URL:</span></td>
                            <td>
                                <sup><a href="" class="copy-apl-cred"><i class="dark green copy outline icon"></i></a></sup>
                                <span class="apl-data" id="apl-id-card:url"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table class="ui very basic compact table">
                    <tbody>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Phone:</span></td>
                            <td>
                                <sup><a href="" class="copy-apl-cred"><i class="dark green copy outline icon"></i></a></sup>
                                <span class="apl-data" id="apl-id-card:phone"></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Date of Birth:</span></td>
                            <td>
                                <sup><a href="" class="copy-apl-cred"><i class="dark green copy outline icon"></i></a></sup>
                                <span class="apl-data" id="apl-id-card:dob"></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">PIN:</span></td>
                            <td>
                                <sup><a href="" class="copy-apl-cred"><i class="dark green copy outline icon"></i></a></sup>
                                <span class="apl-data" id="apl-id-card:pin"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div>
                    <button class="ui small teal button" id="copy-apl-login">Copy Credentials</button>
                    <span class="ui dark green text" id="apl-copy-sucess" style="margin-left: 1.07rem; display: none;">
                        <i class="check icon"></i>
                        Login info successfully copied
                    </span>
                </div>
            </div>
            <script type="module" src="/modules/drivers/application.id-card.mjs"></script>
        </div>
        {{/if}}
        {{#if (eq permissions.delete true)}}
        <div class="ui tiny modal" id="delete-apl-modal">
            <div class="ui dark red text header" id="delete-apl-header">Delete Application</div>
            <div class="content">
                <form id="delete-apl-form" action="/resource/drivers/delete/application" method="POST">
                    <input type="hidden" id="delete-apl-id" name="_id" />
                </form>
                <h5 class="ui dark red text header" style="margin: 0 0 .3rem;">Notice</h5>
                <p class="ui dark red text">The application has not yet been processed and<br/>may be subject to deletion if it becomes redundant</p>
                <table class="ui very basic compact table">
                    <tbody>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Form ID:</span></td>
                            <td class="apl-data" id="delete-apl:formId"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Applied on:</span></td>
                            <td class="apl-data" id="delete-apl:appliedOn"></td>
                        </tr>
                    </tbody>
                </table>
                <table class="ui very basic compact table">
                    <tbody>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Full Name:</span></td>
                            <td>
                                <strong class="apl-data" id="delete-apl:fullName" style="font-size: 1.1em;"></strong>
                            </td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Gender:</span></td>
                            <td class="apl-data" id="delete-apl:gender"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">DOB:</span></td>
                            <td class="apl-data" id="delete-apl:dob"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">SSN:</span></td>
                            <td class="apl-data" id="delete-apl:ssn"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Phone:</span></td>
                            <td class="apl-data" id="delete-apl:phone"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Email:</span></td>
                            <td class="apl-data" id="delete-apl:email"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Residence:</span></td>
                            <td class="apl-data" id="delete-apl:residence"></td>
                        </tr>
                    </tbody>
                </table>
                <table class="ui very basic compact table">
                    <tbody>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Carrier:</span></td>
                            <td class="apl-data" id="delete-apl:carrier"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Position:</span></td>
                            <td class="apl-data" id="delete-apl:position"></td>
                        </tr>
                        <tr>
                            <td class="apl-side-th"><span class="ui grey text">Assigned to:</span></td>
                            <td class="apl-data" id="delete-apl:user"></td>
                        </tr>
                    </tbody>
                </table>
                <div class="ui checkbox">
                    <input type="checkbox" id="delete-apl-confirm" />
                    <label><i class="red text exclamation triangle icon"></i> I confirm that the application has become redundant</label>
                </div>
            </div>
            <div class="actions">
                <div class="ui cancel button">Cancel</div>
                <button type="submit" form="delete-apl-form" class="ui disabled red button" id="delete-apl-submit">Delete Application</button>
            </div>
            <script type="module" src="/modules/drivers/application.delete.mjs"></script>
        </div>
        {{/if}}
        <script type="module" src="/modules/drivers/applications.mjs"></script>

{{> carrier/nav.omega}}