        <script>
            const $menu = $('#section-menu.ui.menu .item'), $tabs = $('#sections .ui.tab')
            let href = location.href, query
            [ href, query ] = href.split('?')

            if (query) {
                $menu.removeClass('active')
                $tabs.removeClass('active')

                $(`#section-menu.ui.menu .item[data-tab="${query}"]`).addClass('active')
                $(`#sections .ui.tab[data-tab="${query}"]`).addClass('active')

                history.replaceState({}, '', href)
            }

            $menu.tab({ transition: 'none' })
        </script>

