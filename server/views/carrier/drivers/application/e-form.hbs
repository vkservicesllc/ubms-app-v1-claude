{{> carrier/nav.alpha}}

    <style>
        .ui.header:not(.first) {
            margin-top: 10px !important;
        }
        .ui.message {
            width: 640px !important;
        }
        .file-actions {
            margin-left: 5px;
        }
        .list .item {
            margin-bottom: 5px;
        }

        /* Lock border behavior for active vertical tabs ??? */
        .ui.vertical.tabular.menu .item.active {
            border-right: none !important;
            margin-right: -1px !important; /* fixes any small gap */
            box-shadow: none !important;   /* prevent any shadow making it look like a border */
        }
    </style>

    <div style="margin-left: 20px;">
        <div class="ui relaxed horizontal list" style="margin-bottom: 15px; min-width: 1440px;">
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Applicant:</span></h5>
                    {{{applicant}}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Desired Position:</span></h5>
                    {{position}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Position Role:</span></h5>
                    {{positionRole}}
                </div>
            </div>
            {{#if (hv carrier)}}
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Carrier:</span></h5>
                    {{{carrier}}}
                </div>
            </div>
            {{/if}}
            {{#if (hv recruiter)}}
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Recruiter:</span></h5>
                    {{{recruiter}}}
                </div>
            </div>
            {{/if}}
            <div class="item" style="border-left: 1px solid rgba(34,36,38,0.15); padding-left: 1.8rem;">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Form:</span></h5>
                    <strong>{{formId}}</strong>
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Created at:</span></h5>
                    {{{appliedAt}}} ET
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Submitted at:</span></h5>
                    {{{finishedAt}}} ET
                </div>
            </div>
        </div>

        <div class="ui grid" style="width: 1080px;">
            <div class="three wide column" style="margin-right: 0; padding-right: 0;">
                <div class="ui vertical fluid tabular menu" id="section-menu">
                    <a class="item" data-tab="workflow">Workflow</a>
                    {{#if (eq fileTab true)}}
                    <a class="item" data-tab="files">Files</a>
                    {{/if}}
                    <a class="item" data-tab="profile">{{idx (idx steps 0) 0}}</a>
                    <a class="item" data-tab="legal-status">{{idx (idx steps 0) 2}}</a>
                    <a class="item" data-tab="position">{{idx (idx steps 0) 3}}</a>
                    <a class="disabled item" data-tab="residence">{{idx (idx steps 0) 1}}</a>
                    <a class="item" data-tab="driver-license">{{idx steps 1}}</a>
                    <a class="item" data-tab="medical-card">{{idx steps 2}}</a>
                    <a class="disabled item" data-tab="legal-compliance">{{idx steps 3}}</a>
                    <a class="disabled item" data-tab="safety">{{idx steps 4}}</a>
                    <a class="active item" data-tab="experience">{{idx steps 5}}</a>
                    <a class="disabled item" data-tab="prev-employment">{{idx steps 6}}</a>
                    <a class="item" data-tab="preference">{{idx steps 7}}</a>
                    <a class="item" data-tab="business">{{idx steps 8}}</a>
                    <a class="item" data-tab="beneficiary">{{idx steps 9}}</a>
                    <a class="item" data-tab="misc">{{idx steps 10}}</a>
                </div>
            </div>
            <div class="thirteen wide stretched column" style="margin-left: 0; padding-left: 0;">
                <div class="ui seamless right attached segment" id="sections" style="padding: 20px;">
                    <input type="hidden" id="id" value="{{_id}}" />

                    <div class="ui tab" data-tab="workflow">
                        <form class="ui loading form" id="assign-form" action="{{actionUrl.workflow}}" method="POST" autocomplete="off">
                            <h5 class="ui blue text first header">Checklist</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="four wide field">
                                    <div class="ui list">
                                        <div class="item">
                                            <i class="ui {{checkList.application}} icon"></i>
                                            <div class="content">
                                                Application Form
                                            </div>
                                        </div>
                                        <div class="item">
                                            <i class="ui {{checkList.legalDox}} icon"></i>
                                            <div class="content">
                                                Legal Document
                                            </div>
                                        </div>
                                        <div class="item">
                                            <i class="ui {{checkList.ssc}} icon"></i>
                                            <div class="content">
                                                Social Security Card
                                            </div>
                                        </div>
                                        <div class="item">
                                            <i class="ui {{checkList.dl}} icon"></i>
                                            <div class="content">
                                                Driver's License
                                            </div>
                                        </div>
                                        <div class="item">
                                            <i class="ui {{checkList.mec}} icon"></i>
                                            <div class="content">
                                                Medical Card
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    <div class="ui list">
                                        <div class="item">
                                            <i class="ui {{checkList.prevEmployers}} icon"></i>
                                            <div class="content">
                                                Previous Employments
                                            </div>
                                        </div>
                                        <div class="item">
                                            <span class="ui red text">... more items to be added</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <h5 class="ui blue text first header">Assignment</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="six wide field">
                                    {{{form.user.select.label}}}
                                    <div class="ui fluid selection dropdown" id="user-dropdown">
                                        {{{form.user.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.user}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="six wide field">
                                    {{{form.carrier.select.label}}}
                                    <div class="ui fluid selection dropdown" id="carrier-dropdown">
                                        {{{form.carrier.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.carrier}}}
                                        </div>
                                    </div>
                                </div>
                                {{#if (eq unscoped true)}}
                                <div class="four wide field">
                                    Team Selector
                                </div>
                                {{/if}}
                            </div>
                            <h5 class="ui blue text header">Decision</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="four wide field">
                                    {{{form.condition.select.label}}}
                                    <div class="ui fluid selection dropdown" id="condition-dropdown">
                                        {{{form.condition.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text">New Application</div>
                                        <div class="menu">{{{dropdown.condition}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{form.experience.select.label}}}
                                    <div class="ui fluid selection dropdown" id="experience-dropdown">
                                        {{{form.experience.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.experience}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{form.apprPosition.select.label}}}
                                    <div class="ui fluid selection dropdown" id="approved-position-dropdown">
                                        {{{form.apprPosition.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.apprPosition}}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ui divider"></div>
                            <div class="actions">
                                <button type="submit" class="ui right floated circular blue button">Save</button>
                            </div>
                        </form>
                        {{#if (eq complete true)}}
                        <form action="{{actionUrl.contract}}" method="POST">
                            <button type="submit" class="ui circular green button">Hire</button>  
                        </form>
                        {{/if}}
                    </div>

                    {{#if (eq fileTab true)}}
                    <div class="ui tab" data-tab="files">
                        <div class="ui list">
                            <div class="item">
                                <i class="dark orange folder icon"></i>
                                <div class="content">
                                    <div class="header">DQ Files</div>
                                    <div class="list">
                                        {{#if (eq filePerms.application true)}}
                                        <div class="item">
                                            <i class="pdf file outline icon"></i>
                                            <div class="content">
                                                <div class="header">
                                                    <a onclick="window.open('{{addrBook.carrier}}/drivers/application/{{formId}}/files/application', '_blank'); return false;">
                                                        <span class="ui dark blue text">Application</span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        {{/if}}
                                        <div class="item">
                                            <i class="dark orange folder icon"></i>
                                            <div class="content">
                                                <div class="header">Personal Documents</div>
                                                <div class="content">
                                                    <div class="list">
                                                        <div class="item">
                                                            <i class="grey file icon"></i>
                                                            <div class="content">
                                                                <div class="header">
                                                                    <a><span class="ui grey text">{{legalStatusDocDesc}}</span></a>
                                                                    {{!-- <span class="file-actions">
                                                                        <a class="ui dark blue text"><i class="upload icon"></i></a>
                                                                    </span> --}}
                                                                </div>
                                                                {{!-- <div class="description">
                                                                    <small>{{legalStatusDocDesc}}</small>
                                                                </div> --}}
                                                            </div>
                                                        </div>
                                                        <div class="item">
                                                            <i class="grey file icon"></i>
                                                            <div class="content">
                                                                <div class="header">
                                                                    <a><span class="ui grey text">Social Security Card</span></a>
                                                                    {{!-- <span class="file-actions">
                                                                        <a class="ui dark blue text"><i class="upload icon"></i></a>
                                                                    </span> --}}
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="item">
                                                            <i class="pdf file outline icon"></i>
                                                            <div class="content">
                                                                <div class="header">
                                                                    <a><span class="ui dark blue text">Driver's License</span></a>
                                                                    {{!-- <span class="file-actions">
                                                                        <a class="ui dark green text"><i class="download icon"></i></a>
                                                                        <a class="ui dark red text"><i class="delete icon"></i></a>
                                                                    </span> --}}
                                                                </div>
                                                                <div class="description">
                                                                    <small>Front and back</small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="item">
                                                            <i class="grey file icon"></i>
                                                            <div class="content">
                                                                <div class="header">
                                                                    <a><span class="ui grey text">Medical Card</span></a>
                                                                    {{!-- <span class="file-actions">
                                                                        <a class="ui dark blue text"><i class="upload icon"></i></a>
                                                                    </span> --}}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="item">
                                            <i class="dark orange folder icon"></i>
                                            <div class="content">
                                                <div class="header">Pre-Employments</div>
                                                <div class="content">
                                                    <div class="list">
                                                        <div class="item">
                                                            <a class="ui dark green text"><i class="upload icon"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/if}}

                    <div class="ui tab" data-tab="profile">
                        <form class="ui loading form" id="profile-form" action="{{actionUrl.profile}}" method="POST" autocomplete="off">
                            <h5 class="ui blue text first header">Legal Name</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="five wide field">
                                    {{{form.firstName.text.label}}}
                                    {{{form.firstName.text.input}}}
                                </div>
                                <div class="four wide field">
                                    {{{form.middleName.text.label}}}
                                    {{{form.middleName.text.input}}}
                                </div>
                                <div class="five wide field">
                                    {{{form.lastName.text.label}}}
                                    {{{form.lastName.text.input}}}
                                </div>
                                <div class="two wide field">
                                    {{{form.suffix.select.label}}}
                                    <div class="ui fluid clearable selection dropdown" id="suffix-dropdown">
                                        {{{form.suffix.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.suffix}}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{#if (eq nameMismatch true)}}
                            <div id="identity-name-mismatch">
                                <div class="ui inverted nag" style="margin: 5px 0 10px;">
                                    <div class="title">
                                        <i class="ui dark orange text id badge outline icon"></i>
                                        The system has identified that the provided SSN is associated with a different name!
                                    </div>
                                </div>
                                <div class="ui checkbox">
                                    <input type="checkbox" name="nameMismatch" />
                                    <label>
                                        I confirm that the applicant's driver's license reflects a legal name change<br/>
                                        from <i><span class="ui dark red text">{{originalFullName}}</span></i> to <b><span class="ui dark green text">{{fullName}}</span></b><br/>
                                        <small>
                                            <span class="ui dark red text">
                                                <i class="exclamation circle icon"></i>
                                                If confirmed, the SSN will be linked to the new name;
                                                otherwise, revise the application to match the existing record
                                            </span>
                                        </small>
                                    </label>
                                </div>
                            </div>
                            {{/if}}
                            <h5 class="ui blue text header">Personal Information</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="four wide field">
                                    {{{form.dob.text.label}}}
                                    <div class="ui calendar" id="dob-calendar">
                                        <div class="ui fluid input left icon">
                                            {{{form.dob.text.input}}}
                                            <i class="calendar icon"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{form.gender.select.label}}}
                                    <div class="ui fluid selection required dropdown" id="gender-dropdown">
                                        {{{form.gender.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.gender}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{form.ssn.text.label}}}
                                    {{{form.ssn.text.input}}}
                                </div>
                                <div class="four wide field">
                                    {{{form.marital.select.label}}}
                                    <div class="ui fluid selection required dropdown" id="marital-dropdown">
                                        {{{form.marital.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.marital}}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <h5 class="ui blue text header">Contacts</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="four wide field">
                                    {{{form.phone.text.label}}}
                                    {{{form.phone.text.input}}}
                                </div>
                                <div class="seven wide field">
                                    {{{form.email.text.label}}}
                                    {{{form.email.text.input}}}
                                    <p class="help">
                                        <span class="ui red text"><small id="email-help"></small></span>
                                    </p>
                                </div>
                            </div>
                            <div class="ui divider"></div>
                            <div class="actions">
                                <button type="submit" class="ui right floated circular blue button">Save</button>
                            </div>
                        </form>
                    </div>

                    <div class="ui tab" data-tab="legal-status">
                        <form class="ui loading form" id="status-form" action="{{actionUrl.status}}" method="POST" autocomplete="off">
                            <h5 class="ui blue text first header">Legal Presence</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="five wide field">
                                    {{{form.status.radio.label}}}
                                    <div class="ui fluid selection required dropdown" id="legal-status-dropdown">
                                        {{{form.status.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.status}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field" id="legal-status-expiration-field" style="display: none;">
                                    {{{form.statusExp.text.label}}}
                                    <div class="ui calendar" id="status-exp-calendar">
                                        <div class="ui fluid input left icon">
                                            {{{form.statusExp.text.input}}}
                                            <i class="calendar icon"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ui divider"></div>
                            <div class="actions">
                                <button type="submit" class="ui right floated circular blue button">Save</button>
                            </div>
                        </form>
                    </div>

                    <div class="ui tab" data-tab="position">
                        <form class="ui loading form" id="position-form" action="{{actionUrl.position}}" method="POST" autocomplete="off">
                            <h5 class="ui blue text first header">Desired Position</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="five wide field">
                                    <div class="ui fluid selection required dropdown" id="position-dropdown">
                                        {{{form.position.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.position}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="one wide field"></div>
                            </div>
                            <div id="vehicle-section" style="display: none;">
                                <h5 class="ui blue text header">Motor Vehicle</h5>
                                {{#if (eq cdlRole 1)}}
                                <div class="ui compact grid" style="margin-top: 5px;">
                                    <div class="four wide field">
                                        {{{form.currentVhlType.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="vehicle-type-dropdown">
                                            {{{form.currentVhlType.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.vehicleType}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="one wide field"></div>
                                </div>
                                {{/if}}
                                {{#if (eq cdlRole 0)}}
                                <div class="ui compact grid" style="margin-top: 5px;">
                                    <div class="five wide field">
                                        {{{form.currentVhlMMT.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="vehicle-mmt-dropdown">
                                            {{{form.currentVhlMMT.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.vehicleMMT}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="three wide field">
                                        {{{form.currentVhlYear.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="vehicle-year-dropdown">
                                            {{{form.currentVhlYear.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.vehicleYear}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="ui compact grid" style="margin-top: 5px;">
                                    <div class="four wide field">
                                        {{{form.currentVhlType.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="vehicle-type-dropdown">
                                            {{{form.currentVhlType.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.vehicleType}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="four wide field">
                                        {{{form.currentVhlMake.text.label}}}
                                        {{{form.currentVhlMake.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.currentVhlModel.text.label}}}
                                        {{{form.currentVhlModel.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.currentVhlLen.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="vehicle-length-dropdown">
                                            {{{form.currentVhlLen.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.vehicleLength}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{/if}}
                            </div>
                            <div class="ui divider"></div>
                            <div class="actions">
                                <button type="submit" class="ui right floated circular blue button">Save</button>
                            </div>
                        </form>
                    </div>

                    <div class="ui tab" data-tab="residence">
                        ADDRESS FORMS
                    </div>

                    <div class="ui tab" data-tab="driver-license">
                        <form class="ui loading form" id="dl-form" action="{{actionUrl.dl}}" method="POST" autocomplete="off">
                            <h5 class="ui blue text first header">Driver's License</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="four wide field">
                                    <div class="ui checkbox">
                                        {{{form.dlCommercial2.checkbox.input}}}
                                        {{{form.dlCommercial2.checkbox.label}}}
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{form.dlState.select.label}}}
                                    <div class="ui fluid selection required dropdown" id="dl-state-dropdown">
                                        {{{form.dlState.hidden.input}}}
                                        <i class="dropdown icon"></i>
                                        <div class="default text"></div>
                                        <div class="menu">{{{dropdown.dlState}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{form.dlNumber.text.label}}}
                                    {{{form.dlNumber.text.input}}}
                                </div>
                                <div class="two wide field">
                                    {{{form.dlClass.text.label}}}
                                    {{{form.dlClass.text.input}}}
                                </div>
                            </div>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="four wide field">
                                    {{{form.dlIss.text.label}}}
                                    <div class="ui calendar" id="dl-issued-calendar">
                                        <div class="ui fluid input left icon">
                                            {{{form.dlIss.text.input}}}
                                            <i class="calendar icon"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field">
                                    {{{form.dlExp.text.label}}}
                                    <div class="ui calendar" id="dl-expires-calendar">
                                        <div class="ui fluid input left icon">
                                            {{{form.dlExp.text.input}}}
                                            <i class="calendar icon"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="four wide field" style="display: none;">
                                    {{{form.dlEndrs.text.label}}}
                                    {{{form.dlEndrs.text.input}}}
                                </div>
                                <div class="four wide field">
                                    {{{form.dlRestr.text.label}}}
                                    {{{form.dlRestr.text.input}}}
                                </div>
                                <div class="one wide field"></div>
                            </div>
                            <h5 class="ui blue text header">Adverse Actions</h5>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="seven wide field">
                                    <div class="ui checkbox">
                                        {{{form.dlDenied2.checkbox.input}}}
                                        {{{form.dlDenied2.checkbox.label}}}
                                    </div>
                                </div>
                                <div class="nine wide field" style="display: none;">
                                    {{{form.dlDeniedExpl.text.label}}}
                                    {{{form.dlDeniedExpl.text.input}}}
                                </div>
                                <div class="one wide field"></div>
                            </div>
                            <div class="ui compact grid" style="margin-top: 5px;">
                                <div class="seven wide field">
