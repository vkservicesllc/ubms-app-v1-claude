{{> carrier/nav.alpha}}

    <style>
        .header:not(.first) {
            margin-top: 10px !important;
        }
        .ui.message {
            width: 640px !important;
        }
    </style>

    {{!-- <div class="ui grid" style="padding: 10px;">

        <div class="nine wide column" style="min-width: 960px; max-width: 1080px;"> --}}
        <div style="margin-left: 10px;">
            <div class="ui relaxed horizontal list" style="margin-bottom: 15px; min-width: 1440px;">
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Applicant:</h5>
                        {{{applicant}}}
                    </div>
                </div>
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Position:</h5>
                        {{position}}
                    </div>
                </div>
                {{#if (hv carrier)}}
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Carrier:</h5>
                        {{{carrier}}}
                    </div>
                </div>
                {{/if}}
                {{#if (hv recruiter)}}
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Recruiter:</h5>
                        {{{recruiter}}}
                    </div>
                </div>
                {{/if}}
                <div class="item" style="border-left: 1px solid rgba(34,36,38,0.15); padding-left: 1.8rem;">
                    <div class="content">
                    <h5 class="ui header">Form:</h5>
                        {{formId}}
                    </div>
                </div>
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Created at:</h5>
                        {{{appliedAt}}} ET
                    </div>
                </div>
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Submitted at:</h5>
                        {{{finishedAt}}} ET
                    </div>
                </div>
            </div>

            <div class="ui grid" style="width: 1080px;">
                <div class="three wide left attached column">
                    <div class="ui vertical fluid tabular menu">
                        <a class="item active" data-tab="profile">{{idx (idx steps 0) 0}}</a>
                        <a class="item" data-tab="residence">{{idx (idx steps 0) 1}}</a>
                        <a class="item" data-tab="legal-status">{{idx (idx steps 0) 2}}</a>
                        <a class="item" data-tab="dl">{{idx steps 1}}</a>
                        <a class="item" data-tab="mec">{{idx steps 2}}</a>
                        <a class="item" data-tab="legal">{{idx steps 3}}</a>
                        <a class="item" data-tab="safety">{{idx steps 4}}</a>
                        <a class="item" data-tab="experience">{{idx steps 5}}</a>
                        <a class="item" data-tab="employers">{{idx steps 6}}</a>
                        <a class="item" data-tab="preference">{{idx steps 7}}</a>
                        <a class="item" data-tab="business">{{idx steps 8}}</a>
                        <a class="item" data-tab="beneficiary">{{idx steps 9}}</a>
                        <a class="item" data-tab="misc">{{idx steps 10}}</a>
                    </div>
                </div>
                <div class="thirteen wide stretched right attached column">
                    <div class="ui seamless right attached segment" style="padding: 20px;">
                        <input type="hidden" id="id" value="{{_id}}" />
                        <div class="ui active tab" data-tab="profile">
                            <form class="ui loading form" id="profile-form" action="{{actionUrl.profile}}" method="POST">
                                <h5 class="ui blue text first header">Legal Name</h5>
                                <div class="ui compact grid">
                                    <div class="five wide field">
                                        {{{form.firstName.text.label}}}
                                        {{{form.firstName.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.middleName.text.label}}}
                                        {{{form.middleName.text.input}}}
                                    </div>
                                    <div class="five wide field">
                                        {{{form.lastName.text.label}}}
                                        {{{form.lastName.text.input}}}
                                    </div>
                                    <div class="two wide field">
                                        {{{form.suffix.select.label}}}
                                        <div class="ui fluid clearable selection dropdown" id="suffix-dropdown">
                                            {{{form.suffix.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.suffix}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <h5 class="ui blue text header">Personal Information</h5>
                                <div class="ui compact grid">
                                    <div class="four wide field">
                                        {{{form.dob.text.label}}}
                                        <div class="ui calendar" id="dob-calendar">
                                            <div class="ui fluid input left icon">
                                                {{{form.dob.text.input}}}
                                                <i class="calendar icon"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="four wide field">
                                        {{{form.gender.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="gender-dropdown">
                                            {{{form.gender.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.gender}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="four wide disabled field">
                                        {{{form.ssn.text.label}}}
                                        {{{form.ssn.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.marital.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="marital-dropdown">
                                            {{{form.marital.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.marital}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <h5 class="ui blue text header">Contacts</h5>
                                <div class="ui compact grid">
                                    <div class="four wide field">
                                        {{{form.phone.text.label}}}
                                        {{{form.phone.text.input}}}
                                    </div>
                                    <div class="seven wide field">
                                        {{{form.email.text.label}}}
                                        {{{form.email.text.input}}}
                                        <p class="help">
                                            <span class="ui red text"><small id="email-help"></small></span>
                                        </p>
                                    </div>
                                </div>
                                <div class="ui divider"></div>
                                <div class="actions">
                                    <button type="submit" class="ui right floated circular blue button">Save Changes</button>
                                </div>
                            </form>
                        </div>
                        <div class="ui tab" data-tab="residence">
                            ADDRESS FORMS
                        </div>
                        <div class="ui tab" data-tab="legal-status">
                            LEGAL STATUS
                        </div>
                        <div class="ui tab" data-tab="dl">
                            DRIVER'S LICENSE FORM
                        </div>
                        <div class="ui tab" data-tab="mec">
                            MEDICAL CARD FORM
                        </div>
                        <div class="ui tab" data-tab="legal">
                            LEGAL COMPLIANCE FORMS
                        </div>
                        <div class="ui tab" data-tab="safety">
                            SAFETY FORMS
                        </div>
                        <div class="ui tab" data-tab="experience">
                            EXPERIENCE FORM
                        </div>
                        <div class="ui tab" data-tab="employers">
                            PRE-EMPLOYMENT FORMS
                        </div>
                        <div class="ui tab" data-tab="preference">
                            PREFERENCE FORM
                        </div>
                        <div class="ui tab" data-tab="business">
                            BUSINESS FORM
                        </div>
                        <div class="ui tab" data-tab="beneficiary">
                            <form class="ui loading form" id="beneficiary-form" action="{{actionUrl.beneficiary}}" method="POST">
                                <h5 class="ui blue text first header">Beneficiary</h5>
                                <div class="ui compact grid" style="margin-top: 20px;">
                                    <div class="five wide field">
                                        {{{form.benefFirstName.text.label}}}
                                        {{{form.benefFirstName.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.benefMiddleName.text.label}}}
                                        {{{form.benefMiddleName.text.input}}}
                                    </div>
                                    <div class="five wide field">
                                        {{{form.benefLastName.text.label}}}
                                        {{{form.benefLastName.text.input}}}
                                    </div>
                                    <div class="two wide field">
                                        {{{form.benefSuffix.select.label}}}
                                        <div class="ui fluid clearable selection dropdown" id="beneficiary-suffix-dropdown">
                                            {{{form.benefSuffix.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.suffix}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="ui compact grid" style="margin-top: 10px;">
                                    <div class="four wide field">
                                        {{{form.benefRelation.select.label}}}
                                        <div class="ui fluid selection required dropdown" id="beneficiary-relationship-dropdown">
                                            {{{form.benefRelation.hidden.input}}}
                                            <i class="dropdown icon"></i>
                                            <div class="default text"></div>
                                            <div class="menu">{{{dropdown.relationship}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="four wide hidden field" id="beneficiary-other-relationship-field" style="display: none;">
                                        {{{form.benefOtherRel.text.label}}}
                                        {{{form.benefOtherRel.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.benefPhone.text.label}}}
                                        {{{form.benefPhone.text.input}}}
                                    </div>
                                    <div class="four wide field">
                                        {{{form.benefSsn.text.label}}}
                                        {{{form.benefSsn.text.input}}}
                                    </div>
                                </div>
                                <div class="ui divider"></div>
                                <div class="actions">
                                    <button type="submit" class="ui right floated circular blue button">Save Changes</button>
                                </div>
                            </form>
                        </div>
                        <div class="ui tab" data-tab="misc">
                            MISC FORM
                        </div>
                        <script type="module" src="/modules/drivers/application/beneficiary.mjs"></script>
                        <script type="module" src="/modules/drivers/application/profile.mjs"></script>
                    </div>
                </div>
            </div>
            <script>$('.menu .item').tab()</script>

        </div>

        {{!-- </div>

        <div class="seven wide column" style="min-width: 540px;">
            <div class="ui relaxed list">
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Applicant:</h5>
                        {{{applicant}}}
                    </div>
                </div>
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Position:</h5>
                        {{position}}
                    </div>
                </div>
                {{#if (hv carrier)}}
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Carrier:</h5>
                        {{{carrier}}}
                    </div>
                </div>
                {{/if}}
                {{#if (hv recruiter)}}
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Recruiter:</h5>
                        {{{recruiter}}}
                    </div>
                </div>
                {{/if}}
            </div>
            <div class="ui divider"></div>
            <div class="ui relaxed horizontal list">
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Form:</h5>
                        {{formId}}
                    </div>
                </div>
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Created at:</h5>
                        {{{appliedAt}}} ET
                    </div>
                </div>
                <div class="item">
                    <div class="content">
                    <h5 class="ui header">Submitted at:</h5>
                        {{{finishedAt}}} ET
                    </div>
                </div>
            </div>
        </div> --}}

    </div>

{{> carrier/nav.omega}}