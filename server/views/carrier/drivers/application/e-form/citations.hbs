{{> carrier/nav.alpha}}

    <div style="margin-left: 20px;">
        <div class="ui relaxed horizontal list" style="margin-bottom: 15px; min-width: 1440px;">
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Applicant:</span></h5>
                    {{{applicant}}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Desired Position:</span></h5>
                    {{position}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Position Role:</span></h5>
                    {{positionRole}}
                </div>
            </div>
            {{#if (hv carrier)}}
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Carrier:</span></h5>
                    {{{carrier}}}
                </div>
            </div>
            {{/if}}
            {{#if (hv recruiter)}}
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Recruiter:</span></h5>
                    {{{recruiter}}}
                </div>
            </div>
            {{/if}}
            <div class="item" style="border-left: 1px solid rgba(34,36,38,0.15); padding-left: 1.8rem;">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Form:</span></h5>
                    <strong>{{formId}}</strong>
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Created at:</span></h5>
                    {{{appliedAt}}} ET
                </div>
            </div>
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Submitted at:</span></h5>
                    {{{finishedAt}}} ET
                </div>
            </div>
        </div>
        <div class="ui breadcrumb">
            {{{backLink}}}
            <i class="right chevron icon divider"></i>
            <div class="active section">Citations</div>
        </p>

        <div style="width: 1080px; margin-top: 20px;">
            <input type="hidden" id="id" value="{{_id}}" />
<style>
    td {
        overflow: visible !important;
    }
</style>
            <table class="ui compact fixed table">
                <thead>
                    <tr>
                        <th>Violation</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>State</th>
                        <th class="right aligned">
                            <button class="ui tiny blue icon button" id="add">
                                <i class="plus icon"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="ui fluid selection required dropdown">
                                {{{form._citReason.hidden.input}}}
                                <i class="dropdown icon"></i>
                                <div class="default text"></div>
                                <div class="menu">{{{dropdown.violation}}}
                                </div>
                            </div>
                        </td>
                        <td></td>
                        <td>
                            <div class="ui calendar">
                                <div class="ui fluid input left icon">
                                    {{{form._citDate.text.input}}}
                                    <i class="calendar icon"></i>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="ui fluid selection required dropdown cit-state">
                                {{{form._citState.hidden.input}}}
                                <i class="dropdown icon"></i>
                                <div class="default text"></div>
                                <div class="menu">{{{dropdown.state}}}
                                </div>
                            </div>
                        </td>
                        <td class="right aligned">
                            <button class="ui tiny blue icon button">
                                <i class="save icon"></i>
                            </button>
                            <button class="ui tiny red icon button">
                                <i class="ban icon"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="ui fluid selection required dropdown">
                                {{{form._citReason.hidden.input}}}
                                <i class="dropdown icon"></i>
                                <div class="default text"></div>
                                <div class="menu">{{{dropdown.violation}}}
                                </div>
                            </div>
                        </td>
                        <td></td>
                        <td>
                            <div class="ui calendar">
                                <div class="ui fluid input left icon">
                                    {{{form._citDate.text.input}}}
                                    <i class="calendar icon"></i>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="ui fluid selection required dropdown cit-state">
                                {{{form._citState.hidden.input}}}
                                <i class="dropdown icon"></i>
                                <div class="default text"></div>
                                <div class="menu">{{{dropdown.state}}}
                                </div>
                            </div>
                        </td>
                        <td class="right aligned">
                            <button class="ui tiny green icon button">
                                <i class="save icon"></i>
                            </button>
                            <button class="ui tiny red icon button">
                                <i class="trash icon"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

