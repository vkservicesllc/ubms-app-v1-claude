{{> carrier/nav.alpha}}

    <div style="margin-left: 20px;">
        <div class="ui relaxed horizontal list" style="display: block; margin-bottom: 15px; min-width: 1440px;">
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Applicant:</span></h5>
                    {{{applicant}}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Desired Position:</span></h5>
                    {{position}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Position Role:</span></h5>
                    {{positionRole}}
                </div>
            </div>
            {{#if (hv carrier)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Carrier:</span></h5>
                    {{{carrier}}}
                </div>
            </div>
            {{/if}}
            {{#if (hv recruiter)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Recruiter:</span></h5>
                    {{{recruiter}}}
                </div>
            </div>
            {{/if}}
            <div class="item" style="border-left: 1px solid rgba(34,36,38,0.15); padding-left: 1.8rem;">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Form:</span></h5>
                    <strong>{{formId}}</strong>
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Created at:</span></h5>
                    {{{appliedAt}}} ET
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Submitted at:</span></h5>
                    {{{finishedAt}}} ET
                </div>
            </div>
        </div>
        <div class="ui breadcrumb">
            {{{backLink}}}
            <i class="right chevron icon divider"></i>
            <div class="active section">Citations</div>
        </div>
    </div>

    <div style="margin-left: 20px;">
        <div style="width: 1260px; margin-top: 20px;">
            <input type="hidden" id="id" value="{{_id}}" />
            <style>td { overflow: visible !important; }</style>
            <table class="ui compact grey table" style="display: none;">
                <thead>
                    <tr>
                        <th style="width: 280px;">Violation</th>
                        <th style="width: 280px;">Description</th>
                        <th style="width: 200px;">Date</th>
                        <th style="width: 240px;">State</th>
                        <th class="right aligned">
                            <button class="ui tiny blue icon button" id="add" title="Add">
                                <i class="plus icon"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="new-form" style="display: none;">
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown cit-violation">
                                    {{{form._citReason.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.violation}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field other-field">
                                {{{form._citOtherReason.text.input}}}
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui calendar cit-date">
                                    <div class="ui fluid input left icon">
                                        {{{form._citDate.text.input}}}
                                        <i class="calendar icon"></i>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown cit-state">
                                    {{{form._citState.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.state}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="right aligned">
                            <span class="ui red text" style="margin-right: 15px;">NEW</span>
                            <button class="ui tiny blue icon button" title="Create">
                                <i class="save icon"></i>
                            </button>
                            <button class="ui tiny icon button" id="cancel" title="Cancel">
                                <i class="ban icon"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tbody id="form-template" style="display: none;">
                    <tr>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown cit-violation">
                                    {{{form._citReason.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.violation}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field other-field">
                                {{{form._citOtherReason.text.input}}}
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui calendar cit-date">
                                    <div class="ui fluid input left icon">
                                        {{{form._citDate.text.input}}}
                                        <i class="calendar icon"></i>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown cit-state">
                                    {{{form._citState.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.state}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="right aligned">
                            <button class="ui tiny green icon save button" title="Save">
                                <i class="save icon"></i>
                            </button>
                            <button class="ui tiny red icon delete button" title="Delete">
                                <i class="trash icon"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="ui tiny modal" id="delete-modal">
        <div class="ui dark red text header" id="delete-header">Delete Citation</div>
        <div class="content">
            <form id="delete-form" action="" method="POST">
                <input type="hidden" id="delete-id" name="_id" />
            </form>
            <p><span class="ui dark red text">Please confirm the deletion of the following citation!</span></p>
            <div id="delete-info"></div>
        </div>
        <div class="actions">
            <div class="ui cancel button">Cancel</div>
            <button type="submit" form="delete-form" class="ui red button" id="delete-submit">Delete</button>
        </div>
    </div>
    <script type="module" src="/modules/drivers/application/citations.mjs"></script>

{{> carrier/nav.omega}}