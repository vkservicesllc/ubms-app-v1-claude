{{> carrier/nav.alpha}}

    <div style="margin-left: 1.43rem;">
        <div class="ui breadcrumb" style="margin-bottom: .71rem;">
            {{{backLink}}}
            <div class="divider"> / </div>
            <div class="active section">Accidents</div>
        </div>
        <div class="ui relaxed horizontal list" style="display: block; margin-bottom: 1.07rem; min-width: 102.85rem;">
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Applicant:</span></h5>
                    {{{applicant}}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Desired Position:</span></h5>
                    {{position}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Position Role:</span></h5>
                    {{positionRole}}
                </div>
            </div>
            {{#if (hv carrier)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Carrier:</span></h5>
                    {{{carrier}}}
                </div>
            </div>
            {{/if}}
            {{#if (hv recruiter)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Recruiter:</span></h5>
                    {{{recruiter}}}
                </div>
            </div>
            {{/if}}
            <div class="item" style="border-left: 1px solid rgba(34,36,38,0.15); padding-left: 1.8rem;">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Form:</span></h5>
                    <strong>{{formId}}</strong>
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Created at:</span></h5>
                    {{{appliedAt}}} ET
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Submitted at:</span></h5>
                    {{{finishedAt}}} ET
                </div>
            </div>
        </div>
    </div>

    <div style="margin-left: 1.43rem;">
        <div style="width: 102.85rem; margin-top: 1.43rem;">
            <input type="hidden" id="id" value="{{_id}}" />
            <style>td { overflow: visible !important; }</style>
            <table class="ui compact grey table" style="display: none;">
                <thead style="font-size: 1rem">
                    <tr>
                        <th style="width: 20rem;">Collision Type</th>
                        <th style="width: 20rem;">Description</th>
                        <th style="width: 14.28rem;">Date</th>
                        <th style="width: 17.14rem;">State</th>
                        <th class="center aligned" style="width: 10rem;">Injuries</th>
                        <th class="center aligned" style="width: 5.71rem;">Fatalities</th>
                        <th class="right aligned">
                            <button class="ui tiny blue icon button" id="add" title="Add">
                                <i class="plus icon"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="new-form" style="display: none;">
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown acc-type">
                                    {{{form._accType.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.accident}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field other-field">
                                {{{form._accOtherType.text.input}}}
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui calendar acc-date">
                                    <div class="ui fluid input left icon">
                                        {{{form._accDate.text.input}}}
                                        <i class="calendar icon"></i>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown acc-state">
                                    {{{form._accState.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.state}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui center aligned form">
                            <div class="ui checkbox">
                                {{{form._accInjuries2.checkbox.input}}}<label></label>
                            </div>
                        </td>
                        <td class="ui center aligned form">
                            <div class="ui checkbox">
                                {{{form._accFatalities2.checkbox.input}}}<label></label>
                            </div>
                        </td>
                        <td class="right aligned">
                            <span class="ui red text" style="margin-right: .71rem;">NEW</span>
                            <button class="ui tiny blue icon button" id="create" data-id="new" title="Create">
                                <i class="save icon"></i>
                            </button>
                            <button class="ui tiny icon button" id="cancel" title="Cancel">
                                <i class="ban icon"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tbody id="form-template" style="display: none;">
                    <tr>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown acc-type">
                                    {{{form._accType.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.accident}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field other-field">
                                {{{form._accOtherType.text.input}}}
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui calendar acc-date">
                                    <div class="ui fluid input left icon">
                                        {{{form._accDate.text.input}}}
                                        <i class="calendar icon"></i>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui form">
                            <div class="field">
                                <div class="ui fluid selection required dropdown acc-state">
                                    {{{form._accState.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.state}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ui center aligned form">
                            <div class="ui checkbox">
                                {{{form._accInjuries2.checkbox.input}}}<label></label>
                            </div>
                        </td>
                        <td class="ui center aligned form">
                            <div class="ui checkbox">
                                {{{form._accFatalities2.checkbox.input}}}<label></label>
                            </div>
                        </td>
                        <td class="right aligned">
                            <span class="ui text unsaved-changes" style="margin-right: .71rem;"></span>
                            <button class="ui tiny dark green icon save button" title="Save" disabled>
                                <i class="save icon"></i>
                            </button>
                            <button class="ui tiny red icon delete button" title="Delete">
                                <i class="trash icon"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="ui tiny modal" id="delete-modal">
        <div class="ui dark red text header" id="delete-header">Delete Accident</div>
        <div class="content">
            <form id="delete-form">
                <input type="hidden" id="delete-id" name="_id" />
            </form>
            <p><span class="ui dark red text">Please confirm the deletion of the following accident:</span></p>
            <div id="delete-info"></div>
        </div>
        <div class="actions">
            <div class="ui cancel button">Cancel</div>
            <button type="submit" form="delete-form" class="ui red button" id="delete-submit">Delete</button>
        </div>
    </div>
    <script type="module" src="/modules/drivers/application/accidents.mjs"></script>

{{> carrier/nav.omega}}