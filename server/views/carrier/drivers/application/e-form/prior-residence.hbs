{{> carrier/nav.alpha}}

    <div style="margin-left: 20px;">
        <div class="ui breadcrumb" style="margin-bottom: 10px;">
            {{{backLink}}}
            <div class="divider"> / </div>
            <div class="active section">Prior Residence</div>
        </div>
        <div class="ui relaxed horizontal list" style="display: block; margin-bottom: 15px; min-width: 1440px;">
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Applicant:</span></h5>
                    {{{applicant}}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Desired Position:</span></h5>
                    {{position}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Position Role:</span></h5>
                    {{positionRole}}
                </div>
            </div>
            {{#if (hv carrier)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Carrier:</span></h5>
                    {{{carrier}}}
                </div>
            </div>
            {{/if}}
            {{#if (hv recruiter)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Recruiter:</span></h5>
                    {{{recruiter}}}
                </div>
            </div>
            {{/if}}
            <div class="item" style="border-left: 1px solid rgba(34,36,38,0.15); padding-left: 1.8rem;">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Form:</span></h5>
                    <strong>{{formId}}</strong>
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Created at:</span></h5>
                    {{{appliedAt}}} ET
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Submitted at:</span></h5>
                    {{{finishedAt}}} ET
                </div>
            </div>
        </div>
    </div>

    <style>
        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .unsaved-changes {
            margin-right: 10px;
        }
    </style>

    <div style="margin-left: 20px;">
        <p style="margin-top: 25px;"><span class="ui red text">UNFINISHED... Work in progress...</span></p>
        <form class="ui form" style="width: 1680px; margin-top: 20px;">
            <input type="hidden" id="id" value="{{_id}}" />
            <style>td { overflow: visible !important; }</style>
            <table class="ui compact grey table" style="display: none;">
                <thead>
                    <tr>
                        <th style="width: 280px;">Street Address</th>
                        <th style="width: 180px;">Apt/Unit</th>
                        <th style="width: 200px;">Zip</th>
                        <th style="width: 280px;">City</th>
                        <th style="width: 240px;">State</th>
                        <th style="width: 200px;">Lived since</th>
                        <th style="width: 140px;"></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="address-form"></tbody>
                <tbody id="form-template" style="display: none;">
                    <tr>
                        <td>
                            <div class="field">
                                {{{form._address1.text.input}}}
                            </div>
                        </td>
                        <td>
                            <div class="field">
                                {{{form._address2.text.input}}}
                            </div>
                        </td>
                        <td>
                            <div class="field">
                                {{{form._addrZip.text.input}}}
                            </div>
                        </td>
                        <td>
                            <div class="field">
                                {{{form._addrCity.text.input}}}
                            </div>
                        </td>
                        <td>
                            <div class="field">
                                <div class="ui fluid selection required dropdown addr-state-dropdown">
                                    {{{form._addrState.hidden.input}}}
                                    <i class="dropdown icon"></i>
                                    <div class="default text"></div>
                                    <div class="menu">{{{dropdown.state}}}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="field">
                                <div class="ui calendar addr-date-calendar">
                                    <div class="ui fluid input left icon">
                                        {{{form._addrSince.text.input}}}
                                        <i class="calendar icon"></i>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="ui checkbox lived-abroad" style="width: 240px; display: none;">
                                {{{form._livedAbroad2.checkbox.input}}}
                                {{{form._livedAbroad2.checkbox.label}}}
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="footer" style="display: none;">
                <div class="three wide field" style="display: none;">
                    {{{form.country.select.label}}}
                    <div class="ui fluid selection disabled required dropdown" id="addr-country-dropdown">
                        {{{form.country.hidden.input}}}
                        <i class="dropdown icon"></i>
                        <div class="default text"></div>
                        <div class="menu">{{{dropdown.country}}}
                        </div>
                    </div>
                </div>
                <div id="actions" style="margin-left: auto;">
                    <span class="unsaved-changes" style="display: none;"><i class="red exclamation triangle icon"></i></span>
                    <button type="submit" class="ui circular dark green button" disabled>Save</button>
                </div>
            </div>
        </form>
    </div>
    <script type="module" src="/modules/drivers/application/prior-residence.mjs"></script>

{{> carrier/nav.omega}}