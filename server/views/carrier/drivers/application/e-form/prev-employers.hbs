{{> carrier/nav.alpha}}

    <div style="margin-left: 20px;">
        <div class="ui breadcrumb" style="margin-bottom: 10px;">
            {{{backLink}}}
            <div class="divider"> / </div>
            <div class="active section">Employers</div>
        </div>
        <div class="ui relaxed horizontal list" style="display: block; margin-bottom: 15px; min-width: 1440px;">
            <div class="item">
                <div class="content">
                <h5 class="ui header"><span class="ui grey text">Applicant:</span></h5>
                    {{{applicant}}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Desired Position:</span></h5>
                    {{position}}
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Position Role:</span></h5>
                    {{positionRole}}
                </div>
            </div>
            {{#if (hv carrier)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Carrier:</span></h5>
                    {{{carrier}}}
                </div>
            </div>
            {{/if}}
            {{#if (hv recruiter)}}
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Recruiter:</span></h5>
                    {{{recruiter}}}
                </div>
            </div>
            {{/if}}
            <div class="item" style="border-left: 1px solid rgba(34,36,38,0.15); padding-left: 1.8rem;">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Form:</span></h5>
                    <strong>{{formId}}</strong>
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Created at:</span></h5>
                    {{{appliedAt}}} ET
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <h5 class="ui header"><span class="ui grey text">Submitted at:</span></h5>
                    {{{finishedAt}}} ET
                </div>
            </div>
        </div>
    </div>

    <style>
        .ui.compact.grid {
            margin-top: 5px !important;
        }
        #employer-list {
            display: none;
        }
    </style>
    <div style="margin-left: 20px;">
        <div style="width: 1680px; margin-top: 20px;">
            <input type="hidden" id="id" value="{{_id}}" />
            <button class="ui blue icon button" id="add" style="margin-bottom: 20px;">
                <i class="plus icon"></i> Add Employer
            </button>
            <div class="ui grid" id="employer-list">
            </div>
        </div>
    </div>
    <div class="ui modal" id="add-modal" style="width: 735px;">
        <div class="header"><small>New</small> Previous Employer</div>
        <div class="content">
            <form class="ui form" id="new-employer-form" action="" method="POST">
                {{{form._emplId.hidden.input}}}
                <div class="ui compact grid">
                    <div class="eight wide field">
                        {{{form._prevEmployer.text.label}}}
                        {{{form._prevEmployer.text.input}}}
                    </div>
                    <div class="four wide field">
                        {{{form._emplStartDate.text.label}}}
                        <div class="ui calendar empl-start-calendar">
                            <div class="ui fluid input left icon">
                                {{{form._emplStartDate.text.input}}}
                                <i class="calendar icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="four wide field">
                        {{{form._emplEndDate.text.label}}}
                        <div class="ui calendar empl-end-calendar">
                            <div class="ui fluid input left icon">
                                {{{form._emplEndDate.text.input}}}
                                <i class="calendar icon"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="ui compact grid">
                    <div class="five wide field">
                        {{{form._emplPhone.text.label}}}
                        {{{form._emplPhone.text.input}}}
                    </div>
                    <div class="seven wide field">
                        {{{form._emplAddr1.text.label}}}
                        {{{form._emplAddr1.text.input}}}
                    </div>
                    <div class="four wide field">
                        {{{form._emplAddr2.text.label}}}
                        {{{form._emplAddr2.text.input}}}
                    </div>
                </div>
                <div class="ui compact grid">
                    <div class="four wide field">
                        {{{form._emplAddrZip.text.label}}}
                        {{{form._emplAddrZip.text.input}}}
                    </div>
                    <div class="seven wide field">
                        {{{form._emplAddrCity.text.label}}}
                        {{{form._emplAddrCity.text.input}}}
                    </div>
                    <div class="five wide field">
                        <div class="field">
                            {{{form._emplAddrState.select.label}}}
                            <div class="ui fluid selection required dropdown empl-addr-state-dropdown">
                                {{{form._emplAddrState.hidden.input}}}
                                <i class="dropdown icon"></i>
                                <div class="default text"></div>
                                <div class="menu">{{{dropdown.addrState}}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="ui compact grid">
                    <div class="five wide field">
                        {{{form._emplPosition.text.label}}}
                        {{{form._emplPosition.text.input}}}
                    </div>
                    <div class="five wide field">
                        {{{form._emplEarnings.text.label}}}
                        <div class="ui left icon input">
                            <i class="dollar icon"></i>
                            {{{form._emplEarnings.text.input}}}
                        </div>
                    </div>
                    <div class="six wide field">
                        {{{form._emplRFL.text.label}}}
                        {{{form._emplRFL.text.input}}}
                    </div>
                </div>
                <div class="ui grouped fields">
                    {{#if (eq cdl true)}}
                    <div class="field">
                        <div class="ui checkbox">
                            {{{form._emplFMCSR2.checkbox.input}}}
                            {{{form._emplFMCSR2.checkbox.label}}}
                        </div>
                    </div>
                    {{/if}}
                    <div class="field">
                        <div class="ui checkbox">
                            {{{form._emplDotDat2.checkbox.input}}}
                            {{{form._emplDotDat2.checkbox.label}}}
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="actions">
            <button class="ui left floated cancel button">Cancel</button>
            <button type="submit" form="new-employer-form" class="ui blue button">Add</button>
        </div>
    </div>
    <div class="ui tiny modal" id="delete-modal">
        <div class="header"><small>Delete</small> Previous Employer</div>
        <div class="content">
            <form id="delete-employer-form" action="" method="POST">
                <input type="hidden" id="delete-id" name="_id" />
                <div id="delete-content"></div>
            </form>
        </div>
        <div class="actions">
            <button class="ui cancel button">Cancel</button>
            <button type="submit" form="delete-employer-form" class="ui red button">Delete</button>
        </div>
    </div>
    <script type="module" src="/modules/drivers/application/prev-employers.mjs"></script>

{{> carrier/nav.omega}}