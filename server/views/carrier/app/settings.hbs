{{> carrier/nav.alpha}}

        <h4>Settings</h4>
        <div class="ui animated fade tiny button" tabindex="0" id="reset-settings">
            <div class="visible content"><i class="redo alternate icon"></i></div>
            <div class="hidden content">
                Reset
            </div>
        </div>
        <div class="ui eight column divided grid raised segment">
            <div class="row">
                <div class="column">
                    <div class="ui form">
                        <div class="grouped fields">
                            <label>On logon, go to:</label>
                            <div class="field">
                                <div class="ui radio checkbox">
                                    <input type="radio" id="login-to-dash" name="lastUrl" value="0" />
                                    <label for="login-to-dash">Dashboard</label>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui radio checkbox">
                                    <input type="radio" id="login-to-last" name="lastUrl" value="1" />
                                    <label for="login-to-last">Last visited page</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="column">
                    <div class="ui form">
                        <div class="grouped fields">
                            <label>Team selection location:</label>
                            <div class="field">
                                <div class="ui radio checkbox">
                                    <input type="radio" id="team-on-start" name="teamSelect" value="0" />
                                    <label for="team-on-start">Welcome Page</label>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui radio checkbox">
                                    <input type="radio" id="team-in-nav" name="teamSelect" value="1" />
                                    <label for="team-in-nav">Navigation Bar</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="column">
                    <div class="ui form">
                        <div class="grouped fields">
                            <label>Show companies in tables:</label>
                            <div class="field">
                                <div class="ui checkbox">
                                    <input type="checkbox" id="excluded-team-companies" name="teamCompanies[]" value="e" />
                                    <label for="excluded-team-companies">Excluded</label>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui checkbox">
                                    <input type="checkbox" id="inactive-team-companies" name="teamCompanies[]" value="i" />
                                    <label for="inactive-team-companies">On hold</label>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui checkbox">
                                    <input type="checkbox" id="closed-team-companies" name="teamCompanies[]" value="c" />
                                    <label for="closed-team-companies">Closed</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<style>
    .segment {
        {{!-- outline: 1px dotted blue; --}}
    }
    .grid .column {
        min-width: 200px;
        {{!-- outline: 1px dotted red; --}}
    }
    .grouped.fields > label {
        display: block;
        margin-bottom: 10px !important;
    }
</style>

{{> carrier/nav.omega}}