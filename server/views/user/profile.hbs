{{> head}}

<style>
    @media (max-width: 767px) {
        .ui.form .inline.fields > label {
            margin-bottom: 10px;
        }
    }
</style>
<script type="module" defer></script>

    <div style="{{{style.page}}}">
        {{> user/nav}}
        <div class="ui segment">
            <h4 class="ui dividing header">{{user.expansion.status}} in {{user.expansion.location}}</h4>
            <img class="ui small circular image" id="avatar" src="{{{user.avaSrc}}}" alt="Avatar" />
            <form class="ui form" id="user-profile-form" action="/profile" method="POST" autocomplete="off">
                <div class="field">
                    <label class="input-required">Name</label>
                    <div class="three fields">
                        <div class="field">
                            {{{input.firstName}}}
                        </div>
                        <div class="field">
                            {{{input.alias}}}
                        </div>
                        <div class="field">
                            {{{input.lastName}}}
                        </div>
                    </div>
                </div>
                <div class="inline fields">
                    <label>Gender</label>
                    <div class="field">
                        <div class="ui radio checkbox">
                            {{{input.genderMale}}}
                            <label>Male</label>
                        </div>
                    </div>
                    <div class="field">
                        <div class="ui radio checkbox">
                            {{{input.genderFemale}}}
                            <label>Female</label>
                        </div>
                    </div>
                </div>
                <div class="ui error message">
                    <div class="header">Error</div>
                    <ul id="error-message-list"></ul>
                </div>
                <button type="submit" class="ui teal button">Update</button>
            </form>
            <h4 class="ui dividing header">Employee in {{user.expansion.location}}</h4>
            <p><span class="ui red text">Unassigned</span></p>
        </div>
    </div>

{{> foot}}