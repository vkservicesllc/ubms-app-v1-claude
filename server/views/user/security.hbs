{{> head}}

    <div style="{{{style.page}}}">
        {{> user/nav}}
        <div class="ui segment">
            <h4 class="ui dividing header">{{user.name}}</h4>
            <form class="ui form" id="user-security-form" action="/security" method="POST" autocomplete="off">
                <div class="two fields">
                    <div class="field">
                        {{{label.password}}}
                        {{{input.password}}}
                    </div>
                </div>
                <div class="two fields">
                    <div class="field">
                        {{{label.createPassword}}}
                        {{{input.createPassword}}}
                    </div>
                    <div class="field">
                        {{{label.confirmPassword}}}
                        {{{input.confirmPassword}}}
                    </div>
                </div>
                <button type="submit" class="ui teal button">Update</button>
            </form>
        </div>
    </div>

{{> foot}}