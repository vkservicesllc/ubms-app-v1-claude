{{> head}}

    <div style="{{{style.page}}}">
        {{> user/nav}}
        <div class="ui segment">
            <h4 class="ui dividing header">{{user.name}}</h4>
            <form class="ui form" id="user-security-form" method="POST" autocomplete="off">
                <input type="hidden" id="password-validation" />
                <input type="hidden" id="conf-password-validation" />
                <div class="two fields">
                    <div class="field">
                        {{{label.password}}}
                        {{{input.password}}}
                    </div>
                </div>
                <div class="two fields">
                    <div class="field">
                        {{{label.createPassword}}}
                        <div class="ui corder labeled input">
                            {{{input.createPassword}}}
                            <div class="ui corner label">
                                <i class="ui eye slash icon" id="eye-icon"></i>
                            </div>
                        </div>
                        <p class="help" id="password-help" style="display: none;"><span class="ui text"></span></p>
                    </div>
                    <div class="field">
                        {{{label.confirmPassword}}}
                        {{{input.confirmPassword}}}
                        <p class="help" id="conf-password-help" style="display: none;"><span class="ui text"></span></p>
                    </div>
                </div>
                <div class="ui error message" id="password-error-tip">
                    <div class="header">
                        Password must:
                    </div>
                    <div class="list">
                        <li>be at least {{length.password.min}} characters long</li>
                        <li>have at least one small letter</li>
                        <li>have at least one capital letter</li>
                        <li>have at least one number</li>
                        <li>have at least one special characters</li>
                        <li>NOT have whitespaces</li>
                    </div>
                </div>
                <button type="submit" class="ui teal button" disabled>Change Password</button>
            </form>
        </div>
        <div class="ui error message" id="password-form-error-tip" style="display: none;">
            <p><i class="times icon"></i> Failed to update the password!</p>
            <div class="list"></div>
        </div>
        <div class="ui success message" id="password-form-success-tip" style="display: none;">
            <p><i class="check icon"></i> Password updated successfully!</p>
        </div>
    </div>
    <script type="module" src="/modules/security.mjs"></script>

{{> foot}}