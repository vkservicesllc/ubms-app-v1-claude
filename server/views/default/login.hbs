{{> head}}

    <div class="row" style="width: 640px; margin-top: 5%;">
        <a href="{{{apps.carrier.address}}}" target="_blank">
            <div class="col s12 m6">
                <div class="card blue darken-2">
                    <div class="card-content white-text">
                        <span class="card-title">{{apps.carrier.name}}</span>
                        <span class="grey-text text-lighten-1">Click to proceed</span>
                    </div>
                </div>
            </div>
        </a>
        <a>
            <div class="col s12 m6">
                <div class="card blue-grey darken-1">
                    <div class="card-content grey-text">
                        <span class="card-title">{{apps.driver.name}}</span>
                        Work in progress...
                    </div>
                </div>
            </div>
        </a>
    </div>

{{> foot}}