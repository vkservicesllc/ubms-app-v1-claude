    <style>
        .card {
            width: 540px;
            max-width: 100%;
            margin: 10px;
        }
        .card-title {
            font-weight: 600;
            font-size: 1.18em;
        }
        .card-footer {
            font-size: .87em;
        }
        #carrier-name {
            font-weight: 500;
        }
        #intro {
            font-size: .92em;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center min-vh-100">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title text-secondary">Professional Driver Application</h5>
                <div class="card-text" id="card-intro" style="display: none;">
                    {{#if (ne carrier false)}}
                    <div class="border-top border-bottom py-2">
                        <span id="carrier-name">{{carrier.name}}</span><br/>
                        {{{carrier.address}}}<br/>
                        {{carrier.phone}}
                    </div>
                    {{/if}}
                    <div class="text-start text-success py-2" id="intro">
                        <p>
                            We're looking for experienced and reliable drivers to join our carrier team.
                            If you meet the qualifications and are committed to safety, efficiency,
                            and top-tier service, we'd love to have you on board.
                        </p>
                        Before you begin the application, please ensure you have:
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item text-success">A valid driver’s license</li>
                            <li class="list-group-item text-success">A clean driving record</li>
                            <li class="list-group-item text-success">Required permits and credentials</li>
                            <li class="list-group-item text-success">The ability to meet DOT and company safety requirements</li>
                        </ul>
                    </div>
                    <button class="btn btn-primary" id="apply">APPLY NOW</button>
                </div>
                <div class="card-text px-2" id="card-form">
                    <form action="" method="POST">
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.firstName}}}
                                {{{input.firstName}}}
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.middleName}}}
                                {{{input.middleName}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.lastName}}}
                                {{{input.lastName}}}
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.suffix}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.dob}}}
                                {{{input.dob}}}
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.ssn}}}
                                {{{input.ssn}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.phone}}}
                                {{{input.phone}}}
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.email}}}
                                {{{input.email}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.position}}}
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-footer text-black-50">
                {{{copyright}}}
            </div>
        </div>
    </div>

    <script>
        $('#apply').click(() => {
            const time = 1000
            const $intro = $('#card-intro')
            const $form = $('#card-form')
            const introHeight = $intro.height(),
                  formHeight = $form.css('display', 'block').height()
            const height = Math.max(introHeight, formHeight)

            $form.css('display', 'none').height(height)
            $intro.height(height).fadeOut(time)
            setTimeout(() => {
                $form.fadeIn(time)
            }, time)
        })
    </script>

{{> foot}}