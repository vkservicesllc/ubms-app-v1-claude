{{> head}}

    <style>
        {{!-- body .card, body .accordion-item {
            background: transparent;
        } --}}
        .apl-label {
            display: inline-block;
            width: 75px;
            font-size: .8em;
        }
        .accordion-button-state {
            display: inline-block;
            margin-right: 10px;
        }
        .form-text {
            font-size: .8em;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center full-height-fix">
        <div class="card text-center" id="apl-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-info">Professional Driver Application</h5>
                <div class="card-text py-2" id="form-card">
                    <div>
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Form ID:</small> {{formId}}</p>
                        {{#if (hv agency)}}
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Agency:</small> {{{agency}}}</p>
                        {{/if}}
                        {{#if (hv carrier)}}
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Carrier:</small> {{{carrier}}}</p>
                        {{/if}}
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Applicant:</small> {{applicantName}}</p>
                        {{!-- <p class="text-start my-0 px-1"><small class="text-muted apl-label">SSN:</small> {{maskedSsn}}</p> --}}
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Position:</small> {{applicantPosition}}</p>
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Started at:</small> {{startedAt}}</p>
                        <div class="progress mt-2">
                            <div class="progress-bar bg-{{progressBg}}" style="width: {{progress}}%;">{{progress}}%</div>
                        </div>
                    </div>
                    {{#if (eq progress 100)}}
                    <div class="mt-3">
                        <a href="{{href.summary}}" id="summary-link">Back to Summary</a>
                    </div>
                    <script>
                        $('#summary-link').click(function(evt) {
                            evt.preventDefault()

                            const href = $(this).attr('href')
                            const duration = 750
                            const $card = $('#apl-card')
                            $card.fadeOut(duration)
                            setTimeout(() => {
                                location.href = href
                            }, duration)
                        })
                    </script>
                    {{/if}}

                    <div class="accordion mt-3" id="apl-accordion">
                        {{{form.appliedOn.hidden.input}}}

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-0.0">
                                    <i class="fa fa-check accordion-button-state"></i>
                                    <strong>{{idx (idx steps 0) 0}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-0.0" class="text-start accordion-collapse collapse" data-bs-parent="#apl-accordion">
                                <div class="accordion-body pt-1">
                                    <form id="profile-form" action="{{actionUrl.profile}}" method="POST" autocomplete="off">
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6">
                                                {{{form.firstName.text.label}}}
                                                {{{form.firstName.text.input}}}
                                            </div>
                                            <div class="col-md-6">
                                                {{{form.middleName.text.label}}}
                                                {{{form.middleName.text.input}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6">
                                                {{{form.lastName.text.label}}}
                                                {{{form.lastName.text.input}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{form.suffix.select.label}}}
                                                {{{form.suffix.select.input}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-4">
                                                {{{form.dob.text.label}}}
                                                {{{form.dob.text.input}}}
                                                <div class="form-text text-danger" id="profile-dob-help"></div>
                                            </div>
                                            <div class="col-md-4">
                                                {{{form.gender.select.label}}}
                                                {{{form.gender.select.input}}}
                                            </div>
                                            <div class="col-md-4">
                                                {{{form.marital.select.label}}}
                                                {{{form.marital.select.input}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5">
                                                {{{form.phone.text.label}}}
                                                {{{form.phone.text.input}}}
                                            </div>
                                            <div class="col-md-7">
                                                {{{form.email.text.label}}}
                                                {{{form.email.text.input}}}
                                                <div class="form-text text-danger" id="profile-email-help"></div>
                                            </div>
                                        </div>
                                        <p class="form-text text-danger mt-4" id="profile-form-help" style="display: none;"></p>
                                        <div class="row g-3 my-2">
                                            <div class="col-md-4">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-success bg-success-subtle" id="profile-submit">Save Changes</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    <script type="module" src="/modules/application/profile.mjs"></script>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button{{accordion.zero.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-0.1">
                                    <i class="{{accordion.zero.state}} accordion-button-state"></i>
                                    <strong>{{idx (idx steps 0) 1}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-0.1" class="text-start accordion-collapse collapse{{accordion.zero.body}}" data-bs-parent="#apl-accordion">
                                <div class="accordion-body pt-1">
                                    <form id="address-form" action="{{actionUrl.address}}" method="POST" autocomplete="off">
                                        {{{form.addrEnough.hidden.input}}}
                                        {{{form.addrCurrentSince.hidden.input}}}
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6 autocomplete">
                                                {{{form.address1.text.label}}}
                                                {{{form.address1.text.input}}}
                                                <ul class="autocomplete-list address-predictions"></ul>
                                            </div>
                                            <div class="col-md-3">
                                                {{{form.address2.text.label}}}
                                                {{{form.address2.text.input}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{form.addrZip.text.label}}}
                                                {{{form.addrZip.text.input}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5">
                                                {{{form.addrCity.text.label}}}
                                                {{{form.addrCity.text.input}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{form.addrState.select.label}}}
                                                {{{form.addrState.select.input}}}
                                            </div>
                                            <div class="col-md-4">
                                                {{{form.addrSince.text.label}}}
                                                {{{form.addrSince.text.input}}}
                                                <div class="form-text text-danger" id="addr-since-help"></div>
                                            </div>
                                        </div>
                                        <div class="border-top mt-4 pt-3" id="prior-residence"{{{scrollPoint.priorAddr}}}{{{priorResidenceDisplay}}}>
                                            <label class="form-label text-secondary">Prior Residence</label>
                                            <p class="mb-0" style="font-size: .84em;">
                                                As your current residence began less than 3 years ago,
                                                we require your prior address(es) to complete your U.S. address history.
                                            </p>
                                            <div class="row g-3 my-1">
                                                <label class="form-label">
                                                    Within the past 3 years, were you living outside the United States before your current address?
                                                </label>
                                                <div class="col-md-12 mt-0">
                                                    <div class="form-check form-check-inline">
                                                        {{{form.livedAbroad.radio.yes.input}}}
                                                        {{{form.livedAbroad.radio.yes.label}}}
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        {{{form.livedAbroad.radio.no.input}}}
                                                        {{{form.livedAbroad.radio.no.label}}}
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="addresses" style="display: none;">
                                                <label class="form-label fw-normal text-warning mt-3 mb-0">
                                                    <small>
                                                        <i class="fas fa-triangle-exclamation"></i>
                                                        Start with the most recent address prior to your current one
                                                    </small>
                                                </label>
                                                <div class="pb-4" id="address-list"></div>
                                            </div>
                                            <div class="row g-3 my-1" id="country"{{{countryDisplay}}}>
                                                <div class="col-md-8">
                                                    {{{form.country.select.label}}}
                                                    {{{form.country.select.input}}}
                                                </div>
                                            </div>
                                        </div>
                                        <p class="form-text text-danger mt-4" id="address-form-help" style="display: none;"></p>
                                        <div class="row g-3 my-2">
                                            <div class="col-md-4">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-{{button.zero.class}}" id="address-submit">{{button.zero.text}}</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    <div class="address-form" id="address-form-template" style="display: none;">
                                        <div class="border-top mt-4">
                                            {{{form._addrEnough.hidden.input}}}
                                            {{{form._addrCurrentSince.hidden.input}}}
                                            <div class="row g-3 my-1">
                                                <div class="col-md-6 autocomplete">
                                                    {{{form._address1.text.label}}}
                                                    {{{form._address1.text.input}}}
                                                    <ul class="autocomplete-list address-predictions"></ul>
                                                </div>
                                                <div class="col-md-3">
                                                    {{{form._address2.text.label}}}
                                                    {{{form._address2.text.input}}}
                                                </div>
                                                <div class="col-md-3">
                                                    {{{form._addrZip.text.label}}}
                                                    {{{form._addrZip.text.input}}}
                                                </div>
                                            </div>
                                            <div class="row g-3 my-1">
                                                <div class="col-md-5">
                                                    {{{form._addrCity.text.label}}}
                                                    {{{form._addrCity.text.input}}}
                                                </div>
                                                <div class="col-md-3">
                                                    {{{form._addrState.select.label}}}
                                                    {{{form._addrState.select.input}}}
                                                </div>
                                                <div class="col-md-4">
                                                    {{{form._addrSince.text.label}}}
                                                    {{{form._addrSince.text.input}}}
                                                    <div class="form-text text-danger"></div>
                                                </div>
                                            </div>
                                            <div class="row g-3 my-1 lived-abroad-container" style="display: none;">
                                                <label class="form-label">
                                                    Were you living outside the United States before this address?
                                                </label>
                                                <div class="col-md-12 mt-0">
                                                    <div class="form-check form-check-inline">
                                                        {{{form._livedAbroad.radio.yes.input}}}
                                                        {{{form._livedAbroad.radio.yes.label}}}
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        {{{form._livedAbroad.radio.no.input}}}
                                                        {{{form._livedAbroad.radio.no.label}}}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <script type="module" src="/modules/application/addresses.mjs"></script>
                                    <script type="module" src="/modules/application/address.mjs"></script>
                                </div>
                            </div>
                        </div>

                        {{#if (gte step 1)}}
                        {{> driver/application/driver_license}}

                        {{/if}}
                        {{#if (gte step 2)}}
                        {{> driver/application/medical_card}}

                        {{/if}}
                        {{#if (gte step 3)}}
                        {{> driver/application/legal_compliance}}

                        {{/if}}
                        {{#if (gte step 4)}}
                        {{> driver/application/safety}}

                        {{/if}}
                        {{#if (gte step 5)}}
                        {{> driver/application/experience}}

                        {{/if}}
                        {{#if (gte step 6)}}
                        {{> driver/application/prev_employment}}

                        {{/if}}
                        {{#if (gte step 7)}}
                        {{> driver/application/preference}}

                        {{/if}}
                        {{#if (gte step 8)}}
                        {{> driver/application/business}}

                        {{/if}}
                        {{#if (gte step 9)}}
                        {{> driver/application/beneficiary}}

                        {{/if}}
                        {{#if (gte step 10)}}
                        {{> driver/application/misc}}

                        {{/if}}
                    </div>

                </div>
            </div>
            <div class="card-footer text-secondary">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application.mjs"></script>

{{> foot}}