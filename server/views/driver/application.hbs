{{> head}}

    <style>
        .apl-label {
            display: inline-block;
            width: 95px;
            font-size: .8em;
        }
        .accordion-button-state {
            display: inline-block;
            margin-right: 10px;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center min-vh-100">
        <div class="card text-center" id="apl-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-secondary">Professional Driver Application</h5>
                <div class="card-text py-2" id="form-card">
                    <p class="text-start my-0 px-1"><small class="text-muted apl-label">Application ID:</small> {{formId}}</p>
                    <p class="text-start my-0 px-1"><small class="text-muted apl-label">Applicant:</small> {{applicantName}}</p>
                    <p class="text-start my-0 px-1"><small class="text-muted apl-label">Started on:</small> {{startedAt}}</p>
                    <div class="progress mt-2">
                        <div class="progress-bar bg-success" style="width: {{progress}}%;">{{progress}}%</div>
                    </div>

                    <div class="accordion mt-3" id="apl-accordion">

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-0.0">
                                    <i class="fa fa-check accordion-button-state"></i>
                                    <strong>{{idx (idx steps 0) 0}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-0.0" class="text-start accordion-collapse collapse" data-bs-parent="#apl-accordion">
                                <div class="accordion-body pt-1">
                                    <form id="profile-form" action="{{actionUrl.profile}}" method="POST" autocomplete="off">
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6">
                                                {{{label.firstName}}}
                                                {{{input.firstName}}}
                                            </div>
                                            <div class="col-md-6">
                                                {{{label.middleName}}}
                                                {{{input.middleName}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6">
                                                {{{label.lastName}}}
                                                {{{input.lastName}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{label.suffix}}}
                                                {{{select.suffix}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-4">
                                                {{{label.gender}}}
                                                {{{select.gender}}}
                                            </div>
                                            <div class="col-md-4">
                                                {{{label.dob}}}
                                                {{{input.dob}}}
                                                <div class="form-text text-danger" id="profile-dob-help"></div>
                                            </div>
                                            <div class="col-md-4">
                                                {{{label.ssn}}}
                                                {{{input.ssn}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5">
                                                {{{label.phone}}}
                                                {{{input.phone}}}
                                            </div>
                                            <div class="col-md-7">
                                                {{{label.email}}}
                                                {{{input.email}}}
                                                <div class="form-text text-danger" id="profile-email-help"></div>
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5">
                                                {{{label.position}}}
                                                {{{select.position}}}
                                            </div>
                                        </div>
                                        <p class="form-text text-danger mt-4" id="profile-form-help" style="display: none;"></p>
                                        <div class="row g-3 my-2">
                                            <div class="col-md-4">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-{{button.one.class}}" id="profile-submit">{{button.one.text}}</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    <script type="module" src="/modules/application/profile.mjs"></script>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-0.1">
                                    <i class="fa fa-check accordion-button-state"></i>
                                    <strong>{{idx (idx steps 0) 1}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-0.1" class="text-start accordion-collapse collapse" data-bs-parent="#apl-accordion">
                                <div class="accordion-body pt-1">
                                    <form id="address-form" action="{{actionUrl.address}}" method="POST" autocomplete="off">
                                        <div class="row g-3 my-1">
                                            <label class="form-label text-danger required">U.S. Address required</label>
                                            <div class="col-md-6">
                                                {{{label.address1}}}
                                                {{{input.address1}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{label.address2}}}
                                                {{{input.address2}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{label.zip}}}
                                                {{{input.zip}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5">
                                                {{{label.city}}}
                                                {{{input.city}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{label.state}}}
                                                {{{select.state}}}
                                            </div>
                                            <div class="col-md-4">
                                                {{{label.addrSince}}}
                                                {{{input.addrSince}}}
                                                <div class="form-text text-danger" id="addr-since-help"></div>
                                            </div>
                                            <div class="row g-3 my-2">
                                            <div class="col-md-4">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-{{button.one.class}}" id="address-submit">{{button.one.text}}</button>
                                                </div>
                                            </div>
                                        </div>
                                        </div>
                                    </form>
                                    <script type="module" src="/modules/application/address.mjs"></script>
                                </div>
                            </div>
                        </div>

                        {{#if (eq addrEnough false)}}
                        <div class="accordion-item">
                            <h2 class="accordion-header"></h2>
                            <div id="collapse-0.2" class="text-start accordion-collapse collapse" data-bs-parent="#apl-accordion"></div>
                        </div>
                        {{/if}}

                        {{#if (gte step 1)}}
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button{{accordion.one.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-1">
                                    <i class="{{accordion.one.state}} accordion-button-state"></i>
                                    <strong>{{idx steps 1}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-1" class="text-start accordion-collapse collapse{{accordion.one.body}}" data-bs-parent="#apl-accordion">
                                <div class="accordion-body pt-1">
                                    <form id="dl-form" action="{{actionUrl.dl}}" method="POST" autocomplete="off">
                                        <div class="row g-3 my-1">
                                            <div class="col-md-3">
                                                {{{label.dlState}}}
                                                {{{select.dlState}}}
                                            </div>
                                            <div class="col-md-5">
                                                {{{label.dlNum}}}
                                                {{{input.dlNum}}}
                                            </div>
                                            <div class="col-md-4">
                                                {{{label.dlClass}}}
                                                {{{select.dlClass}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-4">
                                                {{{label.dlIss}}}
                                                {{{input.dlIss}}}
                                                <div class="form-text text-danger" id="dl-iss-help"></div>
                                            </div>
                                            <div class="col-md-4">
                                                {{{label.dlExp}}}
                                                {{{input.dlExp}}}
                                                <div class="form-text" id="dl-exp-help"></div>
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6">
                                                {{{label.dlEndorse}}}
                                                {{{input.dlEndorse}}}
                                            </div>
                                            <div class="col-md-6">
                                                {{{label.dlRestr}}}
                                                {{{input.dlRestr}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <label class="form-label required">
                                                Have you ever been denied a License, Permit or Privilege to operate a Motor Vehicle?
                                            </label>
                                            <div class="col-md-4">
                                                <div class="form-check form-check-inline">
                                                    {{{input.dlDenied.yes}}}
                                                    {{{label.dlDenied.yes}}}
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    {{{input.dlDenied.no}}}
                                                    {{{label.dlDenied.no}}}
                                                </div>
                                            </div>
                                            <div class="col-md-8" style="display: none;">
                                                {{{label.dlDenied.expl}}}
                                                {{{input.dlDenied.expl}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <label class="form-label required">
                                                Has any of your License, Permit or Privilege ever been suspended or revoked?
                                            </label>
                                            <div class="col-md-4">
                                                <div class="form-check form-check-inline">
                                                    {{{input.dlRevoked.yes}}}
                                                    {{{label.dlRevoked.yes}}}
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    {{{input.dlRevoked.no}}}
                                                    {{{label.dlRevoked.no}}}
                                                </div>
                                            </div>
                                            <div class="col-md-8" style="display: none;">
                                                {{{label.dlRevoked.expl}}}
                                                {{{input.dlRevoked.expl}}}
                                            </div>
                                        </div>
                                        <p class="form-text text-danger mt-4" id="dl-form-help" style="display: none;"></p>
                                        <div class="row g-3 my-2">
                                            <div class="col-md-4">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-{{button.one.class}}" id="dl-submit">{{button.one.text}}</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    <script type="module" src="/modules/application/driver-license.mjs"></script>
                                </div>
                            </div>
                        </div>
                        {{/if}}

                        {{#if (gte step 2)}}
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button{{accordion.two.head}}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-2">
                                    <i class="{{accordion.two.state}} accordion-button-state"></i>
                                    <strong>{{idx steps 2}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-2" class="text-start accordion-collapse collapse{{accordion.two.body}}" data-bs-parent="#apl-accordion">
                                <div class="accordion-body">
                                    <form id="address-form" action="{{actionUrl.address}}" method="POST" autocomplete="off">
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6">
                                                {{{label.address1}}}
                                                {{{input.address1}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{label.address2}}}
                                                {{{input.address2}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{label.zip}}}
                                                {{{input.zip}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5">
                                                {{{label.city}}}
                                                {{{input.city}}}
                                            </div>
                                            <div class="col-md-3">
                                                {{{label.state}}}
                                                {{{select.state}}}
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {{/if}}

                    </div>



                </div>
            </div>
            <div class="card-footer text-black-50">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application.mjs"></script>

{{> foot}}