{{> head}}

<style>
    .container { outline: 1px dotted red; }
    .form-container {
        max-width: 540px; /* Narrower form */
        margin: auto;
        padding: 1.2rem;
    }
    .footer {
        text-align: center;
        padding: 1rem 0;
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>
<div class="container mt-5">
    <div class="card shadow-lg form-container">
        <div class="card-body">
            <h4 class="card-title mb-4 text-center">Application Form</h4>
            <form>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="firstName" required>
                    </div>
                    <div class="col-md-6">
                        <label for="middleName" class="form-label">Middle Name</label>
                        <input type="text" class="form-control" id="middleName">
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-6">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="lastName" required>
                    </div>
                    <div class="col-md-6">
                        <label for="suffix" class="form-label">Suffix</label>
                        <select class="form-select" id="suffix">
                            <option value="">--</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-6">
                        <label for="dob" class="form-label">Date of Birth</label>
                        <input type="date" class="form-control" id="dob" required>
                    </div>
                    <div class="col-md-6">
                        <label for="ssn" class="form-label">Social Security Number</label>
                        <input type="text" class="form-control" id="ssn" placeholder="XXX-XX-XXXX" required>
                    </div>
                </div>

                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="legalStatus" required>
                    <label class="form-check-label" for="legalStatus">
                        I confirm that I am legally eligible to apply.
                    </label>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary w-100 mt-4">Start Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="footer mt-5">
    {{{copyright}}}
</footer>

{{> foot}}