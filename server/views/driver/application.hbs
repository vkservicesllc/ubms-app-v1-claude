{{> head}}

    <style>
        .apl-label {
            display: inline-block;
            width: 95px;
            font-size: .8em;
        }
        .accordion-button-state {
            display: inline-block;
            margin-right: 10px;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center min-vh-100">
        <div class="card text-center" id="apl-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-secondary">Professional Driver Application</h5>
                <div class="card-text py-2" id="form-card">
                    <p class="text-start my-0 px-1"><small class="text-muted apl-label">Application ID:</small> {{formId}}</p>
                    <p class="text-start my-0 px-1"><small class="text-muted apl-label">Applicant:</small> {{applicantName}}</p>
                    <p class="text-start my-0 px-1"><small class="text-muted apl-label">Started on:</small> {{startedAt}}</p>
                    <div class="progress mt-2">
                        <div class="progress-bar bg-success" style="width: {{progress}}%;">{{progress}}%</div>
                    </div>

                    <div class="accordion mt-3" id="apl-accordion">

                        <!-- First Item -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-0">
                                    <i class="fa fa-check accordion-button-state"></i>
                                    <strong>{{idx steps 0}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-0" class="text-start accordion-collapse collapse" data-bs-parent="#apl-accordion">
                                <div class="accordion-body">
                                    <form id="profile-form" action="{{actionUrl.profile}}" method="POST" autocomplete="off">
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6 text-start">
                                                {{{label.firstName}}}
                                                {{{input.firstName}}}
                                            </div>
                                            <div class="col-md-6 text-start">
                                                {{{label.middleName}}}
                                                {{{input.middleName}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6 text-start">
                                                {{{label.lastName}}}
                                                {{{input.lastName}}}
                                            </div>
                                            <div class="col-md-3 text-start">
                                                {{{label.suffix}}}
                                                {{{select.suffix}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5 text-start">
                                                {{{label.dob}}}
                                                {{{input.dob}}}
                                                <div class="form-text text-danger" id="profile-dob-help"></div>
                                            </div>
                                            <div class="col-md-5 text-start">
                                                {{{label.ssn}}}
                                                {{{input.ssn}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5 text-start">
                                                {{{label.phone}}}
                                                {{{input.phone}}}
                                            </div>
                                            <div class="col-md-7 text-start">
                                                {{{label.email}}}
                                                {{{input.email}}}
                                                <div class="form-text text-danger" id="profile-email-help"></div>
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-5 text-start">
                                                {{{label.position}}}
                                                {{{select.position}}}
                                            </div>
                                        </div>
                                        <p class="form-text text-danger mt-4" id="profile-form-help" style="display: none;"></p>
                                        <div class="row g-3 my-2">
                                            <div class="col-md-4">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-{{button.profile.class}}" id="profile-submit">{{button.profile.text}}</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    <script type="module" src="/modules/application/profile.mjs"></script>
                                </div>
                            </div>
                        </div>

                        <!-- Last Item (Expanded by Default) -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-1">
                                    <i class="far fa-clock accordion-button-state"></i>
                                    <strong>{{idx steps 1}}</strong>
                                </button>
                            </h2>
                            <div id="collapse-1" class="text-start accordion-collapse collapse show" data-bs-parent="#apl-accordion">
                                <div class="accordion-body">
                                    <form id="dl-form" action="{{actionUrl.dl}}" method="POST" autocomplete="off">
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6 text-start">
                                                {{{label.dlState}}}
                                                {{{select.dlState}}}
                                            </div>
                                            <div class="col-md-6 text-start">
                                                {{{label.dlNum}}}
                                                {{{input.dlNum}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-4 text-start">
                                                {{{label.dlClass}}}
                                                {{{select.dlClass}}}
                                            </div>
                                            <div class="col-md-8 text-start">
                                                {{{label.dlDesc}}}
                                                {{{input.dlDesc}}}
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-4 text-start">
                                                {{{label.gender}}}
                                                {{{select.gender}}}
                                            </div>
                                            <div class="col-md-4 text-start">
                                                {{{label.dlIss}}}
                                                {{{input.dlIss}}}
                                                <div class="form-text text-danger" id="dl-iss-help"></div>
                                            </div>
                                            <div class="col-md-4 text-start">
                                                {{{label.dlExp}}}
                                                {{{input.dlExp}}}
                                                <div class="form-text text-danger" id="dl-exp-help"></div>
                                            </div>
                                        </div>
                                        <div class="row g-3 my-1">
                                            <div class="col-md-6 text-start">
                                                {{{label.dlEndorse}}}
                                                {{{input.dlEndorse}}}
                                            </div>
                                            <div class="col-md-6 text-start">
                                                {{{label.dlRestr}}}
                                                {{{input.dlRestr}}}
                                            </div>
                                        </div>
                                        <p class="form-text text-danger mt-4" id="dl-form-help" style="display: none;"></p>
                                        <div class="row g-3 my-2">
                                            <div class="col-md-4">
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-{{button.dl.class}}" id="dl-submit">{{button.dl.text}}</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </div>



                </div>
            </div>
            <div class="card-footer text-black-50">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application.mjs"></script>

{{> foot}}