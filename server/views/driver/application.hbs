{{> head}}

    <style>
        .card {
            width: 540px;
            max-width: 100%;
            margin: 10px;
        }
        .card-title {
            font-weight: 600;
            font-size: 1.18em;
        }
        .card-footer {
            font-size: .87em;
        }
        #carrier-name {
            font-weight: 500;
        }
        #intro {
            font-size: .92em;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center min-vh-100">
        <div class="card text-center" id="new-apl-card">
            <div class="card-body pt-4">
                <h5 class="card-title text-secondary">Professional Driver Application</h5>
                <div class="card-text" id="card-intro">
                    {{#if (ne carrier false)}}
                    <div class="border-top border-bottom py-2">
                        <span id="carrier-name">{{carrier.name}}</span><br/>
                        {{{carrier.address}}}<br/>
                        {{carrier.phone}}
                    </div>
                    {{/if}}
                    <div class="text-start text-success pt-2" id="intro">
                        <p>
                            We're looking for experienced and reliable drivers to join our carrier team.
                            If you meet the qualifications and are committed to safety, efficiency,
                            and top-tier service, we'd love to have you on board.
                        </p>
                        Before you begin the application, please ensure you:
                        <ul>
                            <li>are at least 18 years old</li>
                            <li>have a valid driver's license</li>
                            <li>have a clean driving record</li>
                            <li>have required permits and credentials</li>
                            <li>are able to meet DOT and company safety requirements</li>
                        </ul>
                    </div>
                    <button class="btn btn-success" id="apply">APPLY NOW</button>
                </div>
                <div class="card-text px-2" id="card-form" style="display: none;">
                    <form action="" method="POST">
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.firstName}}}
                                {{{input.firstName}}}
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.middleName}}}
                                {{{input.middleName}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.lastName}}}
                                {{{input.lastName}}}
                            </div>
                            <div class="col-md-3 text-start">
                                {{{label.suffix}}}
                                {{{select.suffix}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.dob}}}
                                {{{input.dob}}}
                                <div class="form-text text-danger" id="dob-help"></div>
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.ssn}}}
                                {{{input.ssn}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.phone}}}
                                {{{input.phone}}}
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.email}}}
                                {{{input.email}}}
                                <div class="form-text text-danger" id="email-help"></div>
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-12 text-start">
                                <label class="form-label">I certify under penalty of law that:</label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="confirm-dl" />
                                    <label class="form-check-label required" for="confirm-dl">
                                        I have a valid and genuine driver's license
                                    </label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="confirm-status" />
                                    <label class="form-check-label required" for="confirm-status">
                                        I am legally authorized to work in the United States
                                    </label>
                                </div>
                                <label class="form-label mt-3 required">Immigration Status</label>
                                <div class="form-check">
                                    <input class="form-check-input status-radio" type="radio" name="legalStatus" id="legal-status-0" value="0" />
                                    <label class="form-check-label" for="legal-status-0">US Citizen</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input status-radio" type="radio" name="legalStatus" id="legal-status-1" value="1" />
                                    <label class="form-check-label" for="legal-status-1">Permanent Resident</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input status-radio" type="radio" name="legalStatus" id="legal-status-2" value="2" />
                                    <label class="form-check-label" for="legal-status-2">Work Visa/Authorization</label>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6 text-start">
                                {{{label.statusExp}}}
                                {{{input.statusExp}}}
                                <div class="form-text text-danger" id="status-exp-help"></div>
                            </div>
                            <div class="col-md-6 text-start">
                                {{{label.position}}}
                                {{{select.position}}}
                            </div>
                        </div>
                        <div class="d-grid gap-2 mt-4 mb-2">
                            <button type="submit" class="btn btn-primary" disabled>Start Application</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-footer text-black-50">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application/start.mjs"></script>

{{> foot}}