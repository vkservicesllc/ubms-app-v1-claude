{{> head}}

    <style>
        .table th {
            font-size: .9em;
            font-weight: 600;
            padding-right: 0 !important;
            width: 108px;
            {{!-- outline: 1px dotted red; --}}
        }
        .table th small {
            font-weight: 500;
        }
        .table td {
            {{!-- padding-left: 0 !important; --}}
            {{!-- outline: 1px dotted blue; --}}
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center full-height-fix">

        <div class="card text-center" id="apl-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-secondary">Professional Driver Application</h5>
                <div class="card-text py-2" id="form-card">
                    <p class="mb-0 px-5" style="font-size: .84em;">
                        Please thoroughly review the summary of your application.<br/>
                        Click <i class="text-secondary">Edit</i> to correct any mistakes; otherwise, proceed further.
                    </p>
                </div>
                <div class="text-start" style="font-size: .84em;">
                    <div class="row mt-2">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr>
                                    <th class="text-secondary">Form ID:</th>
                                    <td>{{application.formId}}</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr>
                                    <th class="text-secondary">Position:</th>
                                    <td>{{application.expansion.position}}</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Legal Name</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">First Name:</th>
                                        <td>{{application.firstName}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Middle Name:</th>
                                        <td>{{{application.middleName}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Last Name:</th>
                                        <td>{{application.fullLastName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Personal Details</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">Date of Birth:</th>
                                        <td>{{application.dob}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Gender:</th>
                                        <td>{{application.expansion.gender}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">SSN:</th>
                                        <td>{{application.ssn}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Marital Status:</th>
                                        <td>{{application.maritalStatus}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-9">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Contacts</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">Phone:</th>
                                        <td>{{application.phone}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Email:</th>
                                        <td>{{application.email}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Emergency:</th>
                                        <td>
                                            {{application.emergency.phone}} —
                                            {{application.emergency.name}}{{{application.emergency.relation}}}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-9">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Residence</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">Address:</th>
                                        <td>
                                            {{{application.fullAddress}}}
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Living since:</th>
                                        <td>{{application.address.since}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {{#if (eq application.address.enough false)}}
                    <div class="row">
                        <div class="col-md-9">
                            <table class="table table-sm">
                                <thead id="addresses">
                                    <tr>
                                        <th colspan="2">Prior Residence <small>(in the past 3 years)</small></th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    {{#if (hv application.address.country)}}
                                    <tr>
                                        <th class="text-secondary">Country:</th>
                                        <td>{{application.address.country}}</td>
                                    </tr>
                                    {{/if}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {{/if}}
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Driver License</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">Type:</th>
                                        <td>{{application.dl.type}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">State:</th>
                                        <td>{{application.dl.state}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Number:</th>
                                        <td>{{application.dl.number}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Class:</th>
                                        <td>{{{application.dl.class}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Issued on:</th>
                                        <td>{{application.dl.issuedOn}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Expires on:</th>
                                        <td>{{application.dl.expiresOn}}</td>
                                    </tr>
                                    {{#if (eq application.dl.commercial true)}}
                                    <tr>
                                        <th class="text-secondary">Endorsements:</th>
                                        <td>{{{application.dl.endorsement}}}</td>
                                    </tr>
                                    {{/if}}
                                    <tr>
                                        <th class="text-secondary">Restrictions:</th>
                                        <td>{{{application.dl.restriction}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Denied:</th>
                                        <td>{{{application.dl.deniedExpl}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Revoked:</th>
                                        <td>{{{application.dl.revokedExpl}}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Medical Card</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    {{#if (eq application.medCard false)}}
                                    <tr>
                                        <th></th>
                                        <td><small class="text-danger">Unavailable</small></td>
                                    </tr>
                                    {{else}}
                                    <tr>
                                        <th class="text-secondary">Expires on:</th>
                                        <td>{{application.mec.expiresOn}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Exam Date:</th>
                                        <td>{{{application.mec.issuedOn}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">NRCME:</th>
                                        <td>{{{application.mec.nrcme}}}</td>
                                    </tr>
                                    {{/if}}
                                    <tr>
                                        <th class="text-secondary">Medications:</th>
                                        <td>{{{application.medList}}}</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Legal Compliance</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">DUI/DWI:</th>
                                        <td>{{{application.dui}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Criminal History:</th>
                                        <td>{{{application.criminal}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Drug/Alcohol Test:</th>
                                        <td>{{application.dotDat}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm" id="citations">
                                <thead>
                                    <tr>
                                        <th colspan="2">Citations <small>(in the past 3 years)</small></th>
                                    </tr>
                                </thead>
                                {{#if (eq application.citations false)}}
                                <tbody class="table-group-divider">
                                    <tr>
                                        <td colspan="2"><small class="text-danger">None</small></td>
                                    </tr>
                                </tbody>
                                {{/if}}
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm" id="accidents">
                                <thead>
                                    <tr>
                                        <th colspan="2">Accidents <small>(in the past 3 years)</small></th>
                                    </tr>
                                </thead>
                                {{#if (eq application.accidents false)}}
                                <tbody class="table-group-divider">
                                    <tr>
                                        <td colspan="2"><small class="text-danger">None</small></td>
                                    </tr>
                                </tbody>
                                {{/if}}
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-9">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Driving Experience</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    {{#if (eq application.experience false)}}
                                    <tr>
                                        <td colspan="2"><small class="text-danger">None</small></td>
                                    </tr>
                                    {{else}}
                                    {{#if (ne application.experience.cmv null)}}
                                    <tr>
                                        <th class="text-secondary">Commercial:</th>
                                        <td>{{application.experience.cmv}}</td>
                                    </tr>
                                    {{/if}}
                                    <tr>
                                        <th class="text-secondary">Vehicles:</th>
                                        <td>
                                            {{{application.experience.vehicleList}}}
                                        </td>
                                    </tr>
                                    {{!-- <tr>
                                        <th class="text-secondary">Driving Period:</th>
                                        <td>
                                            {{{application.experience.period}}}
                                        </td>
                                    </tr> --}}
                                    <th class="text-secondary">Started Driving on:</th>
                                        <td>
                                            {{{application.experience.firstDate}}}
                                        </td>
                                    </tr>
                                    {{#if (hv application.experience.mileage)}}
                                    <tr>
                                        <th class="text-secondary">Mileage Driven:</th>
                                        <td>
                                            {{{application.experience.mileage}}} mi
                                        </td>
                                    </tr>
                                    {{/if}}
                                    {{!-- {{#if (hv application.experience.hours)}}
                                    <tr>
                                        <th class="text-secondary">Hours on Road:</th>
                                        <td>
                                            <small>Last 7 Days:</small><br/>
                                            {{{application.experience.hourList}}}
                                        </td>
                                    </tr>
                                    {{/if}} --}}
                                    {{/if}}
                                </tbody>
                                {{#if (hv application.cdlSchool.name)}}
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">CDL School:</th>
                                        <td>{{application.cdlSchool.name}}</td>
                                    </tr>
                                    {{#if (hv application.cdlSchool.phone)}}
                                    <tr>
                                        <th class="text-secondary">Phone:</th>
                                        <td>{{application.cdlSchool.phone}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">State:</th>
                                        <td>{{application.cdlSchool.state}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Duration:</th>
                                        <td>{{application.cdlSchool.duration}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Graduated on:</th>
                                        <td>{{application.cdlSchool.endDate}}</td>
                                    </tr>
                                    {{/if}}
                                </tbody>
                                {{/if}}
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-9">
                            <table class="table table-sm" id="prev-employments">
                                <thead>
                                    <tr>
                                        <th colspan="2">Previous Employment</th>
                                    </tr>
                                </thead>
                                {{#if (eq application.prevEmployed false)}}
                                <tbody class="table-group-divider">
                                    <tr>
                                        <td colspan="2"><small class="text-danger">None</small></td>
                                    </tr>
                                </tbody>
                                {{/if}}
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Driving Preference</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">Operating Type:</th>
                                        <td>{{application.preference.expansion.operType}}</td>
                                    </tr>


                                    {{#if (
                                        and
                                            (eq application.cdlRole 1)
                                            (eq application.preference.operType 't')
                                    )}}
                                    <tr>
                                        <th class="text-secondary">Partner's Name:</th>
                                        <td>{{{application.preference.teamName}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Partner's Phone:</th>
                                        <td>{{{application.preference.teamPhone}}}</td>
                                    </tr>
                                    {{/if}}


                                    {{#if (hv application.preference.haulRegion)}}
                                    <tr>
                                        <th class="text-secondary">Haul Region:</th>
                                        <td>{{{application.preference.haulRegionList}}}</td>
                                    </tr>
                                    {{/if}}
                                    {{#if (hv application.preference.haulRegion)}}
                                    <tr>
                                        <th class="text-secondary">Equipment:</th>
                                        <td>{{{application.preference.equipmentList}}}</td>
                                    </tr>
                                    {{/if}}
                                    <tr>
                                        <th class="text-secondary">Start:</th>
                                        <td>{{application.preference.startPref}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Business</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    {{#if (eq application.activeBusiness false)}}
                                    <tr>
                                        <td colspan="2"><small class="text-danger">None</small></td>
                                    </tr>
                                    {{!-- <tr>
                                        <th></th>
                                        <td><small class="text-danger">None</small></td>
                                    </tr> --}}
                                    {{!-- <tr>
                                        <th class="text-secondary">Assistance:</th>
                                        <td>{{{application.businessAssist}}}</td>
                                    </tr> --}}
                                    {{else}}
                                    <tr>
                                        <th class="text-secondary">Name:</th>
                                        <td>{{application.business.busName}}, LLC</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">State:</th>
                                        <td>{{application.business.state}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">EIN:</th>
                                        <td>{{{application.business.ein}}}</td>
                                    </tr>
                                    {{/if}}
                                </tbody>
                            </table>
                            {{#if (hv application.vehicle)}}
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Vehicle Owned</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    {{#if (hv application.vehicle.type)}}
                                    <tr>
                                        <th class="text-secondary">Type</th>
                                        <td>{{application.vehicle.type}}</td>
                                    </tr>
                                    {{/if}}
                                    {{#if (hv application.vehicle.make)}}
                                    <tr>
                                        <th class="text-secondary">Make</th>
                                        <td>{{application.vehicle.make}}</td>
                                    </tr>
                                    {{/if}}
                                    {{#if (hv application.vehicle.model)}}
                                    <tr>
                                        <th class="text-secondary">Model</th>
                                        <td>{{application.vehicle.model}}</td>
                                    </tr>
                                    {{/if}}
                                    {{#if (hv application.vehicle.year)}}
                                    <tr>
                                        <th class="text-secondary">Year</th>
                                        <td>{{application.vehicle.year}}</td>
                                    </tr>
                                    {{/if}}
                                    {{#if (hv application.vehicle.length)}}
                                    <tr>
                                        <th class="text-secondary">Length</th>
                                        <td>{{application.vehicle.length}} ft</td>
                                    </tr>
                                    {{/if}}
                                </tbody>
                            </table>
                            {{/if}}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-9">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th colspan="2">Beneficiary</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <tbody class="table-group-divider">
                                    <tr>
                                        <th class="text-secondary">Full Name:</th>
                                        <td>{{application.beneficiary.fullName}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Relationship:</th>
                                        <td>{{application.beneficiary.relationship}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Phone:</th>
                                        <td>{{{application.beneficiary.phone}}}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">SSN:</th>
                                        <td>{{{application.beneficiary.ssn}}}</td>
                                    </tr>
                                </tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row text-start g-3 mb-2 ps-1">
                    <div class="col-md-4">
                        <small style="font-size: .8em;">Found Mistakes?</small>&nbsp;
                        <button class="btn btn-secondary bg-info-subtle btn-sm" data-href="{{href.form}}" id="edit-link">
                            Edit
                        </button>
                    </div>
                    <div class="col-md-8">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="no-mistakes" />
                            <label class="form-check-label" style="font-size: .8em;">
                                I hereby certify that I have reviewed the summary and found no inaccuracies.
                                To the best of my knowledge, all information provided is true and complete.
                                I understand that any false or misleading information may result in disqualification from employment.
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row text-start border-top g-3 my-2 ps-1" id="certified-section" style="display: none;">
                    <div class="col-md-9">
                        <p style="font-size: .8em;">
                            To help expedite the processing of your application, we encourage you to upload the necessary documents.
                            This step is entirely optional — if you prefer, you may send the documents directly to your recruiter instead.
                            Rest assured, all transactions are secure, and we take every precaution to protect your information.
                        </p>
                    </div>
                    <div class="col-md-3">
                        <form id="certify-form" action="{{actionUrl.certify}}" method="POST">
                            <div class="d-grid gap-2">
                                <a class="btn btn-primary bg-primary-subtle btn-sm" href="{{href.dox}}">Upload Document</a>
                                <button type="submit" class="btn btn-secondary bg-secondary-subtle btn-sm">Skip Upload</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="card-footer text-secondary" style="font-size: .7em;">
                {{{copyright}}}
            </div>
        </div>

    </div>
    <script type="module" src="/modules/application/summary.mjs"></script>

{{> foot}}