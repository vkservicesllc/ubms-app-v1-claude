{{> head}}

    <style>
        a {
            text-decoration: none;
            font-size: 1.05em;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center full-height-fix">
        <div class="card text-center" id="apl-login-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-info mb-0">Professional Driver Application</h5>
                <p class="text-secondary fs-6 fw-light mb-1"><small>Powered by {{siteName}} <sup style="font-size: 62%;">TM</sup></small></p>
                <div class="card-text px-2" id="form-card">
                    <h6 class="text-success border-top pt-4 pb-3">
                        <p class="mb-1">Welcome back, {{firstName}}!</p>
                        <small>
                            It looks like your application is still incomplete.
                            Please sign in to continue.
                        </small>
                        {{!-- <p class="text-warning mt-2">
                            <small>
                                The PIN has been sent to <i>{{{maskedEmail}}}</i>.
                            </small>
                        </p> --}}
                    </h6>
                    <form id="apl-login-form" action="{{formUrl}}" method="POST" autocomplete="off">
                        <div class="row g-3 mb-1">
                            <div class="col-md-5">
                                <div class="form-floating">
                                    {{{form.phone.text.input}}}
                                    {{{form.phone.text.label}}}
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    {{{form.dob.text.input}}}
                                    {{{form.dob.text.label}}}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-floating">
                                    {{{form.pin.text.input}}}
                                    {{{form.pin.text.label}}}
                                </div>
                            </div>
                        </div>
                        <label class="form-label fw-normal text-warning my-3">
                            {{!-- <small>Check your email for the PIN</small> --}}
                            <small>The PIN has been sent to <i>{{{maskedEmail}}}</i></small><br/>
                            <small class="text-danger">Didn't receive the PIN?</small>
                            <small class="ms-2"><a id="resend-pin" href="">Resend</a></small>
                        </label>
                        <p class="form-text text-danger mt-0" id="form-help" style="display: none;"></p>
                        <div class="row g-3 mb-3">
                            <div class="col-md-3"></div>
                            <div class="col-md-6">
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary bg-primary-subtle">Continue Application</button>
                                </div>
                            </div>
                            <div class="col-md-3"></div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-footer text-secondary">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <div class="modal fade" id="pin-resent-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center">
                    <i class="fas fa-check text-success"></i>
                    The PIN was resent to <i>{{{maskedEmail}}}</i><br/><br/>
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">Ok, thanks</button>
                </div>
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application/login.mjs"></script>

{{> foot}}