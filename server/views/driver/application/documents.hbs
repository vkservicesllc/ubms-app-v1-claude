{{> head}}

    <div class="d-flex justify-content-center align-items-lg-center full-height-fix">

        <div class="card text-center" id="apl-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-info mb-0">Professional Driver Application</h5>
                <p class="text-secondary fs-6 fw-light mb-1"><small>Powered by {{siteName}} <sup style="font-size: 62%;">TM</sup></small></p>
                <div class="card-text pt-1 pb-2">
                    <div class="text-start text-warning px-3">
                        <p style="font-size: 85%;">
                            To help us begin the hiring process faster, you can upload your driver's license and required legal documents below.
                            This allows us to verify your qualifications promptly and move forward with your application.
                        </p>
                    </div>
                    <div class="border-bottom mb-3 pb-3">
                        <a href="{{href.summary}}" id="summary-link">Back to Summary</a>
                        <form class="ms-4" id="certify-form" action="{{actionUrl.certify}}" method="POST" style="display: inline-block;">
                            <button type="submit" class="btn btn-secondary bg-secondary-subtle btn-sm px-3">Skip Upload</button>
                        </form>
                    </div>
                    <form action="/upload/application/{{formId}}/documents" method="POST" enctype="multipart/form-data">
                        <div class="container my-4">
                            <h6 class="text-success mb-3">Upload Driver's License</h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label text-secondary" for="dl-front">FRONT</label>
                                    <div class="input-group browse">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="dl-front-btn">Browse...</button>
                                        <input type="text" class="form-control" id="dl-front-placeholder" placeholder="No file selected" readonly />
                                    </div>
                                    <input type="file" id="dl-front" name="dlF" accept="image/*" style="display:none" />
                                    <div class="mt-2">
                                        <img id="dl-front-preview" class="img-fluid rounded shadow-sm d-none" alt="Driver's license front preview" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary" for="dl-back">BACK</label>
                                    <div class="input-group browse">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="dl-back-btn">Browse...</button>
                                        <input type="text" class="form-control" id="dl-back-placeholder" placeholder="No file selected" readonly />
                                    </div>
                                    <input type="file" id="dl-back" name="dlB" accept="image/*" style="display:none" />
                                    <div class="mt-2">
                                        <img id="dl-back-preview" class="img-fluid rounded shadow-sm d-none" alt="Driver's license back preview" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="container my-4">
                            <h6 class="text-success mb-3">Upload Medical Certificate</h6>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <div class="input-group browse">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="mec-btn">Browse...</button>
                                        <input type="text" class="form-control" id="mec-placeholder" placeholder="No file selected" readonly />
                                    </div>
                                    <input type="file" id="mec" name="mec" accept="image/*" style="display:none" />
                                    <div class="mt-2">
                                        <img id="mec-preview" class="img-fluid rounded shadow-sm d-none" alt="Medical certificate preview" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="container my-4">
                            <h6 class="text-success mb-3">Upload Social Security Card</h6>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <div class="input-group browse">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="ssc-btn">Browse...</button>
                                        <input type="text" class="form-control" id="ssc-placeholder" placeholder="No file selected" readonly />
                                    </div>
                                    <input type="file" id="ssc" name="ssc" accept="image/*" style="display:none" />
                                    <div class="mt-2">
                                        <img id="ssc-preview" class="img-fluid rounded shadow-sm d-none" alt="Social security card preview" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{#if (eq uplLegal true)}}
                        <div class="container my-4">
                            <h6 class="text-success mb-3">Upload Work Authorization / Visa</h6>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <div class="input-group browse">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="leg-btn">Browse...</button>
                                        <input type="text" class="form-control" id="leg-placeholder" placeholder="No file selected" readonly />
                                    </div>
                                    <input type="file" id="leg" name="leg" accept="image/*" style="display:none" />
                                    <div class="mt-2">
                                        <img id="leg-preview" class="img-fluid rounded shadow-sm d-none" alt="Social security card preview" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/if}}
                        {{#if (eq uplRegistration true)}}
                        <div class="container my-4">
                            <h6 class="text-success mb-3">Upload Vehicle Registration</h6>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <div class="input-group browse">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="reg-btn">Browse...</button>
                                        <input type="text" class="form-control" id="reg-placeholder" placeholder="No file selected" readonly />
                                    </div>
                                    <input type="file" id="reg" name="reg" accept="image/*" style="display:none" />
                                    <div class="mt-2">
                                        <img id="reg-preview" class="img-fluid rounded shadow-sm d-none" alt="Social security card preview" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/if}}
                        <div class="d-grid gap-2 mb-2 mx-2">
                            <button type="submit" class="btn btn-primary bg-primary-subtle">Upload Documents</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-footer text-secondary">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application/documents.mjs"></script>

{{> foot}}