{{> head}}

    <style>
        .apl-label {
            display: inline-block;
            width: 75px;
            font-size: .8em;
        }
        .message {
            font-size: .94em;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center full-height-fix">
        <div class="card text-center" id="apl-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-info mb-0">Professional Driver Application</h5>
                <p class="text-secondary fs-6 fw-light mb-1"><small>Powered by {{siteName}} <sup style="font-size: 62%;">TM</sup></small></p>
                <div class="card-text py-2" id="form-card">
                    <p class="text-danger message">
                        <i class="fas fa-exclamation-circle pe-1"></i>
                        We could not process your request due to a verification issue.<br/>
                        Please review your entries and try again.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3"></div>
                        <div class="col-md-6">
                            <div class="d-grid">
                                <a class="btn btn-danger bg-danger-subtle" href="{{{appUrl}}}">Start Over</a>
                            </div>
                        </div>
                        <div class="col-md-3"></div>
                    </div>
                </div>
            </div>
            <div class="card-footer text-secondary">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application.mjs"></script>

{{> foot}}