{{> head}}

    <style>
        #company-name {
            font-weight: 500;
        }
        #intro, #privacy {
            font-size: .92em;
        }
        .form-text {
            font-size: .8em;
        }
        .apl-label {
            display: inline-block;
            width: 75px;
            font-size: .8em;
        }
        h6 {
            font-size: .95em;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center full-height-fix">
        <div class="card text-center" id="new-apl-card" style="display: none; width: 640px;">
            <div class="card-body pt-4">
                <h5 class="card-title text-info">Professional Driver Application</h5>
                <div class="card-text text-start px-2" id="form-card">
                    <div class="pt-2">
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Form ID:</small> {{formId}}</p>
                        {{#if (hv agency)}}
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Agency:</small> {{{agency}}}</p>
                        {{/if}}
                        {{#if (hv carrier)}}
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Carrier:</small> {{{carrier}}}</p>
                        {{/if}}
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">Position:</small> {{position}}</p>
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">SSN:</small> {{maskedSsn}}</p>
                        <p class="text-start my-0 px-1"><small class="text-muted apl-label">DOB:</small> {{dob}}</p>
                    </div>
                    <form id="apl-start-form" action="/resource/application/register/{{_id}}" method="POST" autocomplete="off">
                        <input type="hidden" id="lead-phone" value="{{lead.phone}}" />
                        <input type="hidden" id="lead-email" value="{{lead.email}}" />
                        <div id="application-form">
                            <h6 class="text-secondary mt-4 my-1 border-top pt-4">Identity <small>(per Government ID)</small></h6>
                            <div class="row g-3 my-1">
                                <div class="col-md-6">
                                    {{{form.firstName.text.label}}}
                                    {{{form.firstName.text.input}}}
                                </div>
                                <div class="col-md-6">
                                    {{{form.middleName.text.label}}}
                                    {{{form.middleName.text.input}}}
                                </div>
                            </div>
                            <div class="row g-3 my-1">
                                <div class="col-md-6">
                                    {{{form.lastName.text.label}}}
                                    {{{form.lastName.text.input}}}
                                </div>
                                <div class="col-md-3">
                                    {{{form.suffix.select.label}}}
                                    {{{form.suffix.select.input}}}
                                </div>
                                <div class="col-md-3">
                                    {{{form.gender.select.label}}}
                                    {{{form.gender.select.input}}}
                                </div>
                            </div>
                            <h6 class="text-secondary mt-4 mb-1 border-top pt-4">Contacts</h6>
                            <div class="row g-3 my-1">
                                <div class="col-md-5">
                                    {{{form.phone.text.label}}}
                                    {{{form.phone.text.input}}}
                                </div>
                                <div class="col-md-7">
                                    {{{form.email.text.label}}}
                                    {{{form.email.text.input}}}
                                    <div class="form-text text-danger" id="email-help"></div>
                                </div>
                            </div>
                            <h6 class="text-secondary mt-4 mb-1 border-top pt-4">Current U.S. Address</h6>
                            <div class="row g-3 my-1">
                                {{{form.addrEnough.hidden.input}}}
                                <div class="col-md-6 autocomplete">
                                    {{{form.address1.text.label}}}
                                    {{{form.address1.text.input}}}
                                    <ul class="autocomplete-list address-predictions"></ul>
                                </div>
                                <div class="col-md-3">
                                    {{{form.address2.text.label}}}
                                    {{{form.address2.text.input}}}
                                </div>
                                <div class="col-md-3">
                                    {{{form.addrZip.text.label}}}
                                    {{{form.addrZip.text.input}}}
                                </div>
                            </div>
                            <div class="row g-3 my-1">
                                <div class="col-md-5">
                                    {{{form.addrCity.text.label}}}
                                    {{{form.addrCity.text.input}}}
                                </div>
                                <div class="col-md-3">
                                    {{{form.addrState.select.label}}}
                                    {{{form.addrState.select.input}}}
                                </div>
                                <div class="col-md-4">
                                    {{{form.addrSince.text.label}}}
                                    {{{form.addrSince.text.input}}}
                                    <div class="form-text text-danger" id="addr-since-help"></div>
                                </div>
                            </div>
                            <h6 class="text-secondary mt-4 mb-1 border-top pt-4">Marital Status</h6>
                            <div class="row g-3 my-1 pt-3">
                                {{!-- {{{form.marital.radio.label}}} --}}
                                <div class="col-md-4 my-0">
                                    <div class="form-check">
                                        {{{form.marital.radio.single.input}}}
                                        {{{form.marital.radio.single.label}}}
                                    </div>
                                    <div class="form-check">
                                        {{{form.marital.radio.married.input}}}
                                        {{{form.marital.radio.married.label}}}
                                    </div>
                                </div>
                                <div class="col-md-4 my-0">
                                    <div class="form-check">
                                        {{{form.marital.radio.divorced.input}}}
                                        {{{form.marital.radio.divorced.label}}}
                                    </div>
                                    <div class="form-check">
                                        {{{form.marital.radio.separated.input}}}
                                        {{{form.marital.radio.separated.label}}}
                                    </div>
                                </div>
                                <div class="col-md-4 my-0">
                                    <div class="form-check">
                                        {{{form.marital.radio.widowed.input}}}
                                        {{{form.marital.radio.widowed.label}}}
                                    </div>
                                </div>
                            </div>
                            <h6 class="text-secondary mt-4 mb-1 border-top pt-4">Immigration Status</h6>
                            <div class="row g-3 my-1">
                                <div class="col-md-6 mb-0">
                                    {{!-- {{{form.status.radio.label}}} --}}
                                    <div class="form-check">
                                        {{{form.status.radio.citizen.input}}}
                                        {{{form.status.radio.citizen.label}}}
                                    </div>
                                    <div class="form-check">
                                        {{{form.status.radio.resident.input}}}
                                        {{{form.status.radio.resident.label}}}
                                    </div>
                                    <div class="form-check">
                                        {{{form.status.radio.authorized.input}}}
                                        {{{form.status.radio.authorized.label}}}
                                    </div>
                                </div>
                                <div class="col-md-4" style="display: none;">
                                    {{{form.statusExp.text.label}}}
                                    {{{form.statusExp.text.input}}}
                                    <div class="form-text text-danger" id="status-exp-help"></div>
                                </div>
                            </div>
                            <p class="form-text text-danger mt-4" id="form-help" style="display: none;"></p>
                            {{!-- <div class="row g-3 my-2">
                                <div class="col-md-4">
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary bg-primary-subtle" id="profile-submit">Next</button>
                                    </div>
                                </div>
                            </div> --}}
                            <div class="d-grid gap-2 mt-4 mb-2">
                                <button type="submit" class="btn btn-primary bg-primary-subtle">Register & Proceed</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-footer text-secondary">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application/registration.mjs"></script>

{{> foot}}