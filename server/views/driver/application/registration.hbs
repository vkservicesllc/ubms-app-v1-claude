{{> head}}

    <style>
        #company-name {
            font-weight: 500;
        }
        #intro, #privacy {
            font-size: .92em;
        }
    </style>

    <div class="d-flex justify-content-center align-items-lg-center min-vh-100">
        <div class="card text-center" id="new-apl-card" style="display: none;">
            <div class="card-body pt-4">
                <h5 class="card-title text-secondary">Professional Driver Application</h5>
                <div class="card-text" id="intro-card">
                    {{#if (ne company false)}}
                    <div class="border-top border-bottom py-2">
                        <span id="company-name">{{company.name}}</span><br/>
                        {{{company.address}}}<br/>
                        {{company.phone}}
                    </div>
                    {{/if}}
                    <div class="text-start text-success pt-3" id="intro">
                        <p>
                            We're looking for experienced and reliable drivers to join our carrier team.
                            If you meet the qualifications and are committed to safety, efficiency,
                            and top-tier service, we'd love to have you on board.
                        </p>
                        Before you begin the application, please ensure you:
                        <ul>
                            <li>are at least 18 years old</li>
                            <li>have a valid {{text.requiredDL}}</li>
                            <li>have a clean driving record</li>
                            <li>have required permits and credentials</li>
                            <li>are able to meet DOT and company safety requirements</li>
                        </ul>
                    </div>
                    <button class="btn btn-success" id="apply">APPLY NOW</button>
                </div>
                <div class="card-text" id="privacy-card" style="display: none;">
                    <div class="text-start pt-2" id="privacy">
                        <h6 class="mb-3">Privacy & Data Security Notice</h6>
                        <p>
                            To proceed with the application process,
                            we are required by the Department of Transportation to obtain your Motor Vehicle Report.
                            To access this report, we will need your Social Security Number.
                        </p>
                        <p>
                            Please rest assured that all information you submit will be securely stored,
                            with the most sensitive data — such as Social Security numbers — being encrypted for maximum protection.
                            We will not share your information with any third party under any circumstances, except as required by law.
                        </p>
                        <p>
                            Your privacy and security are our top priorities.
                            Our commitment is to handle your data with the highest level of confidentiality and security.
                        </p>
                        {{#if (ne company false)}}
                        <p>If you have any questions about our data protection practices, please feel free to contact us at {{company.phone}}.</p>
                        {{/if}}
                    </div>
                    <button class="btn btn-success" id="confirm">I Understand & Agree</button>
                </div>
                <div class="card-text text-start px-2" id="form-card" style="display: none;">
                    <form id="apl-start-form" action="{{formUrl}}" method="POST" autocomplete="off">
                        <h6 class="text-secondary mt-4 my-1">Legal Name (per Government ID)</h6>
                        <div class="row g-3 my-1">
                            <div class="col-md-6">
                                {{{form.firstName.text.label}}}
                                {{{form.firstName.text.input}}}
                            </div>
                            <div class="col-md-6">
                                {{{form.middleName.text.label}}}
                                {{{form.middleName.text.input}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6">
                                {{{form.lastName.text.label}}}
                                {{{form.lastName.text.input}}}
                            </div>
                            <div class="col-md-3">
                                {{{form.suffix.select.label}}}
                                {{{form.suffix.select.input}}}
                            </div>
                        </div>
                        <h6 class="text-secondary mt-4 mb-1 border-top pt-3">Personal Identifiers</h6>
                        <div class="row g-3 my-1">
                            <div class="col-md-3">
                                {{{form.gender.select.label}}}
                                {{{form.gender.select.input}}}
                            </div>
                            <div class="col-md-4">
                                {{{form.dob.text.label}}}
                                {{{form.dob.text.input}}}
                                <div class="form-text text-danger" id="dob-help"></div>
                            </div>
                            <div class="col-md-5">
                                {{{form.ssn.text.label}}}
                                {{{form.ssn.text.input}}}
                            </div>
                        </div>
                        <h6 class="text-secondary mt-4 mb-1 border-top pt-3">Contacts</h6>
                        <div class="row g-3 my-1">
                            <div class="col-md-5">
                                {{{form.phone.text.label}}}
                                {{{form.phone.text.input}}}
                            </div>
                            <div class="col-md-7">
                                {{{form.email.text.label}}}
                                {{{form.email.text.input}}}
                                <div class="form-text text-danger" id="email-help"></div>
                            </div>
                        </div>
                        <h6 class="text-secondary mt-4 mb-1 border-top pt-3">Current / Most Recent Address in the US</h6>
                        <div class="row g-3 my-1">
                            <div class="col-md-6">
                                {{{form.address1.text.label}}}
                                {{{form.address1.text.input}}}
                            </div>
                            <div class="col-md-3">
                                {{{form.address2.text.label}}}
                                {{{form.address2.text.input}}}
                            </div>
                            <div class="col-md-3">
                                {{{form.addrZip.text.label}}}
                                {{{form.addrZip.text.input}}}
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-5">
                                {{{form.addrCity.text.label}}}
                                {{{form.addrCity.text.input}}}
                            </div>
                            <div class="col-md-3">
                                {{{form.addrState.select.label}}}
                                {{{form.addrState.select.input}}}
                            </div>
                            <div class="col-md-4">
                                {{{form.addrSince.text.label}}}
                                {{{form.addrSince.text.input}}}
                                <div class="form-text text-danger" id="addr-since-help"></div>
                            </div>
                        </div>
                        <h6 class="text-secondary mt-4 mb-1 border-top pt-3">Qualification</h6>
                        <div class="row g-3 my-1">
                            <div class="col-md-12">
                                <label class="form-label">I certify under penalty of law that:</label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="confirm-dl" required />
                                    <label class="form-check-label input-required" for="confirm-dl">
                                        I have a valid and genuine driver's license
                                    </label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="confirm-status" required />
                                    <label class="form-check-label input-required" for="confirm-status">
                                        I am legally authorized to work in the United States
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 my-1">
                            <div class="col-md-6">
                                {{!-- <label class="form-label input-required">Immigration Status</label> --}}
                                {{{form.status.radio.label}}}
                                <div class="form-check">
                                    {{{form.status.radio.citizen.input}}}
                                    {{{form.status.radio.citizen.label}}}
                                </div>
                                <div class="form-check">
                                    {{{form.status.radio.resident.input}}}
                                    {{{form.status.radio.resident.label}}}
                                </div>
                                <div class="form-check">
                                    {{{form.status.radio.authorized.input}}}
                                    {{{form.status.radio.authorized.label}}}
                                </div>
                            </div>
                            <div class="col-md-4" style="display: none;">
                                {{{form.statusExp.text.label}}}
                                {{{form.statusExp.text.input}}}
                                <div class="form-text text-danger" id="status-exp-help"></div>
                            </div>
                            <div class="col-md-5">
                                {{{form.position.select.label}}}
                                {{{form.position.select.input}}}
                            </div>
                        </div>
                        <p class="form-text text-danger mt-4" id="form-help" style="display: none;"></p>
                        <div class="d-grid gap-2 mt-4 mb-2">
                            <button type="submit" class="btn btn-primary">Start Application</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-footer text-black-50">
                {{{copyright}}}
            </div>
        </div>
    </div>
    <script type="module" src="/modules/application/start.mjs"></script>

{{> foot}}