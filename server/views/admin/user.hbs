{{> admin/nav.alpha}}

                <span class="subtitle is-5">User Configurations</span>
                <p class="mt-5">{{{display.name}}}</p>

                <style>
                    .column.user-ava {
                        width: 160px;
                    }
                    .user-column {
                        min-width: 320px;
                        max-width: 480px;
                    }
                </style>
                <div class="columns mt-1 ml-1">
                    <div class="column is-one-fifth user-ava">
                        <figure class="image is-128x128">
                            <img class="is-rounded" src="{{data.avaSrc}}" alt="User Avatar" />
                        </figure>
                    </div>
                    <div class="column is-one-fifth user-column">
                        <div class="is-flex is-justify-content-space-between">
                            <small>Condition:</small>
                            <strong class="has-text-right">{{{display.condition}}}</strong>
                        </div>
                        <div class="is-flex is-justify-content-space-between">
                            <small>Status:</small>
                            <strong class="has-text-right">{{display.status}}</strong>
                        </div>
                        <div class="is-flex is-justify-content-space-between">
                            <small>Location:</small>
                            <strong class="has-text-right">{{display.location}}</strong>
                        </div>
                        <div class="is-flex is-justify-content-space-between mt-3 pt-1 bt">
                            <small>Employee:</small>
                            <span class="has-text-danger-70 has-text-right">Unassigned</span>
                        </div>
                    </div>
                </div>
                {{#if (
                    and
                        (eq data.DS false)
                        (eq self false)
                )}}

                <style>
                    .box-column {
                        min-width: 540px;
                    }
                    .select.is-multiple select {
                        min-height: 280px;
                    }
                    .select.is-multiple select optgroup {
                        margin: 5px;
                    }
                    .select.is-multiple select option {
                        padding: 0 9px;
                    }
                </style>
                <div class="columns mt-4">
                    {{{input.id}}}
                    <div class="column is-two-fifths box-column">
                        <div class="box">
                            <div class="columns is-vcentered">
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-role-add-form" action="/resource/user/{{{data._id}}}/roles" method="POST">
                                        <input type="hidden" name="action" value="+" />
                                        <label class="label">Available Roles</label>
                                        <div class="select is-multiple is-fullwidth">
                                            <select id="available-roles" name="roles" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                                <div class="column is-one-fifth">
                                    <button type="submit" class="button is-fullwidth is-success" form="user-role-add-form">
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                    <button type="submit" class="button is-fullwidth is-danger mt-2" form="user-role-delete-form">
                                        <i class="fa fa-arrow-left"></i>
                                    </button>
                                </div>
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-role-delete-form" action="/resource/user/{{{data._id}}}/roles" method="POST">
                                        <input type="hidden" name="action" value="-" />
                                        <label class="label">User's Roles</label>
                                        <div class="select is-multiple is-fullwidth">
                                            <select id="user-roles" name="roles" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="column is-two-fifths box-column">
                        <div class="box">
                            <div class="columns is-vcentered">
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-team-add-form" action="/resource/user/{{{data._id}}}/teams" method="POST">
                                        <input type="hidden" name="action" value="+" />
                                        <label class="label">Available Teams</label>
                                        <div class="select is-multiple is-fullwidth">
                                            <select id="available-teams" name="teams" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                                <div class="column is-one-fifth">
                                    <button type="submit" class="button is-fullwidth is-success" form="user-team-add-form">
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                    <button type="submit" class="button is-fullwidth is-danger mt-2" form="user-team-delete-form">
                                        <i class="fa fa-arrow-left"></i>
                                    </button>
                                </div>
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-team-delete-form" action="/resource/user/{{{data._id}}}/teams" method="POST">
                                        <input type="hidden" name="action" value="-" />
                                        <label class="label">User's Teams</label>
                                        <div class="select is-multiple is-fullwidth">
                                            <select id="user-teams" name="teams" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/if}}
                {{#if (eq data.DS true)}}

                <p class="has-text-success-45 mt-4">All permissions and teams are automatically available to this user</p>
                {{/if}}
                {{#if (
                    and
                        (eq self true)
                        (eq data.DS false)
                )}}

                <p class="has-text-danger-70 mt-4">Roles and teams are to be assigned by a super admin or another admin</p>
                {{/if}}

{{> admin/nav.omega}}