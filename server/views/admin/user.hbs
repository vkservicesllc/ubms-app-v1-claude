{{> admin/nav.alpha}}

                {{#if (
                    and
                        (eq data.DS false)
                        (eq self false)
                )}}
                <div class="loader-wrapper is-active"><div class="loader is-loading"></div></div>
                {{/if}}
                <span class="subtitle is-5">User Configurations</span>
                <p class="mt-5">{{{display.name}}}</p>

                <style>
                    .column.user-ava {
                        width: 160px;
                    }
                    .user-column {
                        min-width: 320px;
                        max-width: 480px;
                    }
                    .box-column {
                        min-width: 540px;
                    }
                    .select.is-multiple.is-long select {
                        min-height: 590px;
                    }
                    .select.is-multiple.is-short select {
                        min-height: 156px;
                    }
                    .select.is-multiple select optgroup {
                        margin: 5px;
                    }
                    .select.is-multiple select option {
                        padding: 4px 9px 0;
                    }
                </style>
                <div class="columns">
                    <div class="column">
                        <div class="columns mt-2 ml-1">
                            <div class="column is-one-third user-ava">
                                <figure class="image is-128x128">
                                    <img class="is-rounded" src="{{data.avaSrc}}" alt="User Avatar" />
                                </figure>
                            </div>
                            <div class="column is-two-thirds user-column">
                                <div class="is-flex is-justify-content-space-between">
                                    <small class="has-text-secondary has-text-weight-bold">Condition:</small>
                                    <p>{{{display.condition}}}</p>
                                </div>
                                <div class="is-flex is-justify-content-space-between">
                                    <small class="has-text-secondary has-text-weight-bold">Status:</small>
                                    <p>{{display.status}}</p>
                                </div>
                                <div class="is-flex is-justify-content-space-between">
                                    <small class="has-text-secondary has-text-weight-bold">Location:</small>
                                    <p>{{display.location}}</p>
                                </div>
                                <div class="is-flex is-justify-content-space-between">
                                    <small class="has-text-secondary has-text-weight-bold">Gender:</small>
                                    <p>{{display.gender}}</p>
                                </div>
                                <div class="is-flex is-justify-content-space-between mt-3 pt-1 bt">
                                    <small class="has-text-secondary has-text-weight-bold">Employee:</small>
                                    {{!-- Temporary --}}
                                    <p class="has-text-danger-70 has-text-right">Unassigned</p>
                                </div>
                            </div>
                        </div>
                        {{{input.id}}}
                        {{#if (
                            and
                                (eq data.DS false)
                                (eq self false)
                        )}}
                        <div class="box">
                            <div class="columns is-vcentered">
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-roles-add-form" action="/resource/jx/user/{{{data._id}}}/add/roles" method="POST">
                                        <label class="label">Available Roles</label>
                                        <div class="select is-multiple is-short is-fullwidth">
                                            <select id="available-roles" name="_ids" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                                <div class="column is-one-fifth">
                                    <button type="submit" class="button is-fullwidth is-success" form="user-roles-add-form">
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                    <button type="submit" class="button is-fullwidth is-danger mt-2" form="user-roles-delete-form">
                                        <i class="fa fa-arrow-left"></i>
                                    </button>
                                </div>
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-roles-delete-form" action="/resource/jx/user/{{{data._id}}}/delete/roles" method="POST">
                                        <label class="label">User's Roles</label>
                                        <div class="select is-multiple is-short is-fullwidth">
                                            <select id="user-roles" name="_ids" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="box">
                            <div class="columns is-vcentered">
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-teams-add-form" action="/resource/jx/user/{{{data._id}}}/add/teams" method="POST">
                                        <label class="label">Available Teams <small class="has-text-weight-normal"><i>(Carrier only)</i></small></label>
                                        <div class="select is-multiple is-short is-fullwidth">
                                            <select class="scoped" id="available-teams" name="_ids" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                                <div class="column is-one-fifth">
                                    <div class="mb-2" style="text-align: center;">
                                        {{{input.unscoped}}}
                                        {{{label.unscoped}}}
                                        {{!-- <input type="checkbox" class="switch is-rounded is-small is-info" id="unscoped"{{ checked.unscoped }} />
                                        <label class="label pb-1" for="unscoped" style="font-size: .95em; font-weight: normal;">Unscoped</label> --}}
                                    </div>
                                    <button type="submit" class="button is-fullwidth is-success scoped" form="user-teams-add-form">
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                    <button type="submit" class="button is-fullwidth is-danger mt-2 scoped" form="user-teams-delete-form">
                                        <i class="fa fa-arrow-left"></i>
                                    </button>
                                </div>
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-teams-delete-form" action="/resource/jx/user/{{{data._id}}}/delete/teams" method="POST">
                                        <label class="label">User's Teams <small class="has-text-weight-normal"><i>(Carrier only)</i></small></label>
                                        <div class="select is-multiple is-short is-fullwidth">
                                            <select class="scoped" id="user-teams" name="_ids" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                    {{#if (
                        and
                            (eq data.DS false)
                            (eq self false)
                    )}}
                    <div class="column">
                        <div class="box">
                            <div class="columns is-vcentered">
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-companies-add-form" action="/resource/jx/user/{{{data._id}}}/add/companies" method="POST">
                                        <label class="label">Available Companies</label>
                                        <div class="select is-multiple is-long is-fullwidth">
                                            <select id="available-companies" name="_ids" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                                <div class="column is-one-fifth">
                                    <button type="submit" class="button is-fullwidth is-success" form="user-companies-add-form">
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                    <button type="submit" class="button is-fullwidth is-danger mt-2" form="user-companies-delete-form">
                                        <i class="fa fa-arrow-left"></i>
                                    </button>
                                </div>
                                <div class="column is-two-fifths is-width-fixed">
                                    <form id="user-companies-delete-form" action="/resource/jx/user/{{{data._id}}}/delete/companies" method="POST">
                                        <label class="label">User's Companies</label>
                                        <div class="select is-multiple is-long is-fullwidth">
                                            <select id="user-companies" name="_ids" multiple>
                                                <optgroup><option value=""></option></optgroup>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                </div>
                {{#if (eq data.DS true)}}

                <p class="has-text-success-45 mt-4">Access to all permissions, teams, and companies is granted to this user</p>
                {{/if}}
                {{#if (
                    and
                        (eq self true)
                        (eq data.DS false)
                )}}

                <p class="has-text-danger-70 mt-4">Roles, teams, and companies must be assigned to this user by a super admin or another admin from the same location</p>
                {{/if}}
                <script type="module">
                    import selector from '/modules/registry/selectors/user.mjs'
                    $(`[for="${selector.id.checkbox.unscoped.replace('#', '')}"]`).css({ fontSize: '.95em', fontWeight: 'normal' })
                </script>

{{> admin/nav.omega}}