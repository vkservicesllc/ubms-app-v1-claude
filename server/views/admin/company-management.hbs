{{> admin/nav.alpha}}

                <style>
                        .initial {
                            font-size: .5em;
                        }
                        .enforced {
                            font-size: .75em;
                        }
                        .current-status {
                            width: 3.2rem;
                        }
                        .effective-date {
                            width: 10rem;
                        }
                        .controls {
                            min-width: 5rem;
                        }
                        .secondary-column {
                            min-width: 32.14rem;
                        }
                        .column-address {
                            min-width: 37.14rem;
                        }
                        .column-contacts {
                            min-width: 28.57rem;
                        }
                        .modal-card-title strong {
                            display: block;
                            margin-bottom: .71rem;
                            padding-bottom: .5rem;
                            border-bottom: .07rem solid rgb(119, 119, 119);
                        }
                        .side-header {
                            width: 7.85rem;
                        }
                </style>
                <script>
                    $(document).ready(() => {
                        const urlParams = new URLSearchParams(window.location.search)
                        if (urlParams.has('tab')) {
                            const $tab = $('.tab-link')
                            const tabSection = urlParams.get('tab')

                            $tab.removeClass('is-active')
                            $('.tab-section').hide()
                            history.replaceState(null, '', window.location.href.split('?')[0])

                            $tab.each(function() {
                                const section = $(this).data('section')
                                if (section === tabSection) {
                                    $(this).addClass('is-active')
                                    $(`#${section}-section`).show()
                                }
                            })
                        }
                    })
                </script>

                <div class="loader-wrapper is-active"><div class="loader is-loading"></div></div>
                <span class="subtitle has-text-normal has-text-extreme is-4 mr-2">{{{companyName}}}</span>
                <sup><a href="{{url.back}}"><i class="fa fa-close has-text-danger-65"></i></a></sup>
                <div class="tabs mt-3">
                    <ul>
                        <li class="tab-link company-management-tabs is-active" data-section="profile"><a>Profile</a></li>
                        <li class="tab-link company-management-tabs" data-section="contacts-address"><a>Contacts / Location</a></li>
                        {{!-- <li class="tab-link company-management-tabs" data-section="contacts"><a>Contacts</a></li> --}}
                        {{#if (eq data.category 'crr')}}
                        {{!-- <li class="tab-link company-management-tabs" data-section="credentials"><a>Credentials</a></li> --}}
                        {{/if}}
                    </ul>
                </div>
                <input type="hidden" id="company-id" value="{{data._companyId}}" />
                <input type="hidden" id="company-since" value="{{data.since}}" />

                <section class="tab-section company-management-content" id="profile-section">
