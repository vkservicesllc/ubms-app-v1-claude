                                        <tr>
                                            <td class="has-text-info-50 side-header"><small>EIN:</small></td>
                                            <td class="has-text-weight-semibold static-data">
                                                <span class="form-data">{{{data.ein}}}</span>
                                                <div class="control has-icons-left form-element" style="display: none;">
                                                    {{{form.ein.text.input}}}
                                                    <span class="icon is-small is-left">
                                                        <i class="fas fa-fingerprint"></i>
                                                    </span>
                                                </div>
                                                <p class="help is-danger" id="ein-tip"></p>
                                            </td>
                                            <td class="static-action has-text-right">
                                                <a class="static-edit" href=""><i class="fa {{link.static.ein}}"></i></a>
                                                <a class="static-cancel" href="" style="display: none;"><i class="fa fa-close has-text-danger-60"></i></a>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="has-text-info-50 side-header"><small>DUNS:</small></td>
                                            <td class="has-text-weight-semibold static-data">
                                                <span class="form-data">{{{data.duns}}}</span>
                                                <div class="control form-element" style="display: none;">
                                                    {{{form.duns.text.input}}}
                                                </div>
                                                <p class="help is-danger" id="duns-tip"></p>
                                            </td>
                                            <td class="static-action has-text-right">
                                                <a class="static-edit" href=""><i class="fa {{link.static.duns}}"></i></a>
                                                <a class="static-cancel" href="" style="display: none;"><i class="fa fa-close has-text-danger-60"></i></a>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="has-text-info-50 side-header"><small>Website:</small></td>
                                            <td class="has-text-weight-semibold static-data">
                                                <span class="form-data">{{{data.website}}}</span>
                                                <div class="control has-icons-left form-element" style="display: none;">
                                                    {{{form.website.text.input}}}
                                                    <span class="icon is-small is-left">
                                                        <i class="fas fa-globe"></i>
                                                    </span>
                                                </div>
                                                <p class="help is-danger" id="website-tip"></p>
                                            </td>
                                            <td class="static-action has-text-right">
                                                <a class="static-edit" href=""><i class="fa {{link.static.website}}"></i></a>
                                                <a class="static-cancel" href="" style="display: none;"><i class="fa fa-close has-text-danger-60"></i></a>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="buttons px-2" id="static-buttons" style="display: none;">
                                    <button type="submit" class="button is-primary is-dark">Save Changes</button>
                                </div>
                            </form>
                        </div>
                        <div class="column is-one-quarter pt-6">
                            <form autocomplete="off">
                                <table class="table">
                                    <thead><tr><td colspan="3"><p class="subtitle is-6 has-text-primary-35 mb-0">Credentials</p></td></tr></thead>
                                </table>
                            </form>
                            <p class="has-text-danger mt-4"><i>Work in progress... Coming soon...</i></p>
                        </div>
                        <div class="column secondary-column pt-6">
                            <table class="table mb-6">
