                    </div>
                </section>

                <div class="modal" id="upsert-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card" style="width: 60rem;">
                        <header class="modal-card-head">
                            <p class="modal-card-title">
                                <strong>{{{companyName}}}</strong>
                                <span class="modal-card-target-title"></span>
                            </p>
                        </header>
                        <section class="modal-card-body warning-body" style="display: none;">
                            <article class="message is-warning">
                                <div class="message-header">Warning!</div>
                                <div class="message-body">
                                    This form is intended for correcting errors only.<br/>
                                    If the company data has changed, please click <i>Cancel</i><br/>
                                    and then the "+" link to register a new record.
                                </div>
                            </article>
                        </section>
                        <section class="modal-card-body form-body" style="display: none;">
                            <form id="upsert-form" autocomplete="off">
                                <input type="hidden" id="upsert-effective-match" />
                                <input type="hidden" id="upsert-target" />
                                <div class="columns">
                                    <div class="column is-3">
                                        {{{form.effective.text.label}}}
                                        <div class="control has-icons-left">
                                            {{{form.effective.text.input}}}
                                            <span class="icon is-small is-left">
                                                <i class="fas fa-calendar-days"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="column is-4 form phones-form" style="display: none;">
                                        {{{form.phone.text.label}}}
                                        <div class="control has-icons-left">
                                            {{{form.phone.text.input}}}
                                            <span class="icon is-small is-left">
                                                <i class="fas fa-phone"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="column is-4 form faxes-form" style="display: none;">
                                        {{{form.fax.text.label}}}
                                        <div class="control has-icons-left">
                                            {{{form.fax.text.input}}}
                                            <span class="icon is-small is-left">
                                                <i class="fas fa-fax"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="column is-6 form emails-form" style="display: none;">
                                        {{{form.email.text.label}}}
                                        <div class="control has-icons-left">
                                            {{{form.email.text.input}}}
                                            <span class="icon is-small is-left">
                                                <i class="fas fa-envelope"></i>
                                            </span>
                                        </div>
                                        <p class="help is-danger" id="email-tip"></p>
                                    </div>
                                    <div class="column is-6 form addresses-form" style="display: none;">
                                        {{{form.address1.text.label}}}
                                        <div class="control">
                                            {{{form.address1.text.input}}}
                                        </div>
                                        <p class="help is-info">Without Suite/Unit</p>
                                    </div>
                                    <div class="column is-3 form addresses-form" style="display: none;">
                                        {{{form.address2.text.label}}}
                                        <div class="control">
                                            {{{form.address2.text.input}}}
                                        </div>
                                    </div>
                                    <div class="column is-6 form mail-form" style="display: none;">
                                        {{{form.mailAddress1.text.label}}}
                                        <div class="control">
                                            {{{form.mailAddress1.text.input}}}
                                        </div>
                                        <p class="help is-info">Without Suite/Unit</p>
                                    </div>
                                    <div class="column is-3 form mail-form" style="display: none;">
                                        {{{form.mailAddress2.text.label}}}
                                        <div class="control">
                                            {{{form.mailAddress2.text.input}}}
                                        </div>
                                    </div>
                                </div>
                                <div class="form names-form" style="display: none;">
                                    <div class="columns">
                                        <div class="column is-6">
                                            {{{form.busName.text.label}}}
                                            <div class="control">
                                                {{{form.busName.text.input}}}
                                            </div>
                                            <p class="help is-info" id="busname-tip">Without Co Type</p>
                                        </div>
                                        <div class="column is-3">
                                            {{{form.coType.select.label}}}
                                            <div class="control">
                                                <div class="select is-fullwidth">
                                                    {{{form.coType.select.input}}}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="column is-3">
                                            {{{form.alias.text.label}}}
                                            <div class="control">
                                                {{{form.alias.text.input}}}
                                            </div>
                                            <p class="help is-info" id="alias-tip"></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="form addresses-form" style="display: none;">
                                    <div class="columns">
                                        <div class="column is-3">
                                            {{{form.addrZip.text.label}}}
                                            <div class="control">
                                                {{{form.addrZip.text.input}}}
                                            </div>
                                        </div>
                                        <div class="column is-6">
                                            {{{form.addrCity.text.label}}}
                                            <div class="control">
                                                {{{form.addrCity.text.input}}}
                                            </div>
                                        </div>
                                        <div class="column is-3">
                                            {{{form.addrState.select.label}}}
                                            <div class="select is-fullwidth">
                                                {{{form.addrState.select.input}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="columns">
                                        <div class="column">
                                            <label class="checkbox">
                                                <input type="checkbox" id="enforce-mail" name="mail" />
                                                Receive mail at this address (ignore mailing address)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form mail-form" style="display: none;">
                                    <div class="columns">
                                        <div class="column is-3">
                                            {{{form.mailAddrZip.text.label}}}
                                            <div class="control">
                                                {{{form.mailAddrZip.text.input}}}
                                            </div>
                                        </div>
                                        <div class="column is-6">
                                            {{{form.mailAddrCity.text.label}}}
                                            <div class="control">
                                                {{{form.mailAddrCity.text.input}}}
                                            </div>
                                        </div>
                                        <div class="column is-3">
                                            {{{form.mailAddrState.select.label}}}
                                            <div class="select is-fullwidth">
                                                {{{form.mailAddrState.select.input}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <div class="buttons">
                                <button type="submit" form="upsert-form" class="button" style="display: none;"></button>
                                <button class="button is-danger is-outlined" id="proceed-button" style="display: none;">Proceed to Error Correction</button>
                                <button class="button upsert-modal-cancel">Cancel</button>
                                <p class="help is-danger" id="upsert-error" style="display: none;"></p>
                            </div>
                        </footer>
                    </div>
                </div>

                <div class="modal" id="delete-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title has-text-danger-60">
                                <strong>{{{companyName}}}</strong>
                                <span class="modal-card-target-title"></span>
                            </p>
                        </header>
                        <section class="modal-card-body form-body">
                            <p class="has-text-danger-60">You are about to delete the following record:</p>
                            <div class="has-text-weight-semibold mt-1 mb-3" id="delete-record" style="font-size: 1.05em;"></div>
                            <p class="has-text-danger-60">This action is irreversible. To proceed, click the <i>Delete</i> button.</p>
                            <form id="delete-form">
                                <input type="hidden" id="delete-effective-match" />
                                <input type="hidden" id="delete-target" />
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <div class="buttons">
                                <button type="submit" form="delete-form" class="button is-danger">Delete</button>
                                <button class="button delete-modal-cancel">Cancel</button>
                            </div>
                        </footer>
                    </div>
                </div>

                <script type="module" src="/modules/company/management.mjs"></script>

{{> admin/nav.omega}}