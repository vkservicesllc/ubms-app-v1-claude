{{> admin/nav.alpha}}

                <style>
                    .content-box {
                        min-height: 51.4rem !important;
                    }
                    .form-container {
                        max-width: 77.14rem !important;
                        margin: 0 auto 2.14rem;
                    }
                </style>

                {{!-- Steps, Title, Record --}}
                {{#if (
                    or
                        (eq data._id 'new')
                        (eq data.confirmed false)
                )}}
                {{> admin/company/steps}}
                <h1 class="subtitle has-text-centered">{{{contentTitle}}}</h1>

                {{> admin/company/record}}
                {{/if}}
                {{#if (eq data.confirmed false)}}
                {{#if (
                    or
                        (hv data._id)
                        (hv data._companyId)
                )}}

                {{> admin/company/ownership}}
                {{/if}}
                {{/if}}
                {{#if (
                    and
                        (eq data.confirmed false)
                        (hv data.owner._id)
                )}}

                {{> admin/company/address}}
                {{/if}}
                {{#if (
                    and
                        (eq data.confirmed false)
                        (hv data.address.physical.zip)
                )}}

                {{> admin/company/contacts}}
                {{/if}}
                {{#if (
                    and
                        (eq data.confirmed false)
                        (hv data.phone)
                )}}
                {{#if (eq data.category 'crr')}}

                {{> admin/company/carrier}}
                {{/if}}
                {{/if}}
                {{#if (
                    or
                        (eq data.confirmed true)
                        ( and (eq data.confirmed false) (eq data.category 'crr') (hv data.mc) (hv data.usdot) )
                        ( and (eq data.confirmed false) (eq data.category 'hld') (hv data.phone) )
                )}}
                {{> admin/company/card}}
                {{/if}}
                {{#if (ne data._id 'new')}}

                <div class="modal" id="company-delete-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title">
                                <small class="has-text-danger-50 is-size-6">Delete</small>
                                <span class="has-text-weight-semibold">{{data.name}}</span>
                            </p>
                            <button class="delete" id="close-company-delete-modal"></button>
                        </header>
                        <section class="modal-card-body">
                            <p class="has-text-warning-40">
                                <i class="fa-solid fa-circle-info"></i>
                                This action will not succeed if the company is engaged in any activity.
                            </p>
                            <p class="mt-3 mb-2">
                                Enter the company's Alias Code:
                            </p>
                            <form id="company-delete-form" action="/resource/delete/company/{{{_id}}}" method="POST" autocomplete="off">
                                {{{form.confirmAlias.text.input}}}
                                <script type="module">
                                    import selector from '/modules/registry/selectors/company.mjs'
                                    import { aliasEvent } from '/modules/events/company.mjs'

                                    const $modal = $('#company-delete-modal')
                                    const aliasId = selector.id.text.confirmAlias

                                    aliasEvent(aliasId)
                                    $('#delete-company-trigger').click(() => {
                                        $modal.addClass('is-active')
                                    })
                                    $('#close-company-delete-modal').click(() => {
                                        $modal.removeClass('is-active')
                                        $(aliasId).val(null)
                                    })
                                </script>
                            </form>
                            <p class="has-text-danger-50 mt-3">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Successful deletion is <u>irreversible</u>!
                            </p>
                        </section>
                        <footer class="modal-card-foot">
                            <button type="submit" class="button is-danger" form="company-delete-form">Delete</button>
                        </footer>
                    </div>
                </div>
                {{/if}}
                {{#if (eq data.confirmed true)}}
                
                <div class="modal" id="company-close-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title">
                                <small class="is-size-6">Close</small>
                                <span class="has-text-weight-semibold">{{data.name}}</span>
                            </p>
                            <button class="delete" id="close-company-close-modal"></button>
                        </header>
                        <section class="modal-card-body">
                            <p class="has-text-danger-50 mt-3">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                This action will permanently close the company and cannot be undone.<br/>
                                To temporarily place the company on hold, use the <b>Deactivate</b> feature instead.
                            </p>
                            <form id="company-close-form" action="/resource/close/company/{{{_id}}}" method="POST">
                                <div class="columns mt-4">
                                    <div class="column is-4">
                                        {{{form.until.text.label}}}
                                        <div class="control has-icons-left">
                                            {{{form.until.text.input}}}
                                            <span class="icon is-small is-left">
                                                <i class="fas fa-calendar-days"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <button type="submit" class="button" form="company-close-form">Close Permanently</button>
                        </footer>
                    </div>
                </div>
                <div class="modal" id="company-condition-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title">
                                <small class="is-size-6">{{display.statusTrigger}}</small>
                                <span class="has-text-weight-semibold">{{data.name}}</span>
                            </p>
                            <button class="delete" id="close-company-condition-modal"></button>
                        </header>
                        <section class="modal-card-body">
                            <p class="has-text-warning-40">
                                <i class="fa-solid fa-circle-info"></i>
                                This action will {{display.statusMessage}}.
                            </p>
                            <form id="company-condition-form" action="/resource/toggle/company/{{{_id}}}/condition" method="POST"></form>
                        </section>
                        <footer class="modal-card-foot">
                            <button type="submit" class="button" form="company-condition-form">{{display.statusTrigger}}</button>
                        </footer>
                    </div>
                </div>
                <script type="module">
                    import { inputEvent } from '/modules/events/form.mjs'
                    import selector from '/modules/registry/selectors/company.mjs'
                    const untilId = selector.id.text.until
                    const $until = $(untilId)
                    const today = moment().format('MM/DD/YYYY')
                    const $modal = {
                        close: $('#company-close-modal'),
                        condition: $('#company-condition-modal'),
                    }
                    inputEvent(untilId, { datepicker: { maxDate: 0 }, value: today })
                    $('#close-company-trigger').click(() => $modal.close.addClass('is-active'))
                    $('#close-company-close-modal').click(() => {
                        $modal.close.removeClass('is-active')
                        $until.val(today)
                    })
                    $('#company-condition-trigger').click(() => $modal.condition.addClass('is-active'))
                    $('#close-company-condition-modal').click(() => $modal.condition.removeClass('is-active'))
                </script>
                {{/if}}

{{> admin/nav.omega}}