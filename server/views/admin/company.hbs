{{> admin/nav.alpha}}

                <style>
                    .content-box {
                        min-height: 720px !important;
                    }
                    .form-container {
                        max-width: 1080px !important;
                        margin: 0 auto 30px;
                    }
                </style>

                {{!-- Steps, Title, Record --}}
                {{#if (
                    or
                        (eq data._id 'new')
                        (eq data.confirmed 0)
                )}}
                {{> admin/company/steps}}
                <h1 class="subtitle has-text-centered">{{{contentTitle}}}</h1>

                {{> admin/company/record}}
                {{/if}}
                {{#if (eq data.confirmed 0)}}
                {{#if (
                    or
                        (hv data._id)
                        (hv data._companyId)
                )}}

                {{> admin/company/ownership}}
                {{/if}}
                {{/if}}
                {{#if (
                    and
                        (eq data.confirmed 0)
                        (hv data.owner._id)
                )}}

                {{> admin/company/address}}
                {{/if}}
                {{#if (
                    and
                        (eq data.confirmed 0)
                        (hv data.address.physical.zip)
                )}}

                {{> admin/company/contacts}}
                {{/if}}
                {{#if (
                    and
                        (eq data.confirmed 0)
                        (hv data.phone)
                )}}
                {{#if (eq data.catId 'crr')}}

                {{> admin/company/carrier}}
                {{/if}}
                {{/if}}
                {{#if (
                    or
                        (eq data.confirmed 1)
                        ( and (eq data.confirmed 0) (eq data.catId 'crr') (hv data.mc) (hv data.usdot) )
                )}}
                {{> admin/company/card}}
                {{/if}}
                {{#if (ne data._id 'new')}}

                <div class="modal" id="company-delete-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title">
                                <small class="has-text-danger-50 is-size-6">Delete</small>
                                <span class="has-text-weight-semibold">{{data.name}}</span>
                            </p>
                            <button class="delete" id="close-company-delete-modal"></button>
                        </header>
                        <section class="modal-card-body">
                            <p class="has-text-warning-40">
                                <i class="fa-solid fa-circle-info"></i>
                                This action will not succeed if the company is engaged in any activity.
                            </p>
                            <p class="mt-3 mb-2">
                                Enter the company's Alias Code:
                            </p>
                            <form id="company-delete-form" action="/resource/company/{{{_id}}}/delete" method="POST" autocomplete="off">
                                {{{input.confirmAlias}}}
                                <script type="module">
                                    import { formSelectors } from '/modules/registry/selectors.mjs'
                                    import { aliasEvent } from '/modules/events/company.mjs'

                                    const $module = $('#company-delete-modal')
                                    let { aliasId } = formSelectors.company
                                    aliasId = `confirm-${aliasId}`

                                    aliasEvent(aliasId)
                                    $('#delete-company-trigger').click(() => {
                                        $module.addClass('is-active')
                                    })
                                    $('#close-company-delete-modal').click(() => {
                                        $module.removeClass('is-active')
                                        $(`#${aliasId}`).val(null)
                                    })
                                </script>
                            </form>
                            <p class="has-text-danger-50 mt-3">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Successful deletion is <u>irreversible</u>!
                            </p>
                        </section>
                        <footer class="modal-card-foot">
                            <button type="submit" class="button is-danger" form="company-delete-form">Delete</button>
                        </footer>
                    </div>
                </div>
                {{/if}}

{{> admin/nav.omega}}