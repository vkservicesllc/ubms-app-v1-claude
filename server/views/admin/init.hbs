{{> head}}


    <section class="hero is-fullheight" style="display: none !important;">
        <div class="hero-body">
            <div class="container login-container">
                <div class="box login-box">
                    <div class="is-pulled-right mb-5">
                        {{> admin/theme}}
                    </div>
                    <h1 class="title is-4 has-text-centered">{{appName}}<br/>Core User</h1>
                    <form id="init-form" action="/init" method="POST" autocomplete="off">
                        <div class="field">
                            {{{label.firstName}}}
                            <div class="control">
                                {{{input.firstName}}}
                            </div>
                        </div>
                        <div class="field">
                            {{{label.lastName}}}
                            <div class="control">
                                {{{input.lastName}}}
                            </div>
                        </div>
                        <div class="field">
                            {{{label.email}}}
                            <div class="control has-icons-left">
                                {{{input.email}}}
                                <span class="icon is-small is-left">
                                    <i class="fas fa-envelope"></i>
                                </span>
                            </div>
                        </div>
                        <div class="field">
                            {{{label.username}}}
                            <div class="control has-icons-left">
                                {{{input.username}}}
                                <span class="icon is-small is-left">
                                    <i class="fas fa-user"></i>
                                </span>
                            </div>
                        </div>
                        <div class="field">
                            {{{label.password}}}
                            <div class="control has-icons-left">
                                {{{input.password}}}
                                <span class="icon is-small is-left">
                                    <i class="fas fa-lock"></i>
                                </span>
                            </div>
                        </div>
                        <div class="field my-5">
                            <div class="control">
                                <button type="submit" class="button is-fullwidth is-primary" disabled>Initialize</button>
                            </div>
                        </div>
                        <div class="field has-text-centered has-text-grey is-size-7">
                            <p>{{{copyright}}}</p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>


{{> foot}}