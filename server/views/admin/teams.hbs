{{> admin/nav.alpha}}
                
                <div class="mb-6">
                    <button class="button" id="team-add-button"><i class="fa fa-plus"></i></button>
                </div>
                <div class="modal" id="team-upsert-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title" id="team-upsert-title"></p>
                            <button class="delete"></button>
                        </header>
                        <section class="modal-card-body">
                            <form id="team-upsert-form" action="/resource/team" method="POST" autocomplete="off">
                                {{{input.id}}}
                                {{{input.current.name}}}
                                <div class="columns">
                                    <div class="column">
                                        <div class="field">
                                            {{{label.name}}}
                                            <div class="control">
                                                {{{input.name}}}
                                            </div>
                                            <p class="help" id="team-name-tip"></p>
                                        </div>
                                        <div class="field">
                                            {{{label.category}}}
                                            <div class="control has-icons-left">
                                                <div class="select is-fullwidth">
                                                    {{{select.category}}}
                                                </div>
                                                <span class="icon is-small is-left" id="team-category-select-icon">
                                                    <i class="fas fa-file-circle-question"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column">
                                        <div class="field">
                                            {{{label.description}}}
                                            <div class="control">
                                                {{{input.description}}}
                                            </div>
                                            <p class="help">
                                                Characters: <span id="desc-char-used">0</span> used /
                                                <span id="desc-char-left">{{descMaxChars}}</span> left
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <div class="buttons">
                                <button type="submit" form="team-upsert-form" class="button" id="team-upsert-button"></button>
                                <button class="button is-danger" id="team-delete-button" style="display: none;">Delete</button>
                            </div>
                        </footer>
                    </div>
                </div>
                <style>
                    .column.is-one-fifth {
                        min-width: 280px;
                    }
                </style>

                <div id="team-list"></div>

                <div class="modal" id="team-relationship-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title" id="team-relationship-title"></p>
                        </header>
                        <section class="modal-card-body" id="team-relationship"></section>
                        <footer class="modal-card-foot">
                            <button class="button" id="team-relationship-close-button">Done</button>
                        </footer>
                    </div>
                </div>

                <div class="modal" id="team-profile-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card" style="min-width: 720px;">
                        <header class="modal-card-head">
                            <p class="modal-card-title" id="team-profile-title"></p>
                            <button class="delete"></button>
                        </header>
                        <section class="modal-card-body" id="team-profile">
                            <form id="team-profile-form" action="" method="POST" autocomplete="off">
                                {{{input.profileId}}}
                                {{{input.current.company}}}
                                <div class="columns">
                                    <div class="column is-two-fifths">
                                        <div class="field">
                                            {{{label.busName}}}
                                            <div class="control">
                                                {{{input.busName}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-fifths">
                                        <div class="field">
                                            {{{label.coType}}}
                                            <div class="control">
                                                <div class="select is-fullwidth">
                                                    {{{select.coType}}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-two-fifths">
                                        <div class="field">
                                            {{{label.phone}}}
                                            <div class="control">
                                                {{{input.phone}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{label.email}}}
                                            <div class="control">
                                                {{{input.email}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{label.website}}}
                                            <div class="control">
                                                {{{input.website}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{label.address1}}}
                                            <div class="control">
                                                {{{input.address1}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-quarter">
                                        <div class="field">
                                            {{{label.address2}}}
                                            <div class="control">
                                                {{{input.address2}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-quarter">
                                        <div class="field">
                                            {{{label.zip}}}
                                            <div class="control">
                                                {{{input.zip}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{label.city}}}
                                            <div class="control">
                                                {{{input.city}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-quarter">
                                        <div class="field">
                                            {{{label.state}}}
                                            <div class="control">
                                                <div class="select is-fullwidth">
                                                    {{{select.state}}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <button type="submit" form="team-profile-form" class="button is-success">Save</button>
                        </footer>
                    </div>
                </div>

{{> admin/nav.omega}}