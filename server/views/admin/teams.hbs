{{> admin/nav.alpha}}
                
                <div class="mb-6">
                    <button class="button" id="team-add-button"><i class="fa fa-plus"></i></button>
                </div>
                <div class="modal" id="team-upsert-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title" id="team-upsert-title"></p>
                            <button class="delete"></button>
                        </header>
                        <section class="modal-card-body">
                            <form id="team-upsert-form" action="/resource/upsert/team" method="POST" autocomplete="off">
                                {{{form.id.hidden.input}}}
                                {{{form.hiddenTeamName.hidden.input}}}
                                <div class="columns">
                                    <div class="column">
                                        <div class="field">
                                            {{{form.teamName.text.label}}}
                                            <div class="control">
                                                {{{form.teamName.text.input}}}
                                            </div>
                                            <p class="help" id="team-name-tip"></p>
                                        </div>
                                        {{!-- <div class="field" style="display: none;">
                                            {{{form.category.select.label}}}
                                            <div class="control has-icons-left">
                                                <div class="select is-fullwidth">
                                                    {{{form.category.select.input}}}
                                                </div>
                                                <span class="icon is-small is-left" id="team-category-select-icon">
                                                    <i class="fas fa-file-circle-question"></i>
                                                </span>
                                            </div>
                                        </div> --}}
                                        {{!-- <div class="field">
                                            {{{form.crrDept.radio.label}}}
                                            <div class="control">
                                                <label class="radio">
                                                    {{{form.crrDept.radio.zero.input}}}
                                                    {{{form.crrDept.radio.zero.label}}}
                                                </label>
                                            </div>
                                            <div class="control">
                                                <label class="radio">
                                                    {{{form.crrDept.radio.one.input}}}
                                                    {{{form.crrDept.radio.one.label}}}
                                                </label>
                                            </div>
                                        </div> --}}
                                    </div>
                                    <div class="column">
                                        <div class="field">
                                            {{{form.desc.text.label}}}
                                            <div class="control">
                                                {{{form.desc.text.input}}}
                                            </div>
                                            <p class="help">
                                                Characters: <span id="desc-char-used">0</span> used /
                                                <span id="desc-char-left">{{descMaxChars}}</span> left
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <div class="buttons">
                                <button type="submit" form="team-upsert-form" class="button" id="team-upsert-button"></button>
                                <button class="button is-danger" id="team-delete-button" style="display: none;">Delete</button>
                            </div>
                        </footer>
                    </div>
                </div>
                <style>
                    .column.is-one-fifth {
                        min-width: 280px;
                    }
                </style>

                <div id="team-list"></div>

                <div class="modal" id="team-relationship-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title" id="team-relationship-title"></p>
                        </header>
                        <section class="modal-card-body" id="team-relationship"></section>
                        <footer class="modal-card-foot">
                            <button class="button" id="team-relationship-close-button">Done</button>
                        </footer>
                    </div>
                </div>

                <div class="modal" id="team-profile-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card" style="min-width: 720px;">
                        <header class="modal-card-head">
                            <p class="modal-card-title" id="team-profile-title"></p>
                            <button class="delete"></button>
                        </header>
                        <section class="modal-card-body" id="team-profile">
                            <form id="team-profile-form" action="/resource/update/team/profile" method="POST" autocomplete="off">
                                {{{form.profileId.hidden.input}}}
                                <div class="columns">
                                    <div class="column is-two-fifths">
                                        <div class="field">
                                            {{{form.busName.text.label}}}
                                            <div class="control">
                                                {{{form.busName.text.input}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-fifths">
                                        <div class="field">
                                            {{{form.coType.select.label}}}
                                            <div class="control">
                                                <div class="select is-fullwidth">
                                                    {{{form.coType.select.input}}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-two-fifths">
                                        <div class="field">
                                            {{{form.phone.text.label}}}
                                            <div class="control">
                                                {{{form.phone.text.input}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{form.email.text.label}}}
                                            <div class="control">
                                                {{{form.email.text.input}}}
                                            </div>
                                            <p class="help has-text-danger" id="team-email-tip"></p>
                                        </div>
                                    </div>
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{form.website.text.label}}}
                                            <div class="control">
                                                {{{form.website.text.input}}}
                                            </div>
                                            <p class="help has-text-danger" id="team-website-tip"></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{form.address1.text.label}}}
                                            <div class="control">
                                                {{{form.address1.text.input}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-quarter">
                                        <div class="field">
                                            {{{form.address2.text.label}}}
                                            <div class="control">
                                                {{{form.address2.text.input}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-quarter">
                                        <div class="field">
                                            {{{form.addrZip.text.label}}}
                                            <div class="control">
                                                {{{form.addrZip.text.input}}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="columns">
                                    <div class="column is-half">
                                        <div class="field">
                                            {{{form.addrCity.text.label}}}
                                            <div class="control">
                                                {{{form.addrCity.text.input}}}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="column is-one-quarter">
                                        <div class="field">
                                            {{{form.addrState.select.label}}}
                                            <div class="control">
                                                <div class="select is-fullwidth">
                                                    {{{form.addrState.select.input}}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <button type="submit" form="team-profile-form" class="button is-success">Save</button>
                        </footer>
                    </div>
                </div>

                <div class="modal" id="team-settings-modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head">
                            <p class="modal-card-title" id="team-settings-title"></p>
                            <button class="delete"></button>
                        </header>
                        <section class="modal-card-body">
                            <form id="team-settings-form" action="/resource/update/team/settings" method="POST" autocomplete="off">
                                {{{form.settingsId.hidden.input}}}
                                <div id="team-settings"></div>
                            </form>
                        </section>
                        <footer class="modal-card-foot">
                            <button type="submit" form="team-settings-form" class="button is-success">Save</button>
                        </footer>
                    </div>
                </div>

{{> admin/nav.omega}}