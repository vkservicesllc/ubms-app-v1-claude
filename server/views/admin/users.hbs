{{> admin/nav.alpha}}
                {{#if (eq user.DS true)}}

                <div class="tabs" id="users-tabs">
                    <ul>
                        <li class="tab-link is-active" data-section="users"><a>Users</a></li>
                        <li class="tab-link" data-section="default-roles" data-role="def"><a>Roles</a></li>
                        <li class="tab-link" data-section="carrier-roles" data-role="crr"><a>Carrier Roles</a></li>
                    </ul>
                </div>
                <style>
                    .panel {
                        min-width: 240px;
                        margin-left: 8px;
                    }
                    .table thead .top-header  {
                        font-weight: normal;
                        font-style: oblique;
                        font-size: .9em;
                    }
                    .table thead .checkbox-header {
                        width: 90px;
                    }
                    .role-tables {
                        max-height: 510px;
                        overflow-y: scroll;
                    }
                    .role-delete-button {
                        display: block;
                        max-width: 45px;
                    }
                    .name-unavailable-warning {
                        display: none;
                    }
                    .switch[type=checkbox].is-small + label {
                        font-size: .5rem;
                    }
                    .role-form-section {
                        display: none;
                        position: fixed;
                        margin-left: 8px;
                        width: 960px;
                    }
                    .role-panel-list {
                        max-height: 650px;
                        overflow-y: scroll;
                    }
                </style>
                <script>
                    $(document).ready(() => {
                        const urlParams = new URLSearchParams(window.location.search)
                        if (urlParams.has('role')) {
                            const $tab = $('.tab-link')
                            const catId = urlParams.get('role')

                            $tab.removeClass('is-active')
                            $('.tab-section').hide()
                            history.replaceState(null, '', window.location.href.split('?')[0])

                            $tab.each(function() {
                                const role = $(this).data('role')
                                if (role == catId) {
                                    const section = $(this).data('section')

                                    $(this).addClass('is-active')
                                    $(`#${section}-section`).show()
                                }
                            })
                        }
                    })
                </script>
                {{/if}}

                <section class="tab-section" id="users-section">
                    <table class="table" id="users-table"></table>

                    <div class="modal" id="user-modal">
                        <div class="modal-background"></div>
                        <div class="modal-card">
                            <header class="modal-card-head">
                                <p class="modal-card-title" id="user-modal-title"></p>
                                {{#if (eq user.DS true)}}
                                <button class="button" id="user-update-log-trigger" style="display: none;">Log</button>
                                {{/if}}
                            </header>
                            <section class="modal-card-body">
                                <form class="content" id="user-form" action="/resource/user" method="POST" autocomplete="off">
                                    {{{form.id.hidden.input}}}
                                    {{{form.hiddenUsername.hidden.input}}}
                                    <h5 class="has-text-info">Properties</h5>
                                    <div class="columns">
                                        <div class="column is-one-third">
                                            <div class="field">
                                                {{{form.status.select.label}}}
                                                <div class="control has-icons-left mt-1">
                                                    <div class="select is-fullwidth">
                                                        {{{form.status.select.input}}}
                                                    </div>
                                                    <span class="icon is-left">
                                                        <i class="fas fa-user"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="column is-one-third">
                                            <div class="field">
                                                {{{form.location.select.label}}}
                                                <div class="control has-icons-left mt-1">
                                                    <div class="select is-fullwidth">
                                                        {{{form.location.select.input}}}
                                                    </div>
                                                    <span class="icon is-left">
                                                        <i class="fas fa-location-crosshairs"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <h5 class="has-text-info">Authentication</h5>
                                    <div class="columns">
                                        <div class="column is-two-thirds">
                                            <div class="field">
                                                {{{form.email.text.label}}}
                                                <div class="control has-icons-left mt-1">
                                                    {{{form.email.text.input}}}
                                                    <span class="icon is-left">
                                                        <i class="fas fa-envelope"></i>
                                                    </span>
                                                </div>
                                                <p class="help" id="user-email-help" style="display: none;"></p>
                                            </div>
                                        </div>
                                        <div class="column">
                                            <div class="field">
                                                {{{form.phone.text.label}}}
                                                <div class="control has-icons-left mt-1">
                                                    {{{form.phone.text.input}}}
                                                    <span class="icon is-left">
                                                        <i class="fas fa-mobile"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <h5 class="has-text-info">Identification</h5>
                                    <div class="columns">
                                        <div class="column">
                                            <div class="field">
                                                {{{form.firstName.text.label}}}
                                                <div class="control mt-1">
                                                    {{{form.firstName.text.input}}}
                                                </div>
                                                <p class="help" id="user-fname-help" style="display: none;"></p>
                                            </div>
                                        </div>
                                        <div class="column">
                                            <div class="field">
                                                {{{form.lastName.text.label}}}
                                                <div class="control mt-1">
                                                    {{{form.lastName.text.input}}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="columns">
                                        <div class="column">
                                            <div class="field">
                                                {{{form.alias.text.label}}}
                                                <div class="control mt-1">
                                                    {{{form.alias.text.input}}}
                                                </div>
                                                <p class="help" id="user-alias-help" style="display: none;"></p>
                                            </div>
                                        </div>
                                        <div class="column">
                                            <div class="field">
                                                {{{form.gender.radio.label}}}
                                                <div class="control mt-2">
                                                    <label class="radio">
                                                        {{{form.gender.radio.male.input}}}
                                                        Male
                                                    </label>
                                                    <label class="radio">
                                                        {{{form.gender.radio.female.input}}}
                                                        Female
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </section>
                            <footer class="modal-card-foot">
                                <div class="buttons">
                                    <button type="submit" form="user-form" class="button" id="user-modal-submit"></button>
                                    <button class="button modal-cancel">Cancel</button>
                                    <p class="has-text-danger is-size-7">* Required fields</p>
                                </div>
                            </footer>
                        </div>
                    </div>

                    <div class="modal" id="user-condition-modal">
                        <div class="modal-background"></div>
                        <div class="modal-card">
                            <header class="modal-card-head">
                                <p class="modal-card-title" id="user-condition-modal-title"></p>
                                <button class="delete"></button>
                            </header>
                            <section class="modal-card-body">
                                <form id="user-condition-form" action="/resource/user/modify/condition" method="POST" autocomplete="off">
                                    {{{form.modifyId.hidden.input}}}
                                    <div class="radios">
                                        <label class="radio">
                                            {{{form.condition.radio.active.input}}}
                                            &nbsp;Active
                                        </label>
                                        <label class="radio ml-5">
                                            {{{form.condition.radio.inactive.input}}}
                                            &nbsp;Suspended
                                        </label>
                                        <label class="radio ml-5">
                                            {{{form.condition.radio.locked.input}}}
                                            &nbsp;Locked by the System
                                        </label>
                                    </div>
                                </form>
                            </section>
                            <footer class="modal-card-foot">
                                <button type="submit" form="user-condition-form" class="button is-success">Update</button>
                            </footer>
                        </div>
                    </div>

                    <div class="modal" id="user-delete-modal">
                        <div class="modal-background"></div>
                        <div class="modal-card">
                            <header class="modal-card-head">
                                <p class="modal-card-title" id="user-delete-modal-title"></p>
                                <button class="delete"></button>
                            </header>
                            <section class="modal-card-body">
                                <form id="user-delete-form" action="/resource/user/delete" method="POST" autocomplete="off">
                                    {{{form.deleteId.hidden.input}}}
                                    <p class="has-text-danger">
                                        <b>Warning:</b><br/>
                                        Deleting this user will remove their account permanently.
                                        However, all of their previous activity will remain in the system.
                                        Are you sure you want to proceed with this action?
                                    </p><br/>
                                    <label class="checkbox">
                                        <input type="checkbox" id="confirm-delete-user" />&nbsp;
                                        I confirm that I have a valid reason for this deletion
                                    </label>
                                </form>
                            </section>
                            <footer class="modal-card-foot">
                                <button type="submit" form="user-delete-form" class="button is-danger" id="user-delete-modal-submit" disabled>Delete</button>
                            </footer>
                        </div>
                    </div>

                    {{#if (eq user.DS true)}}
                    <div class="modal" id="user-update-log-modal">
                        <div class="modal-background"></div>
                        <div class="modal-content">
                            <div class="panel">
                                <p class="panel-heading has-background-dark">
                                    <small style="font-weight: normal;">Update Log for</small>&nbsp;
                                    <span id="user-update-log-modal-subtitle"></span>
                                </p>
                                <div class="has-background-black-ter">
                                    <div id="user-update-log-modal-list" style="width: 100%;"></div>
                                </div>
                            </div>
                        </div>
                        <button class="modal-close is-large"></button>
                    </div>

                    {{/if}}
                </section>
                {{#if (eq user.DS true)}}

                {{> admin/roles/default}}

                {{> admin/roles/carrier}}
                {{/if}}

{{> admin/nav.omega}}